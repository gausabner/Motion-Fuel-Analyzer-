generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("EMPLOYEE")
  // bcrypt hash; null only for legacy rows until a password is set.
  password  String?
  // ACTIVE = can sign in · PENDING = awaiting admin approval · DISABLED = blocked
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TankDefinition {
  tankNo   String @id
  fuelType String
}

model CostCentre {
  voteNo     String @id
  division   String
  department String
  // Set when this entry was auto-created by prefix resolution (holds the
  // registered vote it was derived from). NULL for seeded/manual entries.
  // Makes auto-resolution auditable and reversible.
  derivedFrom String?
}

model Department {
  name      String   @id
  createdAt DateTime @default(now())
}

model FleetUnit {
  unitNo      String   @id
  description String?
  createdAt   DateTime @default(now())
}

model FuelTransaction {
  id           String   @id @default(cuid())
  storeNo      String
  pumpNo       String?
  transDate    DateTime
  transRefNo   String?
  issueTime    String?
  transVoteNo  String?
  transQty     Float
  transAmt     Float?
  vehicleId    String?
  fleetUnit    String?
  fleetEI      String?
  fleetReading String?
  jobNo        String?
  activity     String?
  itemCat      String?
  transType    String?
  fuelType     String
  isIssue      Boolean
  createdAt    DateTime @default(now())

  @@unique([transDate, transRefNo, vehicleId, issueTime])
  @@index([transDate])
  @@index([vehicleId])
  @@index([fuelType])
  @@index([transVoteNo])
}

model DailyFuelStats {
  id               String   @id @default(cuid())
  date             DateTime
  fuelType         String
  totalVolume      Float
  totalCost        Float
  transactionCount Int
  averageVolume    Float

  @@unique([date, fuelType])
}

model SystemSettings {
  id             String   @id @default("global")
  currencyCode   String   @default("NAD")
  currencySymbol String   @default("N$")
  petrolPrice    Float    @default(0)
  dieselPrice    Float    @default(0)
  updatedAt      DateTime @updatedAt
}

model UploadedFile {
  id         String   @id @default(cuid())
  fileName   String
  filePath   String
  fileSize   Int
  rowCount   Int
  uploadedAt DateTime @default(now())
}

/// Fuel purchase orders and goods-received notes, imported from the HR640
/// procurement report. One row is an ORDER, not a tank receipt: it carries a
/// supplier and cost but no tank, vehicle or vote.
///
/// Deliberately separate from FuelTransaction. HR640 and the HR580 FRE receipts
/// describe the SAME physical deliveries at two stages — an order is raised,
/// then the fuel lands in a tank a median of 10 days later — so the two overlap
/// wherever both exist and must never be summed.
///
/// Unlike FuelTransaction.transDate (ISO text, filtered by raw string SQL),
/// orderDate is a real DateTime and this table is queried ONLY through Prisma.
model FuelDelivery {
  id         String   @id @default(cuid())
  orderNo    String
  orderDate  DateTime
  suppRef    String?
  suppName   String
  itemCode   String
  itemDesc   String
  /// Normalised from itemDesc: Diesel / Petrol / Unknown.
  fuelType   String
  orderQty   Float
  orderCost  Float
  /// Goods actually received. 0 = ordered but not yet delivered.
  grnQty     Float
  grnCost    Float
  createdAt  DateTime @default(now())

  @@unique([orderNo, itemCode])
  @@index([orderDate])
  @@index([fuelType])
}
