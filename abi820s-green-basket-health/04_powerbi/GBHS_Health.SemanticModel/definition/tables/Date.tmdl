/// Conformed calendar (complete years 2021 to the latest data year) with calendar, ISO epidemiological week (IDSR), fiscal year (April-March) and rainy-season attributes. Marked as the date table.
table Date
	dataCategory: Time

	/// Smart surrogate key YYYYMMDD (-1 = unknown, -2 = not applicable / not yet happened). Source: generated by etl.sp_load_dim_date
	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	/// Calendar date. Source: generated
	column Date
		dataType: dateTime
		isKey
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: full_date

	/// Day number within the month (1-31). Source: derived
	column 'Day of Month'
		dataType: int64
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: day_of_month

	/// ISO weekday number, Monday = 1 ... Sunday = 7 (sort key for day_name). Source: derived
	column 'Day of Week'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: day_of_week_iso

	/// Weekday name (Monday..Sunday). Source: derived
	column 'Day Name'
		dataType: string
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: 'Day of Week'

	/// Three-letter weekday abbreviation (sort by day_of_week_iso). Source: derived
	column 'Day Short'
		dataType: string
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: day_short
		sortByColumn: 'Day of Week'

	/// True for Saturday and Sunday. Source: derived
	column 'Is Weekend'
		dataType: boolean
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: is_weekend

	/// Namibian public holiday (Public Holidays Act 26 of 1990, incl. Easter-based dates).
	column 'Is Public Holiday'
		dataType: boolean
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: is_public_holiday

	/// Name of the Namibian public holiday, NULL otherwise. Source: etl.fn_namibian_holiday
	column 'Holiday Name'
		dataType: string
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: holiday_name

	/// ISO year of the epidemiological week (Monday-Sunday) used by IDSR reporting.
	column 'Epi Year'
		dataType: int64
		displayFolder: Epidemiological week (IDSR)
		summarizeBy: none
		sourceColumn: epi_year

	/// Epidemiological week number 1-53 (ISO-8601, Monday-Sunday), as used for IDSR weekly reporting. Source: derived (IW)
	column 'Epi Week'
		dataType: int64
		displayFolder: Epidemiological week (IDSR)
		summarizeBy: none
		sourceColumn: epi_week

	/// e.g. 2026-W39.
	column 'Epi Week Label'
		dataType: string
		displayFolder: Epidemiological week (IDSR)
		summarizeBy: none
		sourceColumn: epi_week_label
		sortByColumn: 'Epi Week Key'

	/// Integer YYYYWW (sort key for epi_week_label). Source: derived
	column 'Epi Week Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: epi_week_key

	/// Monday of the epi week; use as a continuous weekly axis.
	column 'Epi Week Start'
		dataType: dateTime
		formatString: d mmm yyyy
		displayFolder: Epidemiological week (IDSR)
		summarizeBy: none
		sourceColumn: epi_week_start

	/// Calendar month number 1-12 (sort key for month_name). Source: derived
	column 'Month Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_num

	/// Calendar month name. Source: derived
	column 'Month Name'
		dataType: string
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: 'Month Number'

	/// Three-letter month abbreviation (sort by month_num). Source: derived
	column 'Month Short'
		dataType: string
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: month_short
		sortByColumn: 'Month Number'

	/// Year-month label YYYY-MM. Source: derived
	column 'Year Month'
		dataType: string
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: year_month
		sortByColumn: 'Year Month Key'

	/// Integer YYYYMM (sort key for year_month). Source: derived
	column 'Year Month Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: year_month_key

	/// First day of the month. Source: derived
	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: month_start_date

	/// Calendar quarter 1-4. Source: derived
	column 'Quarter Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: quarter_num

	/// Quarter label YYYY-Qn. Source: derived
	column 'Year Quarter'
		dataType: string
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: year_quarter

	/// Calendar year (time-intelligence year for YTD and year-on-year measures). Source: derived
	column 'Calendar Year'
		dataType: int64
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: calendar_year

	/// Fiscal year label FYyyyy/yy; the GBHS financial year runs 1 April - 31 March (aligned with the Namibian public sector). Source: derived
	column 'Fiscal Year'
		dataType: string
		displayFolder: Fiscal (Apr-Mar)
		summarizeBy: none
		sourceColumn: fiscal_year_label
		sortByColumn: 'Fiscal Year Start'

	/// Calendar year in which the fiscal year starts (sort key for fiscal_year_label). Source: derived
	column 'Fiscal Year Start'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: fiscal_year_start

	/// July-June season label used for malaria transmission seasons.
	column 'Rainy Season'
		dataType: string
		displayFolder: Seasons
		summarizeBy: none
		sourceColumn: rainy_season_label

	/// January-May peak transmission months.
	column 'Is Malaria Season'
		dataType: boolean
		displayFolder: Seasons
		summarizeBy: none
		sourceColumn: is_malaria_season

	/// True for dates after the latest extract (no data yet).
	column 'Is After Cut-off'
		dataType: boolean
		displayFolder: Calendar
		summarizeBy: none
		sourceColumn: is_after_cutoff

	hierarchy Calendar

		level 'Calendar Year'
			column: 'Calendar Year'

		level 'Year Quarter'
			column: 'Year Quarter'

		level 'Year Month'
			column: 'Year Month'

		level Date
			column: Date

	hierarchy Epidemiological

		level 'Epi Year'
			column: 'Epi Year'

		level 'Epi Week Label'
			column: 'Epi Week Label'

		level Date
			column: Date

	hierarchy Fiscal

		level 'Fiscal Year'
			column: 'Fiscal Year'

		level 'Year Month'
			column: 'Year Month'

		level Date
			column: Date

	partition Date = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("v_dim_date.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_dim_date"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"date_key", Int64.Type}, {"full_date", type date}, {"day_of_month", Int64.Type}, {"day_of_week_iso", Int64.Type}, {"day_name", type text}, {"day_short", type text}, {"is_weekend", type logical}, {"is_public_holiday", type logical}, {"holiday_name", type text}, {"epi_year", Int64.Type}, {"epi_week", Int64.Type}, {"epi_week_label", type text}, {"epi_week_key", Int64.Type}, {"epi_week_start", type date}, {"month_num", Int64.Type}, {"month_name", type text}, {"month_short", type text}, {"year_month", type text}, {"year_month_key", Int64.Type}, {"month_start_date", type date}, {"quarter_num", Int64.Type}, {"year_quarter", type text}, {"calendar_year", Int64.Type}, {"fiscal_year_label", type text}, {"fiscal_year_start", Int64.Type}, {"rainy_season_label", type text}, {"is_malaria_season", type logical}, {"is_after_cutoff", type logical}}, "en-US")
				in
				    Typed

