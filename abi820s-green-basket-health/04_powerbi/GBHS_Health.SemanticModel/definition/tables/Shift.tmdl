/// Nursing shift (Day 07:00-19:00, Night 19:00-07:00).
table Shift

	/// Surrogate key. Source: generated
	column 'Shift Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: shift_key

	/// D or N. Source: e-roster shift via ref.code_map (RS01)
	column 'Shift Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: shift_code

	/// Shift name. Source: ref.code_map
	column Shift
		dataType: string
		summarizeBy: none
		sourceColumn: shift_name
		sortByColumn: 'Shift Key'

	partition Shift = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("v_dim_shift.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_dim_shift"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"shift_key", Int64.Type}, {"shift_code", type text}, {"shift_name", type text}}, "en-US")
				in
				    Typed

