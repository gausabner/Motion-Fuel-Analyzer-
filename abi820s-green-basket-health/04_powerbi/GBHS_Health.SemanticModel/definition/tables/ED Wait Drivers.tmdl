/// Effects on door-to-doctor time from the OLS model on log waiting time (03_analytics/ed_wait_drivers.py); disconnected.
table 'ED Wait Drivers'

	/// Explanatory variable of the waiting-time model.
	column Driver
		dataType: string
		summarizeBy: none
		sourceColumn: driver

	column 'Effect %'
		dataType: double
		isHidden
		summarizeBy: average
		sourceColumn: effect_pct

	column 'CI Low %'
		dataType: double
		isHidden
		summarizeBy: average
		sourceColumn: ci_low

	column 'CI High %'
		dataType: double
		isHidden
		summarizeBy: average
		sourceColumn: ci_high

	/// Two-sided p-value with HC3 robust standard errors.
	column 'P Value'
		dataType: double
		formatString: 0.000
		summarizeBy: none
		sourceColumn: p_value

	/// Model specification.
	column Model
		dataType: string
		summarizeBy: none
		sourceColumn: model

	partition 'ED Wait Drivers' = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("analytics_ed_drivers.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "analytics_ed_drivers"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"driver", type text}, {"effect_pct", type number}, {"ci_low", type number}, {"ci_high", type number}, {"p_value", type number}, {"model", type text}}, "en-US")
				in
				    Typed

