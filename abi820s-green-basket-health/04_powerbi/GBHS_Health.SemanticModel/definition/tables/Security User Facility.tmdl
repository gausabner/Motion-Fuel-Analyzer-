/// Dynamic RLS mapping: user principal name -> facility (disconnected; read only by the Facility Manager role).
table 'Security User Facility'
	isHidden

	/// Entra ID UPN in lower case, compared with LOWER(USERPRINCIPALNAME()).
	column 'User Principal Name'
		dataType: string
		summarizeBy: none
		sourceColumn: user_principal_name

	/// Surrogate key (-1 = Unknown). Source: generated
	column 'Facility Key'
		dataType: int64
		summarizeBy: none
		sourceColumn: facility_key

	partition 'Security User Facility' = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("v_sec_user_facility.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_sec_user_facility"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"user_principal_name", type text}, {"facility_key", Int64.Type}}, "en-US")
				in
				    Typed

