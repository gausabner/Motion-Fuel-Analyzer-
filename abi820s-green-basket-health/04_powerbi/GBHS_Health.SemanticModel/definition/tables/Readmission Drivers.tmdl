/// Odds ratios of the logistic readmission model (reference coding); disconnected.
table 'Readmission Drivers'

	/// Feature of the logistic model (reference coding).
	column Driver
		dataType: string
		summarizeBy: none
		sourceColumn: driver

	column 'Odds Ratio Value'
		dataType: double
		isHidden
		summarizeBy: average
		sourceColumn: odds_ratio

	/// Raises or lowers the odds of readmission.
	column Direction
		dataType: string
		summarizeBy: none
		sourceColumn: direction

	partition 'Readmission Drivers' = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("analytics_readmission_drivers.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "analytics_readmission_drivers"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"driver", type text}, {"odds_ratio", type number}, {"direction", type text}}, "en-US")
				in
				    Typed

