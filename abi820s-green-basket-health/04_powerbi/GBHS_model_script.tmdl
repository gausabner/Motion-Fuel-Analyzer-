					        then ReadCsv("v_fact_idsr_report.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_fact_idsr_report"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"epi_week_date_key", Int64.Type}, {"facility_key", Int64.Type}, {"report_expected", Int64.Type}, {"report_received", Int64.Type}, {"report_on_time", Int64.Type}, {"hours_after_due", type number}}, "en-US")
					in
					    Typed


	/// North-East (Rundu, Katima Mulilo, Nkurenkuru) weekly malaria: actuals, rolling-origin back-test and 13-week forecast (03_analytics/forecasting.py).
	table 'Malaria Forecast'

		column 'Week Date Key'
