	/// E-roster shift summary (periodic snapshot; grain: unit x day x shift). Hours are additive; staff on duty are semi-additive.
	table 'Staff Roster'

		/// FK to dim_date (date the shift starts). Source: e-roster roster_date
		column 'Roster Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: roster_date_key

		/// FK to dim_care_unit version valid on the roster date. Source: e-roster unit_code
		column 'Care Unit Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: care_unit_key

		/// FK to dim_shift. Source: e-roster shift (RS01)
		column 'Shift Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: shift_key

		/// Nursing hours on the approved roster (additive). Source: e-roster
		column 'Planned Nurse Hours'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: planned_nurse_hours

		/// Total nursing hours worked = rn_hours + en_hours (additive; numerator of NHPPD). Source: derived
		column 'Nurse Hours'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: nurse_hours

		/// Registered-nurse hours worked (additive). Source: e-roster (RS02)
		column 'RN Hours'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: rn_hours

		/// Doctor hours worked in the unit (additive). Source: e-roster
		column 'Doctor Hours'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: doctor_hours

		/// Overtime nursing hours (additive; NULL when inconsistent, RS04). Source: e-roster
		column 'Overtime Hours'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: overtime_hours

		/// Agency (temporary) nursing hours (additive). Source: e-roster
		column 'Agency Hours'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: agency_hours

		/// Rostered hours lost to sick leave (additive). Source: e-roster
		column 'Sick Leave Hours'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: sick_leave_hours

		/// Nurses on duty during the shift (semi-additive). Source: e-roster
		column 'Nurses on Duty'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: nurses_on_duty

		/// Doctors on duty during the shift (semi-additive). Source: e-roster
		column 'Doctors on Duty'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: doctors_on_duty

		partition 'Staff Roster' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_fact_staff_roster.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_fact_staff_roster"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"roster_date_key", Int64.Type}, {"care_unit_key", Int64.Type}, {"shift_key", Int64.Type}, {"planned_nurse_hours", type number}, {"nurse_hours", type number}, {"rn_hours", type number}, {"doctor_hours", type number}, {"overtime_hours", type number}, {"agency_hours", type number}, {"sick_leave_hours", type number}, {"nurses_on_duty", Int64.Type}, {"doctors_on_duty", Int64.Type}}, "en-US")
					in
					    Typed


	/// IDSR weekly returns (periodic snapshot; grain: facility x condition x epi week; key = Monday of the epi week).
	table Surveillance

		/// FK to dim_date = Monday of the ISO epi week. Source: IDSR epi_week (SV01)
		column 'Epi Week Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: epi_week_date_key

		/// FK to dim_facility (reporting facility). Source: IDSR facility_code
		column 'Facility Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: facility_key

		/// FK to dim_condition. Source: IDSR condition (SV03)
		column 'Condition Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: condition_key

		/// Cases in children under 5 (additive). Source: IDSR return (SV06, SV07)
		column 'Cases Under 5'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: cases_under5

		/// Cases aged 5 and over (additive). Source: IDSR return (SV06, SV07)
		column 'Cases 5 Plus'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: cases_5plus

		/// All cases = under 5 + 5 and over (additive). Source: derived
		column 'Cases Total'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: cases_total

		/// All deaths (additive). Source: derived
		column 'Deaths Total'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: deaths_total

		/// Malaria tests performed (RDT/microscopy); NULL for other conditions (additive). Source: IDSR return (SV05)
		column 'Tests Done'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: tests_done

		/// Positive malaria tests (additive). Source: IDSR return (SV05)
		column 'Tests Positive'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: tests_positive

		partition Surveillance = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_fact_surveillance.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_fact_surveillance"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"epi_week_date_key", Int64.Type}, {"facility_key", Int64.Type}, {"condition_key", Int64.Type}, {"cases_under5", Int64.Type}, {"cases_5plus", Int64.Type}, {"cases_total", Int64.Type}, {"deaths_total", Int64.Type}, {"tests_done", Int64.Type}, {"tests_positive", Int64.Type}}, "en-US")
					in
					    Typed


	/// South African Triage Scale (SATS) category with time-to-doctor target.
	table Triage

		/// Surrogate key = priority (-1 = not recorded). Source: generated
		column 'Triage Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: triage_key

		/// Triage colour code. Source: master data, Triage_Scale sheet
		column 'Triage Code'
			dataType: string
			summarizeBy: none
			sourceColumn: triage_code
			sortByColumn: Priority

		/// Triage label (colour and urgency). Source: master data
		column 'Triage Category'
			dataType: string
			summarizeBy: none
			sourceColumn: triage_label
			sortByColumn: Priority

		/// Clinical priority 1 (highest) - 9 (sort key). Source: master data
		column Priority
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: priority

		/// Target time from arrival to doctor in minutes (0 = immediate). Source: master data (SATS-style targets)
		column 'Target (min)'
			dataType: int64
			summarizeBy: none
			sourceColumn: target_minutes

		/// Minutes within which the patient counts as seen on time (RED: 5 minutes for 'immediate').
		column 'Compliance Threshold (min)'
			dataType: int64
			summarizeBy: none
			sourceColumn: compliance_minutes

		/// Target in words. Source: master data
		column Target
			dataType: string
			summarizeBy: none
			sourceColumn: target_text

		/// Display colour (used with text labels, never colour alone). Source: master data
		column Colour
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: colour_hex

		partition Triage = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
