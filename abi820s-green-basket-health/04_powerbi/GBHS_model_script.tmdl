	/// Field parameter: lets users switch the metric shown in a visual.
	table 'Metric Selector'

		column Metric
			summarizeBy: none
			sourceColumn: [Value1]
			sortByColumn: 'Metric Order'

			relatedColumnDetails
				groupByColumn: 'Metric Fields'

		column 'Metric Fields'
			isHidden
			summarizeBy: none
			sourceColumn: [Value2]
			sortByColumn: 'Metric Order'

			extendedProperty ParameterMetadata =
					{
					  "version": 3,
					  "kind": 2
					}

		column 'Metric Order'
			isHidden
			summarizeBy: sum
			sourceColumn: [Value3]

		partition 'Metric Selector' = calculated
			mode: import
			source =
					{
					    ( "ED Attendances", NAMEOF ( '_Measures'[ED Attendances] ), 0 ),
					    ( "Seen Within Target %", NAMEOF ( '_Measures'[Seen Within Target %] ), 1 ),
					    ( "Median Door-to-Doctor (min)", NAMEOF ( '_Measures'[Median Door-to-Doctor (min)] ), 2 ),
					    ( "LWBS Rate %", NAMEOF ( '_Measures'[LWBS Rate %] ), 3 ),
					    ( "Bed Occupancy %", NAMEOF ( '_Measures'[Bed Occupancy %] ), 4 ),
					    ( "ALOS (days)", NAMEOF ( '_Measures'[ALOS (days)] ), 5 ),
					    ( "Readmission Rate 30d %", NAMEOF ( '_Measures'[Readmission Rate 30d %] ), 6 ),
					    ( "NHPPD", NAMEOF ( '_Measures'[NHPPD] ), 7 ),
					    ( "Malaria Cases", NAMEOF ( '_Measures'[Malaria Cases] ), 8 )
					}


	/// Weeks flagged by the outbreak-detection algorithms (EARS C2, CUSUM, historical limits; 03_analytics/outbreak_detection.py).
	table 'Outbreak Alerts'

		column 'Week Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: week_date_key

		column 'Facility Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: facility_key

		column 'Condition Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: condition_key

		/// Detection algorithm: EARS C2, CUSUM or historical limits (malaria).
		column Method
			dataType: string
			summarizeBy: none
			sourceColumn: method

		column Cases
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: cases

		column Expected
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: expected

		column Threshold
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: threshold_value

		/// True if the week lies in one of the 12 outbreaks injected by the generator (ground truth for evaluation).
		column 'Is Known Outbreak'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_injected_outbreak

		partition 'Outbreak Alerts' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
