	relationship 'Admission[Diagnosis Key] -> Diagnosis'
		fromColumn: Admission.'Diagnosis Key'
		toColumn: Diagnosis.'Diagnosis Key'

	relationship 'Admission[Admission Profile Key] -> Admission Profile'
		fromColumn: Admission.'Admission Profile Key'
		toColumn: 'Admission Profile'.'Admission Profile Key'

	relationship 'Admission[Age Band Key] -> Age Band'
		fromColumn: Admission.'Age Band Key'
		toColumn: 'Age Band'.'Age Band Key'

	relationship 'Ward Census[Census Date Key] -> Date'
		fromColumn: 'Ward Census'.'Census Date Key'
		toColumn: Date.'Date Key'

	relationship 'Ward Census[Care Unit Key] -> Care Unit'
		fromColumn: 'Ward Census'.'Care Unit Key'
		toColumn: 'Care Unit'.'Care Unit Key'

	relationship 'Staff Roster[Roster Date Key] -> Date'
		fromColumn: 'Staff Roster'.'Roster Date Key'
		toColumn: Date.'Date Key'

	relationship 'Staff Roster[Care Unit Key] -> Care Unit'
		fromColumn: 'Staff Roster'.'Care Unit Key'
		toColumn: 'Care Unit'.'Care Unit Key'

	relationship 'Staff Roster[Shift Key] -> Shift'
		fromColumn: 'Staff Roster'.'Shift Key'
		toColumn: Shift.'Shift Key'

