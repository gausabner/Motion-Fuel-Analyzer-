	/// Reconciliation checks of the latest load batch (row counts, control totals, cross-source); disconnected.
	table Reconciliation

		/// Reconciliation check identifier (R01-R22).
		column 'Check Code'
			dataType: string
			summarizeBy: none
			sourceColumn: check_code

		/// What is compared.
		column Check
			dataType: string
			summarizeBy: none
			sourceColumn: check_name

		/// Row count, control total, cross-source, integrity, completeness, referential or plausibility.
		column 'Check Type'
			dataType: string
			summarizeBy: none
			sourceColumn: check_type

		/// Value on the source / staging side.
		column 'Source Value'
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: source_value

		/// Value on the warehouse side.
		column 'Target Value'
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: target_value

		/// Target minus source.
		column Difference
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: difference

		/// PASS, WARN (explained, within tolerance) or FAIL (stops publication).
		column Status
			dataType: string
			summarizeBy: none
			sourceColumn: status

		/// Business explanation of any difference.
		column Explanation
			dataType: string
			summarizeBy: none
			sourceColumn: explanation

		partition Reconciliation = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_recon_latest.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_recon_latest"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"check_code", type text}, {"check_name", type text}, {"check_type", type text}, {"source_value", type number}, {"target_value", type number}, {"difference", type number}, {"status", type text}, {"explanation", type text}}, "en-US")
					in
					    Typed


	/// Namibia's 14 regions (ISO 3166-2:NA) with GBHS management zone and malaria-endemicity stratum.
	table Region

		/// Surrogate key (-1 = Unknown). Source: generated
		column 'Region Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: region_key

		/// ISO 3166-2:NA region code (e.g. NA-KE). Source: master data, Regions sheet
		column 'Region Code'
			dataType: string
			summarizeBy: none
			sourceColumn: region_code

		/// Official region name. Source: master data, Regions sheet
		column Region
			dataType: string
			dataCategory: StateOrProvince
			summarizeBy: none
			sourceColumn: region_name

		/// GBHS management zone (North-East, North-Central, Central, West, South, East, North-West). Source: master data
		column Zone
			dataType: string
			summarizeBy: none
			sourceColumn: zone

		/// Malaria planning stratum: Endemic - high, Endemic - low, Non-endemic (imported cases only). Source: master data (GBHS planning assumption based on MoHSS stratification)
		column 'Malaria Stratum'
			dataType: string
			summarizeBy: none
			sourceColumn: malaria_stratum

		hierarchy Geography

			level Zone
				column: Zone

			level Region
				column: Region

		partition Region = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_dim_region.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_dim_region"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"region_key", Int64.Type}, {"region_code", type text}, {"region_name", type text}, {"zone", type text}, {"malaria_stratum", type text}}, "en-US")
					in
					    Typed


	/// NSA 2023 Population and Housing Census by region (2023 = census count; other years projected). Semi-additive over time: never sum across years.
	table 'Regional Population'

		/// FK to dim_date = 1 July of the year (mid-year population). Source: derived
		column 'Year Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: year_date_key

		/// FK to dim_region. Source: NSA region name mapped through ref.region_alias
		column 'Region Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: region_key

		/// Population (semi-additive). 2023 = census count; other years = 2023 count x (1 + national intercensal growth 2011-2023)^(year-2023). Source: NSA 2023 PHC preliminary results (EX01)
		column Population
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: population

		/// True for the census year itself, false for derived estimates. Source: ETL
		column 'Is Census Count'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_census_count

		/// Provenance text shown in report tooltips. Source: ETL
		column 'Population Source'
			dataType: string
			summarizeBy: none
			sourceColumn: population_source

		partition 'Regional Population' = m
			mode: import
			source =
