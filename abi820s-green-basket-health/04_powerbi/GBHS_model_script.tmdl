		toColumn: Condition.'Condition Key'


	/// Unrestricted read for the executive committee, the CEO and the BI team.
	role 'Executive (all facilities)'
		modelPermission: read


	/// Dynamic RLS: users see the facilities mapped to their UPN in sec.user_facility_access (and every ward, attendance, spell, roster, census and surveillance row of those facilities). They can read only their own mapping rows.
	role 'Facility Manager (dynamic)'
		modelPermission: read

		tablePermission Facility =
				'Facility'[Facility Key]
				    IN CALCULATETABLE (
				        VALUES ( 'Security User Facility'[Facility Key] ),
				        'Security User Facility'[User Principal Name] = LOWER ( USERPRINCIPALNAME () )
				    )

		tablePermission 'Security User Facility' = 'Security User Facility'[User Principal Name] = LOWER ( USERPRINCIPALNAME () )


	/// Static RLS: the North-East malaria task team sees Zambezi and the two Kavango regions only.
	role 'North-East Zone (static)'
		modelPermission: read

		tablePermission Region = 'Region'[Zone] = "North-East"


	/// Object-level security for the MoHSS surveillance unit: patient-level tables (attendances, spells, patients, model outputs on patients, the access list) are invisible - not just empty. Aggregated IDSR, population and weather data only.
	role 'Surveillance Partner (aggregate only)'
		modelPermission: read

		tablePermission Attendance
			metadataPermission: none

		tablePermission Admission
			metadataPermission: none

		tablePermission Patient
			metadataPermission: none

		tablePermission 'Readmission Deciles'
			metadataPermission: none

		tablePermission 'Readmission Drivers'
			metadataPermission: none

		tablePermission 'Security User Facility'
			metadataPermission: none

