		fromColumn: Surveillance.'Condition Key'
		toColumn: Condition.'Condition Key'

	relationship 'IDSR Report[Epi Week Date Key] -> Date'
		fromColumn: 'IDSR Report'.'Epi Week Date Key'
		toColumn: Date.'Date Key'

	relationship 'IDSR Report[Facility Key] -> Facility'
		fromColumn: 'IDSR Report'.'Facility Key'
