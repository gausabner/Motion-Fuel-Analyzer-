// GBHS health semantic model - TMDL script for Power BI Desktop TMDL view (createOrReplace).
// Usage: blank report > TMDL view > new tab > paste all > Apply > then Home > Refresh.

createOrReplace

	expression PgServer = "localhost:5432" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

		annotation PBI_ResultType = Text

	expression PgDatabase = "gbhs_health_dw" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

		annotation PBI_ResultType = Text

	expression SourceMode = "PostgreSQL" meta [IsParameterQuery = true, List = {"PostgreSQL", "CSV"}, DefaultValue = "PostgreSQL", Type = "Text", IsParameterQueryRequired = true]

		annotation PBI_ResultType = Text

	expression CsvFolder = "C:\GBHS\04_powerbi\data_csv\" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

		annotation PBI_ResultType = Text

	expression RangeStart = #datetime(2022, 1, 1, 0, 0, 0) meta [IsParameterQuery = true, Type = "DateTime", IsParameterQueryRequired = true]

		annotation PBI_ResultType = DateTime

	expression RangeEnd = #datetime(2027, 1, 1, 0, 0, 0) meta [IsParameterQuery = true, Type = "DateTime", IsParameterQueryRequired = true]

		annotation PBI_ResultType = DateTime


	/// Junk dimension: admission method x discharge status.
	table 'Admission Profile'

		/// Surrogate key. Source: generated (Cartesian product)
		column 'Admission Profile Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: admission_profile_key

		/// EMER-ED, EMER-DIRECT, ELECTIVE, MATERNITY, TRANSFER-IN or UNK. Source: PAS admission_method via ref.code_map (AD07)
		column 'Admission Method Code'
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: admission_method_code

		/// Admission method description. Source: ref.code_map
		column 'Admission Method'
			dataType: string
			summarizeBy: none
			sourceColumn: admission_method_name

		/// True for unplanned admissions (EMER-ED, EMER-DIRECT, TRANSFER-IN). Source: derived
		column 'Is Emergency Admission'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_emergency

		/// HOME, TRANSFER, DIED, AMA, IN (still in hospital) or UNK. Source: PAS discharge_status
		column 'Discharge Status Code'
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: discharge_status_code

		/// Discharge status description. Source: ref.code_map
		column 'Discharge Status'
			dataType: string
			summarizeBy: none
			sourceColumn: discharge_status_name

		partition 'Admission Profile' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_dim_admission_profile.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_dim_admission_profile"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"admission_profile_key", Int64.Type}, {"admission_method_code", type text}, {"admission_method_name", type text}, {"is_emergency", type logical}, {"discharge_status_code", type text}, {"discharge_status_name", type text}}, "en-US")
					in
					    Typed


	/// Inpatient spells (accumulating snapshot; grain: one row per spell, updated as milestones arrive: admission, discharge, 30-day follow-up). Active date = admission; inactive role-playing date = discharge.
	table Admission

		/// FK to dim_date - admission date (active relationship). Source: PAS admission_datetime
		column 'Admission Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: admission_date_key

		/// FK to dim_date - discharge date (role-playing; -2 = still in hospital). Source: PAS discharge_datetime (AD02, AD03)
		column 'Discharge Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: discharge_date_key

		/// FK to dim_care_unit version (admitting ward) valid on the admission date. Source: PAS ward_code (AD04)
		column 'Care Unit Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: care_unit_key

		/// FK to dim_patient version valid on the admission date. Source: PAS patient_id
		column 'Patient Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: patient_key

		/// Durable (supernatural) key: the surrogate key of the patient's first version, identical on every version - used to count distinct patients across SCD2 versions. Source: ETL
		column 'Patient Durable Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: patient_durable_key

		/// FK to dim_diagnosis - principal diagnosis (-1 until coded). Source: PAS principal_icd10 (AD05)
		column 'Diagnosis Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: diagnosis_key

		/// FK to the admission method x discharge status junk dimension. Source: PAS admission_method, discharge_status (AD07)
		column 'Admission Profile Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: admission_profile_key

		/// FK to dim_age_band (age at admission). Source: derived
		column 'Age Band Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: age_band_key

		/// Always 1; additive count of spells. Source: ETL
		column 'Admission Count'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: admission_count

		/// Length of stay in midnights (discharge date - admission date); NULL while in hospital. Additive (= patient days). Source: derived
		column 'LOS (days)'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: los_days

		/// 1 once the discharge milestone is recorded. Source: derived
		column 'Is Discharged'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: is_discharged

		/// 1 for an in-hospital death. Source: discharge_status = DIED
		column 'Is Died'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: is_died

		/// 1 if discharged before 12:00 (flow KPI); NULL while in hospital. Source: derived
		column 'Discharged Before Noon'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: discharged_before_noon

		/// 1 if discharged on Saturday or Sunday; NULL while in hospital. Source: derived
		column 'Is Weekend Discharge'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: is_weekend_discharge

		/// 1 if this spell is an emergency admission within 30 days of the same patient's previous live discharge. Source: derived (window over patient pseudonym)
		column 'Is Readmission 30d'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: is_readmission_30d

		/// 1 if this spell counts in the readmission-rate denominator: discharged alive (home or AMA), not maternity, and 30 days of follow-up available. Source: derived (GBHS KPI definition)
		column 'Readmission Eligible'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: readmission_eligible

		/// 1 if an eligible spell was followed by an emergency readmission within 30 days (milestone 3). Source: derived
		column 'Readmitted Within 30d'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: readmitted_within_30d

		/// Number of the patient's admissions in the 365 days before this admission (risk feature). Source: derived
		column 'Prior Admissions 12m'
			dataType: int64
			isHidden
			summarizeBy: average
			sourceColumn: prior_admissions_12m

		/// 1 if the spell is still open more than 60 days after admission at the snapshot date (AD06, probable missing discharge). Source: derived
		column 'Is Open Over 60d'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: is_open_over_60d

		partition Admission = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_fact_admission.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_fact_admission"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"admission_date_key", Int64.Type}, {"discharge_date_key", Int64.Type}, {"care_unit_key", Int64.Type}, {"patient_key", Int64.Type}, {"patient_durable_key", Int64.Type}, {"diagnosis_key", Int64.Type}, {"admission_profile_key", Int64.Type}, {"age_band_key", Int64.Type}, {"admission_count", Int64.Type}, {"los_days", Int64.Type}, {"is_discharged", Int64.Type}, {"is_died", Int64.Type}, {"discharged_before_noon", Int64.Type}, {"is_weekend_discharge", Int64.Type}, {"is_readmission_30d", Int64.Type}, {"readmission_eligible", Int64.Type}, {"readmitted_within_30d", Int64.Type}, {"prior_admissions_12m", Int64.Type}, {"is_open_over_60d", Int64.Type}}, "en-US")
					in
					    Typed


	/// Age at the event, in reporting bands (IDSR under-5 split).
	table 'Age Band'

		/// Surrogate key = sort order (-1 = Unknown). Source: generated
		column 'Age Band Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: age_band_key

		/// Age band label (0-4, 5-14, 15-24, 25-44, 45-64, 65+). Source: generated
		column 'Age Band'
			dataType: string
			summarizeBy: none
			sourceColumn: age_band
			sortByColumn: 'Age Band Key'

		/// IDSR reporting group: Under 5 or 5 and over. Source: generated
		column 'IDSR Age Group'
			dataType: string
			summarizeBy: none
			sourceColumn: idsr_age_group

		/// Child, Adult or Older adult. Source: generated
		column 'Life Stage'
			dataType: string
			summarizeBy: none
			sourceColumn: life_stage

		partition 'Age Band' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_dim_age_band.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_dim_age_band"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"age_band_key", Int64.Type}, {"age_band", type text}, {"idsr_age_group", type text}, {"life_stage", type text}}, "en-US")
					in
					    Typed


	/// ED and clinic attendances (transaction fact; grain: one row per attendance). Import with incremental refresh on Arrival Date Key.
	table Attendance

		refreshPolicy
			policyType: basic
			rollingWindowGranularity: year
			rollingWindowPeriods: 5
			incrementalGranularity: day
			incrementalPeriods: 10
			sourceExpression =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("v_fact_encounter.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_fact_encounter"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"arrival_date_key", Int64.Type}, {"arrival_hour_key", Int64.Type}, {"care_unit_key", Int64.Type}, {"patient_key", Int64.Type}, {"patient_durable_key", Int64.Type}, {"diagnosis_key", Int64.Type}, {"triage_key", Int64.Type}, {"encounter_profile_key", Int64.Type}, {"age_band_key", Int64.Type}, {"encounter_count", Int64.Type}, {"wait_to_triage_min", type number}, {"door_to_doctor_min", type number}, {"ed_los_min", type number}, {"seen_within_target", Int64.Type}, {"is_lwbs", Int64.Type}, {"is_admitted", Int64.Type}, {"is_died", Int64.Type}}, "en-US"),
				    // incremental refresh window (RangeStart/RangeEnd folded to SQL as integer date keys)
				    Filtered = Table.SelectRows(Typed, each [arrival_date_key] >= Int64.From(DateTime.ToText(RangeStart, "yyyyMMdd")) and [arrival_date_key] < Int64.From(DateTime.ToText(RangeEnd, "yyyyMMdd")))
				in
				    Filtered

		/// FK to dim_date (arrival date). Source: PAS arrival_datetime (EN02, EN12)
		column 'Arrival Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: arrival_date_key

		/// FK to dim_hour (arrival hour). Source: PAS arrival_datetime
		column 'Arrival Hour Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: arrival_hour_key

		/// FK to dim_care_unit version valid on the arrival date (ED or clinic unit). Source: PAS facility_code + department (EN03)
		column 'Care Unit Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: care_unit_key

		/// FK to dim_patient version valid on the arrival date (-1 unidentified). Source: PAS patient_id (EN10, EN11)
		column 'Patient Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: patient_key

		/// First surrogate key of the patient: stable across SCD2 versions (distinct patient counts).
		column 'Patient Durable Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: patient_durable_key

		/// FK to dim_diagnosis (primary diagnosis, -1 not coded/invalid). Source: PAS primary_icd10 (EN07, EN08)
		column 'Diagnosis Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: diagnosis_key

		/// FK to dim_triage (-1 not recorded; 9 clinic attendance). Source: PAS triage_category (EN04, EN09)
		column 'Triage Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: triage_key

		/// FK to the department x arrival mode x disposition junk dimension. Source: PAS department, arrival_mode, disposition
		column 'Encounter Profile Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: encounter_profile_key

		/// FK to dim_age_band (age at arrival). Source: derived from birth year
		column 'Age Band Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: age_band_key

		/// Always 1; additive count of attendances. Source: ETL
		column 'Encounter Count'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: encounter_count

		/// Minutes from arrival to triage (ED only; NULL if invalid). Source: triage_datetime - arrival_datetime
		column 'Wait to Triage (min)'
			dataType: double
			isHidden
			summarizeBy: average
			sourceColumn: wait_to_triage_min

		/// Minutes from arrival to first assessment by a doctor/clinician (NULL if not seen or invalid, EN05/EN06). Source: seen_datetime - arrival_datetime
		column 'Door to Doctor (min)'
			dataType: double
			isHidden
			summarizeBy: average
			sourceColumn: door_to_doctor_min

		/// Minutes from arrival to departure (NULL if > 72 h or negative). Source: departure_datetime - arrival_datetime
		column 'ED Length of Stay (min)'
			dataType: double
			isHidden
			summarizeBy: average
			sourceColumn: ed_los_min

		/// 1 if seen within the triage compliance threshold, 0 if not, NULL if not triaged/seen. Source: derived with dim_triage.compliance_minutes
		column 'Seen Within Target'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: seen_within_target

		/// 1 if the patient left without being seen. Source: disposition = LWBS
		column 'Is LWBS'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: is_lwbs

		/// 1 if admitted to a ward from the ED. Source: disposition = ADM
		column 'Is Admitted'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: is_admitted

		/// 1 if the patient died in the department (incl. dead on arrival). Source: disposition = DIED
		column 'Is Died'
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: is_died

		partition Attendance = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_fact_encounter.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_fact_encounter"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"arrival_date_key", Int64.Type}, {"arrival_hour_key", Int64.Type}, {"care_unit_key", Int64.Type}, {"patient_key", Int64.Type}, {"patient_durable_key", Int64.Type}, {"diagnosis_key", Int64.Type}, {"triage_key", Int64.Type}, {"encounter_profile_key", Int64.Type}, {"age_band_key", Int64.Type}, {"encounter_count", Int64.Type}, {"wait_to_triage_min", type number}, {"door_to_doctor_min", type number}, {"ed_los_min", type number}, {"seen_within_target", Int64.Type}, {"is_lwbs", Int64.Type}, {"is_admitted", Int64.Type}, {"is_died", Int64.Type}}, "en-US"),
					    // incremental refresh window (RangeStart/RangeEnd folded to SQL as integer date keys)
					    Filtered = Table.SelectRows(Typed, each [arrival_date_key] >= Int64.From(DateTime.ToText(RangeStart, "yyyyMMdd")) and [arrival_date_key] < Int64.From(DateTime.ToText(RangeEnd, "yyyyMMdd")))
					in
					    Filtered


	/// Ward / department, SCD Type 2 on specialty and bed complement: facts carry the version valid on the event date (as-was).
	table 'Care Unit'

		/// Surrogate key of the unit version (-1 = Unknown). Source: generated
		column 'Care Unit Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: care_unit_key

		/// Durable natural key of the unit, e.g. RUN-MED1.
		column 'Ward Code'
			dataType: string
			summarizeBy: none
			sourceColumn: unit_code

		/// Unit name (Type 1). Source: master data
		column Ward
			dataType: string
			summarizeBy: none
			sourceColumn: unit_name

		/// Inpatient ward, Emergency department or Outpatient clinic (Type 1). Source: master data
		column 'Unit Type'
			dataType: string
			summarizeBy: none
			sourceColumn: unit_type

		/// FK to dim_facility (snowflake). Source: master data facility_code
		column 'Facility Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: facility_key

		/// As-was specialty (e.g. WHK-MED2 was an isolation ward Jan-Mar 2022).
		column Specialty
			dataType: string
			summarizeBy: none
			sourceColumn: specialty

		/// Official beds of this version.
		column 'Bed Complement'
			dataType: int64
			summarizeBy: none
			sourceColumn: bed_complement

		/// First day the version is valid. Source: Unit_History effective_date
		column 'Effective From'
			dataType: dateTime
			formatString: d mmm yyyy
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: scd_effective_from

		/// Last day the version is valid (9999-12-31 for the current version). Source: ETL
		column 'Effective To'
			dataType: dateTime
			formatString: d mmm yyyy
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: scd_effective_to

		/// True for the current version of the unit. Source: ETL
		column 'Is Current Version'
			dataType: boolean
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: scd_is_current

		/// Version number per unit (1 = first). Source: ETL
		column 'SCD Version'
			dataType: int64
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: scd_version

		hierarchy Unit

			level 'Unit Type'
				column: 'Unit Type'

			level Specialty
				column: Specialty

			level 'Ward Code'
				column: 'Ward Code'

		partition 'Care Unit' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_dim_care_unit.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_dim_care_unit"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"care_unit_key", Int64.Type}, {"unit_code", type text}, {"unit_name", type text}, {"unit_type", type text}, {"facility_key", Int64.Type}, {"specialty", type text}, {"bed_complement", Int64.Type}, {"scd_effective_from", type date}, {"scd_effective_to", type date}, {"scd_is_current", type logical}, {"scd_version", Int64.Type}}, "en-US")
					in
					    Typed


	/// Derived fact: facility catchment population per year = NSA regional population x catchment share (denominator of incidence).
	table 'Catchment Population'

		/// FK to dim_date = 1 July of the year (mid-year population). Source: derived
		column 'Year Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: year_date_key

		/// Surrogate key (-1 = Unknown). Source: generated
		column 'Facility Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: facility_key

		column 'Catchment Population'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: catchment_population

		/// True for the census year itself, false for derived estimates. Source: ETL
		column 'Is Census Year'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_census_count

		partition 'Catchment Population' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_fact_catchment_population.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_fact_catchment_population"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"year_date_key", Int64.Type}, {"facility_key", Int64.Type}, {"catchment_population", Int64.Type}, {"is_census_count", type logical}}, "en-US")
					in
					    Typed


	/// IDSR priority condition (WHO AFRO IDSR technical guidelines) - conformed between PAS diagnoses and IDSR returns.
	table Condition

		/// Surrogate key (-1 = Unknown, -2 = Not a notifiable condition). Source: generated
		column 'Condition Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: condition_key

		/// GBHS IDSR condition code (MAL, COV, MEA ...). Source: master data, IDSR_Conditions sheet
		column 'Condition Code'
			dataType: string
			summarizeBy: none
			sourceColumn: condition_code

		/// Condition name. Source: master data
		column Condition
			dataType: string
			summarizeBy: none
			sourceColumn: condition_name

		/// IDSR category (epidemic-prone, targeted for elimination, other priority). Source: master data (IDSR technical guidelines)
		column 'IDSR Category'
			dataType: string
			summarizeBy: none
			sourceColumn: idsr_category

		/// Notification timeline (immediate within 24 h or weekly). Source: master data
		column Notification
			dataType: string
			summarizeBy: none
			sourceColumn: notification

		/// Alert threshold used by GBHS surveillance officers. Source: master data (GBHS SOP)
		column 'Alert Threshold'
			dataType: string
			summarizeBy: none
			sourceColumn: alert_threshold

		/// False only for the -2 member. Source: ETL
		column 'Is Notifiable'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_notifiable

		partition Condition = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_dim_condition.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_dim_condition"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"condition_key", Int64.Type}, {"condition_code", type text}, {"condition_name", type text}, {"idsr_category", type text}, {"notification", type text}, {"alert_threshold", type text}, {"is_notifiable", type logical}}, "en-US")
					in
					    Typed


	/// Data-quality rule catalogue with the number of issues logged (counts only, no record keys); disconnected.
	table 'DQ Summary'

		/// Data-quality rule identifier (catalogue audit.dq_rule).
		column 'Rule Code'
			dataType: string
			summarizeBy: none
			sourceColumn: rule_code

		/// What the rule detects.
		column Rule
			dataType: string
			summarizeBy: none
			sourceColumn: rule_name

		/// Completeness, uniqueness, validity, accuracy, consistency or timeliness.
		column 'DQ Dimension'
			dataType: string
			summarizeBy: none
			sourceColumn: dq_dimension

		/// Source file or table the rule checks.
		column 'Source Object'
			dataType: string
			summarizeBy: none
			sourceColumn: source_object

		/// REJECT, CORRECT, MAP, IMPUTE, FLAG, KEEP LATEST or INFER.
		column Action
			dataType: string
			summarizeBy: none
			sourceColumn: action

		/// Data steward accountable for the rule and its issue queue.
		column 'Owner Role'
			dataType: string
			summarizeBy: none
			sourceColumn: owner_role

		column Issues
			dataType: int64
			isHidden
			summarizeBy: sum
			sourceColumn: issues

		/// Latest load batch that logged an issue for the rule.
		column 'Last Batch'
			dataType: int64
			summarizeBy: none
			sourceColumn: last_batch

		partition 'DQ Summary' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_dq_summary.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_dq_summary"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"rule_code", type text}, {"rule_name", type text}, {"dq_dimension", type text}, {"source_object", type text}, {"action", type text}, {"owner_role", type text}, {"issues", Int64.Type}, {"last_batch", Int64.Type}}, "en-US")
					in
					    Typed


	/// Conformed calendar (complete years 2021 to the latest data year) with calendar, ISO epidemiological week (IDSR), fiscal year (April-March) and rainy-season attributes. Marked as the date table.
	table Date
		dataCategory: Time

		/// Smart surrogate key YYYYMMDD (-1 = unknown, -2 = not applicable / not yet happened). Source: generated by etl.sp_load_dim_date
		column 'Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: date_key

		/// Calendar date. Source: generated
		column Date
			dataType: dateTime
			isKey
			formatString: d mmm yyyy
			summarizeBy: none
			sourceColumn: full_date

		/// Day number within the month (1-31). Source: derived
		column 'Day of Month'
			dataType: int64
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: day_of_month

		/// ISO weekday number, Monday = 1 ... Sunday = 7 (sort key for day_name). Source: derived
		column 'Day of Week'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: day_of_week_iso

		/// Weekday name (Monday..Sunday). Source: derived
		column 'Day Name'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: day_name
			sortByColumn: 'Day of Week'

		/// Three-letter weekday abbreviation (sort by day_of_week_iso). Source: derived
		column 'Day Short'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: day_short
			sortByColumn: 'Day of Week'

		/// True for Saturday and Sunday. Source: derived
		column 'Is Weekend'
			dataType: boolean
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: is_weekend

		/// Namibian public holiday (Public Holidays Act 26 of 1990, incl. Easter-based dates).
		column 'Is Public Holiday'
			dataType: boolean
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: is_public_holiday

		/// Name of the Namibian public holiday, NULL otherwise. Source: etl.fn_namibian_holiday
		column 'Holiday Name'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: holiday_name

		/// ISO year of the epidemiological week (Monday-Sunday) used by IDSR reporting.
		column 'Epi Year'
			dataType: int64
			displayFolder: Epidemiological week (IDSR)
			summarizeBy: none
			sourceColumn: epi_year

		/// Epidemiological week number 1-53 (ISO-8601, Monday-Sunday), as used for IDSR weekly reporting. Source: derived (IW)
		column 'Epi Week'
			dataType: int64
			displayFolder: Epidemiological week (IDSR)
			summarizeBy: none
			sourceColumn: epi_week

		/// e.g. 2026-W39.
		column 'Epi Week Label'
			dataType: string
			displayFolder: Epidemiological week (IDSR)
			summarizeBy: none
			sourceColumn: epi_week_label
			sortByColumn: 'Epi Week Key'

		/// Integer YYYYWW (sort key for epi_week_label). Source: derived
		column 'Epi Week Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: epi_week_key

		/// Monday of the epi week; use as a continuous weekly axis.
		column 'Epi Week Start'
			dataType: dateTime
			formatString: d mmm yyyy
			displayFolder: Epidemiological week (IDSR)
			summarizeBy: none
			sourceColumn: epi_week_start

		/// Calendar month number 1-12 (sort key for month_name). Source: derived
		column 'Month Number'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: month_num

		/// Calendar month name. Source: derived
		column 'Month Name'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: month_name
			sortByColumn: 'Month Number'

		/// Three-letter month abbreviation (sort by month_num). Source: derived
		column 'Month Short'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: month_short
			sortByColumn: 'Month Number'

		/// Year-month label YYYY-MM. Source: derived
		column 'Year Month'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: year_month
			sortByColumn: 'Year Month Key'

		/// Integer YYYYMM (sort key for year_month). Source: derived
		column 'Year Month Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: year_month_key

		/// First day of the month. Source: derived
		column 'Month Start'
			dataType: dateTime
			formatString: mmm yyyy
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: month_start_date

		/// Calendar quarter 1-4. Source: derived
		column 'Quarter Number'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: quarter_num

		/// Quarter label YYYY-Qn. Source: derived
		column 'Year Quarter'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: year_quarter

		/// Calendar year (time-intelligence year for YTD and year-on-year measures). Source: derived
		column 'Calendar Year'
			dataType: int64
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: calendar_year

		/// Fiscal year label FYyyyy/yy; the GBHS financial year runs 1 April - 31 March (aligned with the Namibian public sector). Source: derived
		column 'Fiscal Year'
			dataType: string
			displayFolder: Fiscal (Apr-Mar)
			summarizeBy: none
			sourceColumn: fiscal_year_label
			sortByColumn: 'Fiscal Year Start'

		/// Calendar year in which the fiscal year starts (sort key for fiscal_year_label). Source: derived
		column 'Fiscal Year Start'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: fiscal_year_start

		/// July-June season label used for malaria transmission seasons.
		column 'Rainy Season'
			dataType: string
			displayFolder: Seasons
			summarizeBy: none
			sourceColumn: rainy_season_label

		/// January-May peak transmission months.
		column 'Is Malaria Season'
			dataType: boolean
			displayFolder: Seasons
			summarizeBy: none
			sourceColumn: is_malaria_season

		/// True for dates after the latest extract (no data yet).
		column 'Is After Cut-off'
			dataType: boolean
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: is_after_cutoff

		hierarchy Calendar

			level 'Calendar Year'
				column: 'Calendar Year'

			level 'Year Quarter'
				column: 'Year Quarter'

			level 'Year Month'
				column: 'Year Month'

			level Date
				column: Date

		hierarchy Epidemiological

			level 'Epi Year'
				column: 'Epi Year'

			level 'Epi Week Label'
				column: 'Epi Week Label'

			level Date
				column: Date

		hierarchy Fiscal

			level 'Fiscal Year'
				column: 'Fiscal Year'

			level 'Year Month'
				column: 'Year Month'

			level Date
				column: Date

		partition Date = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_dim_date.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_dim_date"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"date_key", Int64.Type}, {"full_date", type date}, {"day_of_month", Int64.Type}, {"day_of_week_iso", Int64.Type}, {"day_name", type text}, {"day_short", type text}, {"is_weekend", type logical}, {"is_public_holiday", type logical}, {"holiday_name", type text}, {"epi_year", Int64.Type}, {"epi_week", Int64.Type}, {"epi_week_label", type text}, {"epi_week_key", Int64.Type}, {"epi_week_start", type date}, {"month_num", Int64.Type}, {"month_name", type text}, {"month_short", type text}, {"year_month", type text}, {"year_month_key", Int64.Type}, {"month_start_date", type date}, {"quarter_num", Int64.Type}, {"year_quarter", type text}, {"calendar_year", Int64.Type}, {"fiscal_year_label", type text}, {"fiscal_year_start", Int64.Type}, {"rainy_season_label", type text}, {"is_malaria_season", type logical}, {"is_after_cutoff", type logical}}, "en-US")
					in
					    Typed


	/// ICD-10 (WHO) code > block > chapter, snowflaked to the IDSR Condition it notifies.
	table Diagnosis

		/// Surrogate key (-1 = Unknown / not coded). Source: generated
		column 'Diagnosis Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: diagnosis_key

		/// ICD-10 code (e.g. B50.9). Source: master data, ICD10_Codes sheet (MD06)
		column 'ICD-10 Code'
			dataType: string
			summarizeBy: none
			sourceColumn: icd10_code

		/// ICD-10 code and WHO title, e.g. B54 Unspecified malaria.
		column Diagnosis
			dataType: string
			summarizeBy: none
			sourceColumn: diagnosis_label

		/// Three-character ICD-10 category (e.g. B50). Source: derived
		column 'ICD-10 Category'
			dataType: string
			summarizeBy: none
			sourceColumn: icd10_category

		/// ICD-10 block code range (e.g. B50-B64). Source: master data
		column 'Block Range'
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: block_range

		/// ICD-10 block range and title (WHO ICD-10 2019).
		column 'ICD-10 Block'
			dataType: string
			summarizeBy: none
			sourceColumn: block_label
			sortByColumn: 'Block Range'

		/// ICD-10 chapter in Roman numerals (I-XXII). Source: master data
		column 'Chapter Code'
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: chapter_code

		/// Chapter number 1-22 (sort key for chapter labels). Source: derived
		column 'Chapter Number'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: chapter_number

		/// ICD-10 chapter number and title (WHO ICD-10 2019).
		column 'ICD-10 Chapter'
			dataType: string
			summarizeBy: none
			sourceColumn: chapter_label
			sortByColumn: 'Chapter Number'

		/// GBHS severity class (minor, moderate, serious, critical) used for case-mix adjustment. Source: master data
		column Severity
			dataType: string
			summarizeBy: none
			sourceColumn: severity_class

		/// Default admitting specialty. Source: master data
		column 'Default Specialty'
			dataType: string
			summarizeBy: none
			sourceColumn: default_specialty

		/// True for chronic conditions (readmission risk factor). Source: master data
		column 'Is Chronic'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_chronic

		/// FK to dim_condition (snowflake); -2 when the code is not notifiable. Source: master data idsr_condition_code
		column 'Condition Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: condition_key

		hierarchy ICD-10

			level 'ICD-10 Chapter'
				column: 'ICD-10 Chapter'

			level 'ICD-10 Block'
				column: 'ICD-10 Block'

			level Diagnosis
				column: Diagnosis

		partition Diagnosis = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("v_dim_diagnosis.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_dim_diagnosis"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"diagnosis_key", Int64.Type}, {"icd10_code", type text}, {"diagnosis_label", type text}, {"icd10_category", type text}, {"block_range", type text}, {"block_label", type text}, {"chapter_code", type text}, {"chapter_number", Int64.Type}, {"chapter_label", type text}, {"severity_class", type text}, {"default_specialty", type text}, {"is_chronic", type logical}, {"condition_key", Int64.Type}}, "en-US")
					in
					    Typed


	/// Effects on door-to-doctor time from the OLS model on log waiting time (03_analytics/ed_wait_drivers.py); disconnected.
	table 'ED Wait Drivers'

		/// Explanatory variable of the waiting-time model.
		column Driver
			dataType: string
			summarizeBy: none
			sourceColumn: driver

		column 'Effect %'
			dataType: double
			isHidden
			summarizeBy: average
			sourceColumn: effect_pct

		column 'CI Low %'
			dataType: double
			isHidden
			summarizeBy: average
			sourceColumn: ci_low

		column 'CI High %'
			dataType: double
			isHidden
			summarizeBy: average
			sourceColumn: ci_high

		/// Two-sided p-value with HC3 robust standard errors.
		column 'P Value'
			dataType: double
			formatString: 0.000
			summarizeBy: none
			sourceColumn: p_value

		/// Model specification.
		column Model
			dataType: string
			summarizeBy: none
			sourceColumn: model

		partition 'ED Wait Drivers' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("analytics_ed_drivers.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "analytics_ed_drivers"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"driver", type text}, {"effect_pct", type number}, {"ci_low", type number}, {"ci_high", type number}, {"p_value", type number}, {"model", type text}}, "en-US")
					in
					    Typed


	/// Junk dimension: department x arrival mode x disposition.
	table 'Encounter Profile'

		/// Surrogate key. Source: generated (Cartesian product)
		column 'Encounter Profile Key'
			dataType: int64
			isHidden
			summarizeBy: none
