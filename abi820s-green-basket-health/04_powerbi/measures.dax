// measures.dax - GBHS semantic model measures (generated by build_pbip.py)
// Paste into DAX query view / Tabular Editor, or read alongside report section 3.4.

// [0 Targets & Labels] KPI target: at least 80 % of triaged ED patients seen within their SATS target.
MEASURE '_Measures'[Target Seen Within Target %] =
    IF ( NOT ISBLANK ( [Seen Within Target %] ), 0.8 )

// [0 Targets & Labels] KPI ceiling: no more than 3 % of ED patients leave without being seen.
MEASURE '_Measures'[Target LWBS Rate %] =
    IF ( NOT ISBLANK ( [LWBS Rate %] ), 0.03 )

// [0 Targets & Labels] KPI ceiling: 85 % average bed occupancy (safe-occupancy threshold).
MEASURE '_Measures'[Target Bed Occupancy %] =
    IF ( NOT ISBLANK ( [Bed Occupancy %] ), 0.85 )

// [0 Targets & Labels] KPI ceiling: 12 % emergency readmissions within 30 days.
MEASURE '_Measures'[Target Readmission Rate 30d %] =
    IF ( NOT ISBLANK ( [Readmission Rate 30d %] ), 0.12 )

// [0 Targets & Labels] KPI target: 80 % completeness and 80 % timeliness of weekly IDSR reports (WHO AFRO IDSR).
MEASURE '_Measures'[Target IDSR Reporting %] =
    IF ( NOT ISBLANK ( [IDSR Completeness %] ), 0.8 )

// [0 Targets & Labels] Text status with symbol (never colour alone) for the seen-within-target KPI.
MEASURE '_Measures'[ED Target Status] =
    VAR _v = [Seen Within Target %]
    RETURN
        IF ( NOT ISBLANK ( _v ), IF ( _v >= 0.8, "▲ On target (80 %)", "▼ Below target (80 %)" ) )

// [0 Targets & Labels] Text status with symbol for bed occupancy against the 85 % ceiling.
MEASURE '_Measures'[Occupancy Status] =
    VAR _v = [Bed Occupancy %]
    RETURN
        IF ( NOT ISBLANK ( _v ), IF ( _v <= 0.85, "● Within 85 % ceiling", "▲ Above 85 % ceiling" ) )

// [0 Targets & Labels] Freshness label for page headers (patient-flow data).
MEASURE '_Measures'[Data As Of] =
    "Data to " & FORMAT ( [Last Data Date], "d mmm yyyy" )

// [0 Targets & Labels] Freshness label for the surveillance page (last epi week with IDSR returns).
MEASURE '_Measures'[Surveillance As Of] =
    VAR _d = [Last Epi Week Start]
    RETURN
        "IDSR returns to epi week " & CALCULATE ( SELECTEDVALUE ( 'Date'[Epi Week Label] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] = _d )

// [0 Targets & Labels] Dynamic title of the drill-through page.
MEASURE '_Measures'[Facility Detail Title] =
    SELECTEDVALUE ( 'Facility'[Facility], "All facilities" ) & " - facility detail"

// [1 Patient Flow] All ED and clinic attendances (one row per attendance).
MEASURE '_Measures'[Attendances] =
    SUM ( 'Attendance'[Encounter Count] )

// [1 Patient Flow] Emergency-department attendances (CALCULATE with filter modification on the department).
MEASURE '_Measures'[ED Attendances] =
    CALCULATE ( [Attendances], KEEPFILTERS ( 'Encounter Profile'[Department Code] = "ED" ) )

// [1 Patient Flow] Outpatient-clinic attendances.
MEASURE '_Measures'[Clinic Attendances] =
    CALCULATE ( [Attendances], KEEPFILTERS ( 'Encounter Profile'[Department Code] = "OPD" ) )

// [1 Patient Flow] Share of triaged ED patients seen by a doctor within the SATS compliance time of their category (RED 5, ORANGE 10, YELLOW 60, GREEN 240 minutes).
MEASURE '_Measures'[Seen Within Target %] =
    DIVIDE ( SUM ( 'Attendance'[Seen Within Target] ), COUNT ( 'Attendance'[Seen Within Target] ) )

// [1 Patient Flow] Median minutes from ED arrival to first doctor assessment (patients seen).
MEASURE '_Measures'[Median Door-to-Doctor (min)] =
    CALCULATE ( MEDIAN ( 'Attendance'[Door to Doctor (min)] ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = "ED" ) )

// [1 Patient Flow] 90th percentile of ED door-to-doctor minutes (the long tail that drives complaints and LWBS).
MEASURE '_Measures'[P90 Door-to-Doctor (min)] =
    CALCULATE ( PERCENTILE.INC ( 'Attendance'[Door to Doctor (min)], 0.9 ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = "ED" ) )

// [1 Patient Flow] Median minutes from ED arrival to triage.
MEASURE '_Measures'[Median Wait to Triage (min)] =
    CALCULATE ( MEDIAN ( 'Attendance'[Wait to Triage (min)] ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = "ED" ) )

// [1 Patient Flow] Share of ED attendances that left without being seen.
MEASURE '_Measures'[LWBS Rate %] =
    CALCULATE ( DIVIDE ( SUM ( 'Attendance'[Is LWBS] ), SUM ( 'Attendance'[Encounter Count] ) ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = "ED" ) )

// [1 Patient Flow] Share of ED attendances admitted to a ward (conversion rate).
MEASURE '_Measures'[ED Admission Rate %] =
    CALCULATE ( DIVIDE ( SUM ( 'Attendance'[Is Admitted] ), SUM ( 'Attendance'[Encounter Count] ) ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = "ED" ) )

// [1 Patient Flow] Share of ED attendances with a valid length of stay that left the department within 4 hours.
MEASURE '_Measures'[ED Stays Within 4 Hours %] =
    VAR _within =
        CALCULATE (
            COUNTROWS ( 'Attendance' ),
            KEEPFILTERS ( NOT ISBLANK ( 'Attendance'[ED Length of Stay (min)] ) && 'Attendance'[ED Length of Stay (min)] <= 240 ),
            KEEPFILTERS ( 'Encounter Profile'[Department Code] = "ED" )
        )
    VAR _known =
        CALCULATE ( COUNT ( 'Attendance'[ED Length of Stay (min)] ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = "ED" ) )
    RETURN
        DIVIDE ( _within, _known )

// [1 Patient Flow] Identified patients with an attendance (durable key, stable across SCD2 versions; unidentified attendances excluded).
MEASURE '_Measures'[Distinct Patients] =
    CALCULATE ( DISTINCTCOUNT ( 'Attendance'[Patient Durable Key] ), KEEPFILTERS ( 'Attendance'[Patient Durable Key] > 0 ) )

// [1 Patient Flow] Identified attendances per distinct patient (frequent-attender signal).
MEASURE '_Measures'[Attendances per Patient] =
    DIVIDE ( CALCULATE ( [Attendances], KEEPFILTERS ( 'Attendance'[Patient Durable Key] > 0 ) ), [Distinct Patients] )

// [2 Inpatient Care] Inpatient spells by admission date.
MEASURE '_Measures'[Admissions] =
    SUM ( 'Admission'[Admission Count] )

// [2 Inpatient Care] Share of admissions that were unplanned (via ED, direct or transfer in).
MEASURE '_Measures'[Emergency Admission %] =
    DIVIDE ( CALCULATE ( [Admissions], KEEPFILTERS ( 'Admission Profile'[Is Emergency Admission] = TRUE () ) ), [Admissions] )

// [2 Inpatient Care] Identified patients admitted (durable key).
MEASURE '_Measures'[Distinct Inpatients] =
    CALCULATE ( DISTINCTCOUNT ( 'Admission'[Patient Durable Key] ), KEEPFILTERS ( 'Admission'[Patient Durable Key] > 0 ) )

// [2 Inpatient Care] Spells discharged, by DISCHARGE date (activates the inactive role-playing relationship).
MEASURE '_Measures'[Discharges] =
    CALCULATE ( SUM ( 'Admission'[Is Discharged] ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ) )

// [2 Inpatient Care] Average length of stay (midnights) of spells discharged in the period.
MEASURE '_Measures'[ALOS (days)] =
    CALCULATE ( AVERAGE ( 'Admission'[LOS (days)] ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ), KEEPFILTERS ( 'Admission'[Is Discharged] = 1 ) )

// [2 Inpatient Care] Deaths in hospital as a share of discharges (by discharge date).
MEASURE '_Measures'[In-Hospital Mortality %] =
    CALCULATE ( DIVIDE ( SUM ( 'Admission'[Is Died] ), SUM ( 'Admission'[Is Discharged] ) ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ) )

// [2 Inpatient Care] Eligible spells (alive home/AMA, not maternity, 30 days follow-up) followed by an emergency readmission within 30 days, by discharge date of the index spell.
MEASURE '_Measures'[Readmission Rate 30d %] =
    CALCULATE ( DIVIDE ( SUM ( 'Admission'[Readmitted Within 30d] ), SUM ( 'Admission'[Readmission Eligible] ) ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ) )

// [2 Inpatient Care] Share of discharges completed before 12:00 (patient-flow KPI: frees beds for the afternoon ED peak).
MEASURE '_Measures'[Discharged Before Noon %] =
    CALCULATE ( AVERAGE ( 'Admission'[Discharged Before Noon] ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ), KEEPFILTERS ( 'Admission'[Is Discharged] = 1 ) )

// [2 Inpatient Care] Share of discharges on Saturday or Sunday.
MEASURE '_Measures'[Weekend Discharge %] =
    CALCULATE ( AVERAGE ( 'Admission'[Is Weekend Discharge] ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ), KEEPFILTERS ( 'Admission'[Is Discharged] = 1 ) )

// [2 Inpatient Care] Spells admitted in the period and not yet discharged at the extract.
MEASURE '_Measures'[Open Spells] =
    CALCULATE ( [Admissions], KEEPFILTERS ( 'Admission'[Is Discharged] = 0 ) )

// [3 Resource Utilisation] Occupied bed-days: midnight census summed over days.
MEASURE '_Measures'[Patient Days] =
    SUM ( 'Ward Census'[Occupied Beds] )

// [3 Resource Utilisation] Open beds summed over days (complement minus closed beds).
MEASURE '_Measures'[Available Bed Days] =
    SUM ( 'Ward Census'[Beds Available] )

// [3 Resource Utilisation] Patient days / available bed days.
MEASURE '_Measures'[Bed Occupancy %] =
    DIVIDE ( [Patient Days], [Available Bed Days] )

// [3 Resource Utilisation] Average number of occupied beds per day (semi-additive: summed over wards, averaged over days).
MEASURE '_Measures'[Average Daily Census] =
    AVERAGEX ( VALUES ( 'Date'[Date] ), CALCULATE ( SUM ( 'Ward Census'[Occupied Beds] ) ) )

// [3 Resource Utilisation] Occupied beds on the last census date in the period, across the selected wards (semi-additive closing balance).
MEASURE '_Measures'[Occupied Beds (Latest Day)] =
    VAR _d =
        CALCULATE (
            MAX ( 'Ward Census'[Census Date Key] ),
            REMOVEFILTERS ( 'Care Unit' ), REMOVEFILTERS ( 'Facility' ), REMOVEFILTERS ( 'Region' )
        )
    RETURN
        CALCULATE ( SUM ( 'Ward Census'[Occupied Beds] ), 'Ward Census'[Census Date Key] = _d )

// [3 Resource Utilisation] Open beds on the last census date in the period.
MEASURE '_Measures'[Beds Available (Latest Day)] =
    VAR _d =
        CALCULATE (
            MAX ( 'Ward Census'[Census Date Key] ),
            REMOVEFILTERS ( 'Care Unit' ), REMOVEFILTERS ( 'Facility' ), REMOVEFILTERS ( 'Region' )
        )
    RETURN
        CALCULATE ( SUM ( 'Ward Census'[Beds Available] ), 'Ward Census'[Census Date Key] = _d )

// [3 Resource Utilisation] Occupancy on the last census date in the period.
MEASURE '_Measures'[Bed Occupancy % (Latest Day)] =
    DIVIDE ( [Occupied Beds (Latest Day)], [Beds Available (Latest Day)] )

// [3 Resource Utilisation] Nursing hours worked (registered + enrolled).
MEASURE '_Measures'[Nurse Hours] =
    SUM ( 'Staff Roster'[Nurse Hours] )

// [3 Resource Utilisation] Nursing hours per patient day on inpatient wards (drill-across: e-roster x ward census through Date and Care Unit).
MEASURE '_Measures'[NHPPD] =
    DIVIDE ( CALCULATE ( [Nurse Hours], KEEPFILTERS ( 'Care Unit'[Unit Type] = "Inpatient ward" ) ), [Patient Days] )

// [3 Resource Utilisation] Overtime nursing hours as a share of nursing hours worked.
MEASURE '_Measures'[Overtime %] =
    DIVIDE ( SUM ( 'Staff Roster'[Overtime Hours] ), [Nurse Hours] )

// [3 Resource Utilisation] Agency nursing hours as a share of nursing hours worked.
MEASURE '_Measures'[Agency %] =
    DIVIDE ( SUM ( 'Staff Roster'[Agency Hours] ), [Nurse Hours] )

// [3 Resource Utilisation] Nursing hours worked as a share of the approved roster.
MEASURE '_Measures'[Roster Fill %] =
    DIVIDE ( [Nurse Hours], SUM ( 'Staff Roster'[Planned Nurse Hours] ) )

// [3 Resource Utilisation] Rostered hours lost to sick leave.
MEASURE '_Measures'[Sick Leave %] =
    DIVIDE ( SUM ( 'Staff Roster'[Sick Leave Hours] ), SUM ( 'Staff Roster'[Planned Nurse Hours] ) )

// [3 Resource Utilisation] Doctor-shifts worked in the emergency departments.
MEASURE '_Measures'[ED Doctor Shifts] =
    CALCULATE ( SUM ( 'Staff Roster'[Doctors on Duty] ), KEEPFILTERS ( 'Care Unit'[Unit Type] = "Emergency department" ) )

// [3 Resource Utilisation] ED attendances per doctor-shift (drill-across: attendances x e-roster) - the strongest driver of waiting time.
MEASURE '_Measures'[ED Arrivals per Doctor Shift] =
    DIVIDE ( [ED Attendances], [ED Doctor Shifts] )

// [4 Disease Surveillance] Cases reported in the weekly IDSR returns.
MEASURE '_Measures'[Notified Cases] =
    SUM ( 'Surveillance'[Cases Total] )

// [4 Disease Surveillance] Deaths reported in the weekly IDSR returns.
MEASURE '_Measures'[Notified Deaths] =
    SUM ( 'Surveillance'[Deaths Total] )

// [4 Disease Surveillance] Notified deaths / notified cases.
MEASURE '_Measures'[Case Fatality Rate %] =
    DIVIDE ( [Notified Deaths], [Notified Cases] )

// [4 Disease Surveillance] Share of notified cases in children under five.
MEASURE '_Measures'[Under-5 Share of Cases %] =
    DIVIDE ( SUM ( 'Surveillance'[Cases Under 5] ), [Notified Cases] )

// [4 Disease Surveillance] Confirmed malaria cases notified (IDSR condition MAL).
MEASURE '_Measures'[Malaria Cases] =
    CALCULATE ( [Notified Cases], KEEPFILTERS ( 'Condition'[Condition Code] = "MAL" ) )

// [4 Disease Surveillance] Malaria deaths notified.
MEASURE '_Measures'[Malaria Deaths] =
    CALCULATE ( [Notified Deaths], KEEPFILTERS ( 'Condition'[Condition Code] = "MAL" ) )

// [4 Disease Surveillance] Positive malaria tests (RDT/microscopy) / tests done.
MEASURE '_Measures'[Malaria Test Positivity %] =
    DIVIDE ( SUM ( 'Surveillance'[Tests Positive] ), SUM ( 'Surveillance'[Tests Done] ) )

// [4 Disease Surveillance] Person-time at risk in the period: catchment population of each epi year x days of that year in context / 365, within the surveillance window.
MEASURE '_Measures'[Catchment Person-Years] =
    VAR _first = [First Surveillance Date]
    VAR _last = [Last Epi Week Start] + 6
    RETURN
        SUMX (
            VALUES ( 'Date'[Epi Year] ),
            VAR _y = 'Date'[Epi Year]
            VAR _days =
                CALCULATE ( COUNTROWS ( 'Date' ), KEEPFILTERS ( 'Date'[Date] >= _first && 'Date'[Date] <= _last ) )
            VAR _pop =
                CALCULATE (
                    SUM ( 'Catchment Population'[Catchment Population] ),
                    REMOVEFILTERS ( 'Date' ),
                    'Date'[Calendar Year] = _y
                )
            RETURN
                DIVIDE ( _pop * _days, 365 )
        )

// [4 Disease Surveillance] Average catchment population over the period (NSA regional population x facility catchment share; time-weighted across epi years).
MEASURE '_Measures'[Catchment Population] =
    VAR _first = [First Surveillance Date]
    VAR _last = [Last Epi Week Start] + 6
    VAR _days =
        CALCULATE ( COUNTROWS ( 'Date' ), KEEPFILTERS ( 'Date'[Date] >= _first && 'Date'[Date] <= _last ) )
    RETURN
        DIVIDE ( [Catchment Person-Years] * 365, _days )

// [4 Disease Surveillance] Malaria cases per 100 000 catchment population in the selected period (period incidence; equals the OLAP pivot by epi year).
MEASURE '_Measures'[Malaria Incidence per 100k] =
    DIVIDE ( [Malaria Cases] * 100000, [Catchment Population] )

// [4 Disease Surveillance] Annualised malaria incidence: cases per 1 000 person-years at risk (comparable across periods of different length).
MEASURE '_Measures'[Malaria Incidence per 1,000 PY] =
    DIVIDE ( [Malaria Cases] * 1000, [Catchment Person-Years] )

// [4 Disease Surveillance] NSA 2023 census count for the selected regions (all regions = 3 022 401).
MEASURE '_Measures'[Census Population 2023] =
    CALCULATE ( SUM ( 'Regional Population'[Population] ), REMOVEFILTERS ( 'Date' ), KEEPFILTERS ( 'Regional Population'[Is Census Count] = TRUE () ) )

// [4 Disease Surveillance] Small-cell suppression for external sharing: counts of 1-4 are blanked to prevent re-identification.
MEASURE '_Measures'[Notified Cases (Suppressed)] =
    VAR _c = [Notified Cases]
    RETURN
        IF ( _c >= 1 && _c <= 4, BLANK (), _c )

// [4 Disease Surveillance] Suppressed count as text: "<5" for 1-4 cases.
MEASURE '_Measures'[Notified Cases Label] =
    VAR _c = [Notified Cases]
    RETURN
        IF ( NOT ISBLANK ( _c ), IF ( _c >= 1 && _c <= 4, "<5", FORMAT ( _c, "#,0" ) ) )

// [4 Disease Surveillance] Weekly reports due (facility x epi week).
MEASURE '_Measures'[IDSR Reports Expected] =
    SUM ( 'IDSR Report'[Report Expected] )

// [4 Disease Surveillance] Reports received / reports expected.
MEASURE '_Measures'[IDSR Completeness %] =
    DIVIDE ( SUM ( 'IDSR Report'[Report Received] ), [IDSR Reports Expected] )

// [4 Disease Surveillance] Reports received by Tuesday 12:00 after the epi week / reports expected.
MEASURE '_Measures'[IDSR Timeliness %] =
    DIVIDE ( SUM ( 'IDSR Report'[Report On Time] ), [IDSR Reports Expected] )

// [4 Disease Surveillance] Rainfall total per location, averaged across the selected facility locations.
MEASURE '_Measures'[Rainfall (mm)] =
    AVERAGEX ( VALUES ( 'Facility'[Facility Code] ), CALCULATE ( SUM ( 'Weather'[Rainfall (mm)] ) ) )

// [4 Disease Surveillance] Rainfall in the 28 days ending 4 weeks before the period starts (the lag used by the SARIMAX malaria model).
MEASURE '_Measures'[Rainfall 4-8 Weeks Earlier (mm)] =
    VAR _start = MIN ( 'Date'[Date] )
    RETURN
        IF (
            _start >= [First Surveillance Date] && _start <= [Last Epi Week Start] + 6,
            CALCULATE ( [Rainfall (mm)], DATESINPERIOD ( 'Date'[Date], _start - 29, -28, DAY ) )
        )

// [4 Disease Surveillance] Mean daily maximum temperature.
MEASURE '_Measures'[Avg Max Temperature (C)] =
    AVERAGE ( 'Weather'[Max Temp (C)] )

// [5 Time Intelligence] Latest attendance date in the model (ignores all filters except RLS).
MEASURE '_Measures'[Last Data Date] =
    VAR _k =
        CALCULATE ( MAX ( 'Attendance'[Arrival Date Key] ), REMOVEFILTERS () )
    RETURN
        IF ( NOT ISBLANK ( _k ), DATE ( INT ( _k / 10000 ), MOD ( INT ( _k / 100 ), 100 ), MOD ( _k, 100 ) ) )

// [5 Time Intelligence] Monday of the first epi week with IDSR returns.
MEASURE '_Measures'[First Surveillance Date] =
    VAR _k =
        CALCULATE ( MIN ( 'Surveillance'[Epi Week Date Key] ), REMOVEFILTERS () )
    RETURN
        IF ( NOT ISBLANK ( _k ), DATE ( INT ( _k / 10000 ), MOD ( INT ( _k / 100 ), 100 ), MOD ( _k, 100 ) ) )

// [5 Time Intelligence] Monday of the latest epi week with IDSR returns.
MEASURE '_Measures'[Last Epi Week Start] =
    VAR _k =
        CALCULATE ( MAX ( 'Surveillance'[Epi Week Date Key] ), REMOVEFILTERS () )
    RETURN
        IF ( NOT ISBLANK ( _k ), DATE ( INT ( _k / 10000 ), MOD ( INT ( _k / 100 ), 100 ), MOD ( _k, 100 ) ) )

// [5 Time Intelligence] Calendar year-to-date ED attendances, no future guard (helper).
MEASURE '_Measures'[ED Attendances YTD Raw] =
    TOTALYTD ( [ED Attendances], 'Date'[Date] )

// [5 Time Intelligence] Year-to-date ED attendances; blank for periods after the last data date.
MEASURE '_Measures'[ED Attendances YTD] =
    IF ( MIN ( 'Date'[Date] ) <= [Last Data Date], [ED Attendances YTD Raw] )

// [5 Time Intelligence] Same year-to-date window one year earlier, cut at the same day (like-for-like).
MEASURE '_Measures'[ED Attendances YTD PY] =
    VAR _cutoffPY =
        EDATE ( [Last Data Date], -12 )
    RETURN
        CALCULATE (
            [ED Attendances YTD Raw],
            SAMEPERIODLASTYEAR ( 'Date'[Date] ),
            KEEPFILTERS ( 'Date'[Date] <= _cutoffPY )
        )

// [5 Time Intelligence] Year-to-date growth versus the like-for-like prior-year window.
MEASURE '_Measures'[ED Attendances YTD YoY %] =
    DIVIDE ( [ED Attendances YTD] - [ED Attendances YTD PY], [ED Attendances YTD PY] )

// [5 Time Intelligence] Seen-within-target share in the same period last year.
MEASURE '_Measures'[Seen Within Target % PY] =
    IF ( MIN ( 'Date'[Date] ) <= [Last Data Date], CALCULATE ( [Seen Within Target %], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )

// [5 Time Intelligence] Change versus the same period last year, in percentage points.
MEASURE '_Measures'[Seen Within Target Change (pp)] =
    VAR _cur = [Seen Within Target %]
    VAR _py = [Seen Within Target % PY]
    RETURN
        IF ( NOT ISBLANK ( _cur ) && NOT ISBLANK ( _py ), ( _cur - _py ) * 100 )

// [5 Time Intelligence] Occupancy over the trailing 12 months ending at the context end (capped at the last data date).
MEASURE '_Measures'[Bed Occupancy % Rolling 12M] =
    VAR _last = [Last Data Date]
    VAR _end =
        MIN ( MAX ( 'Date'[Date] ), _last )
    RETURN
        IF (
            MIN ( 'Date'[Date] ) <= _last,
            CALCULATE ( [Bed Occupancy %], DATESINPERIOD ( 'Date'[Date], _end, -12, MONTH ) )
        )

// [5 Time Intelligence] Malaria cases from epi week 1 of the epi year to the end of the context (capped at the last reported week).
MEASURE '_Measures'[Malaria Cases Epi-YTD] =
    VAR _end =
        MIN ( MAX ( 'Date'[Date] ), [Last Epi Week Start] + 6 )
    VAR _y =
        CALCULATE ( MAX ( 'Date'[Epi Year] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] = _end )
    RETURN
        IF (
            MIN ( 'Date'[Date] ) <= _end,
            CALCULATE ( [Malaria Cases], REMOVEFILTERS ( 'Date' ), 'Date'[Epi Year] = _y, 'Date'[Date] <= _end )
        )

// [5 Time Intelligence] Same number of epi weeks one epi year earlier (like-for-like).
MEASURE '_Measures'[Malaria Cases Epi-YTD PY] =
    VAR _end =
        MIN ( MAX ( 'Date'[Date] ), [Last Epi Week Start] + 6 )
    VAR _y =
        CALCULATE ( MAX ( 'Date'[Epi Year] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] = _end )
    VAR _endPY = _end - 364
    RETURN
        IF (
            MIN ( 'Date'[Date] ) <= _end,
            CALCULATE ( [Malaria Cases], REMOVEFILTERS ( 'Date' ), 'Date'[Epi Year] = _y - 1, 'Date'[Date] <= _endPY )
        )

// [5 Time Intelligence] Epi-year-to-date growth versus the like-for-like prior-year window.
MEASURE '_Measures'[Malaria Cases Epi-YTD YoY %] =
    DIVIDE ( [Malaria Cases Epi-YTD] - [Malaria Cases Epi-YTD PY], [Malaria Cases Epi-YTD PY] )

// [5 Time Intelligence] Malaria cases 52 weeks (364 days) earlier: the same epi week of the previous year.
MEASURE '_Measures'[Malaria Cases Same Week Last Year] =
    IF (
        MIN ( 'Date'[Date] ) <= [Last Epi Week Start] + 6,
        CALCULATE ( [Malaria Cases], DATEADD ( 'Date'[Date], -364, DAY ) )
    )

// [5 Time Intelligence] Average weekly malaria cases over the four epi weeks ending at the context end.
MEASURE '_Measures'[Malaria Cases 4-Week Average] =
    VAR _end =
        MIN ( MAX ( 'Date'[Date] ), [Last Epi Week Start] + 6 )
    RETURN
        DIVIDE ( CALCULATE ( [Malaria Cases], DATESINPERIOD ( 'Date'[Date], _end, -28, DAY ) ), 4 )

// [6 Advanced Analytics] 13-week forward forecast of North-East malaria cases (Holt-Winters ETS on log cases).
MEASURE '_Measures'[Forecast Cases] =
    CALCULATE ( SUM ( 'Malaria Forecast'[Forecast] ), KEEPFILTERS ( 'Malaria Forecast'[Series] = "Forecast" ) )

// [6 Advanced Analytics] Lower bound of the 80 % prediction interval.
MEASURE '_Measures'[Forecast Lower 80] =
    CALCULATE ( SUM ( 'Malaria Forecast'[Lower 80] ), KEEPFILTERS ( 'Malaria Forecast'[Series] = "Forecast" ) )

// [6 Advanced Analytics] Upper bound of the 80 % prediction interval.
MEASURE '_Measures'[Forecast Upper 80] =
    CALCULATE ( SUM ( 'Malaria Forecast'[Upper 80] ), KEEPFILTERS ( 'Malaria Forecast'[Series] = "Forecast" ) )

// [6 Advanced Analytics] Weekly North-East malaria cases the model was trained and tested on (PAS-coded attendances).
MEASURE '_Measures'[Model Actual Cases] =
    CALCULATE ( SUM ( 'Malaria Forecast'[Actual] ), KEEPFILTERS ( 'Malaria Forecast'[Series] = "Actual" ) )

// [6 Advanced Analytics] One-week-ahead forecasts made at each rolling origin of the back-test.
MEASURE '_Measures'[Backtest Forecast] =
    CALCULATE ( SUM ( 'Malaria Forecast'[Forecast] ), KEEPFILTERS ( 'Malaria Forecast'[Series] = "Back-test (1 week ahead)" ) )

// [6 Advanced Analytics] Weighted absolute percentage error of the one-week-ahead back-test forecasts.
MEASURE '_Measures'[Backtest WAPE % (1 Week Ahead)] =
    VAR _rows =
        FILTER ( 'Malaria Forecast', 'Malaria Forecast'[Series] = "Back-test (1 week ahead)" )
    RETURN
        DIVIDE (
            SUMX ( _rows, ABS ( 'Malaria Forecast'[Actual] - 'Malaria Forecast'[Forecast] ) ),
            SUMX ( _rows, ABS ( 'Malaria Forecast'[Actual] ) )
        )

// [6 Advanced Analytics] Observed 30-day readmission rate in the test set (spell-weighted).
MEASURE '_Measures'[Readmission Observed %] =
    DIVIDE ( SUMX ( 'Readmission Deciles', 'Readmission Deciles'[Observed Rate] * 'Readmission Deciles'[Spells] ), SUM ( 'Readmission Deciles'[Spells] ) )

// [6 Advanced Analytics] Mean predicted readmission probability (spell-weighted) - compare with observed for calibration.
MEASURE '_Measures'[Readmission Predicted %] =
    DIVIDE (
        SUMX ( 'Readmission Deciles', 'Readmission Deciles'[Mean Predicted] * 'Readmission Deciles'[Spells] ),
        SUM ( 'Readmission Deciles'[Spells] )
    )

// [6 Advanced Analytics] Share of all readmissions that fall in the two highest risk deciles (who to call after discharge).
MEASURE '_Measures'[Top-20% Risk Capture %] =
    VAR _all = SUMX ( 'Readmission Deciles', 'Readmission Deciles'[Observed Rate] * 'Readmission Deciles'[Spells] )
    VAR _top =
        CALCULATE ( SUMX ( 'Readmission Deciles', 'Readmission Deciles'[Observed Rate] * 'Readmission Deciles'[Spells] ), KEEPFILTERS ( 'Readmission Deciles'[Risk Decile] >= 9 ) )
    RETURN
        DIVIDE ( _top, _all )

// [6 Advanced Analytics] Odds ratio of a readmission driver (logistic regression, reference coding).
MEASURE '_Measures'[Odds Ratio] =
    AVERAGE ( 'Readmission Drivers'[Odds Ratio Value] )

// [6 Advanced Analytics] % change in door-to-doctor time associated with the driver (OLS on log waiting time).
MEASURE '_Measures'[Wait Effect %] =
    DIVIDE ( AVERAGE ( 'ED Wait Drivers'[Effect %] ), 100 )

// [6 Advanced Analytics] Wait effect of the drivers management can act on (case-mix controls such as triage category excluded).
MEASURE '_Measures'[Wait Effect % (Operational)] =
    CALCULATE ( [Wait Effect %], KEEPFILTERS ( LEFT ( 'ED Wait Drivers'[Driver], 6 ) <> "Triage" ) )

// [6 Advanced Analytics] Lower 95 % confidence limit of the effect.
MEASURE '_Measures'[Wait Effect Lower 95%] =
    DIVIDE ( AVERAGE ( 'ED Wait Drivers'[CI Low %] ), 100 )

// [6 Advanced Analytics] Upper 95 % confidence limit of the effect.
MEASURE '_Measures'[Wait Effect Upper 95%] =
    DIVIDE ( AVERAGE ( 'ED Wait Drivers'[CI High %] ), 100 )

// [6 Advanced Analytics] Facility-condition-weeks flagged by the selected detection method(s).
MEASURE '_Measures'[Outbreak Alerts] =
    COUNTROWS ( 'Outbreak Alerts' )

// [6 Advanced Analytics] Share of alerts that fall in weeks of a known (injected) outbreak - a positive-predictive-value proxy.
MEASURE '_Measures'[Alerts in Known Outbreak Weeks %] =
    DIVIDE ( CALCULATE ( [Outbreak Alerts], KEEPFILTERS ( 'Outbreak Alerts'[Is Known Outbreak] = TRUE () ) ), [Outbreak Alerts] )

// [7 Data Quality & Security] Data-quality issues logged by the ETL rules (all batches).
MEASURE '_Measures'[DQ Issues Logged] =
    SUM ( 'DQ Summary'[Issues] )

// [7 Data Quality & Security] Rules that logged at least one issue.
MEASURE '_Measures'[DQ Rules Triggered] =
    CALCULATE ( COUNTROWS ( 'DQ Summary' ), KEEPFILTERS ( 'DQ Summary'[Issues] > 0 ) )

// [7 Data Quality & Security] Share of reconciliation checks of the latest batch with status PASS.
MEASURE '_Measures'[Reconciliation Pass %] =
    DIVIDE ( CALCULATE ( COUNTROWS ( 'Reconciliation' ), KEEPFILTERS ( 'Reconciliation'[Status] = "PASS" ) ), COUNTROWS ( 'Reconciliation' ) )

// [7 Data Quality & Security] Checks with status WARN (explained differences).
MEASURE '_Measures'[Reconciliation Warnings] =
    CALCULATE ( COUNTROWS ( 'Reconciliation' ), KEEPFILTERS ( 'Reconciliation'[Status] = "WARN" ) )

// [7 Data Quality & Security] Ward-days whose census was imputed from PAS spells (missing ward return, rule WC01).
MEASURE '_Measures'[Imputed Census Days %] =
    DIVIDE ( CALCULATE ( COUNTROWS ( 'Ward Census' ), KEEPFILTERS ( 'Ward Census'[Census Source] = "Imputed from PAS" ) ), COUNTROWS ( 'Ward Census' ) )

// [7 Data Quality & Security] Attendances without a valid ICD-10 code (rules EN07-EN08).
MEASURE '_Measures'[Uncoded Diagnosis %] =
    DIVIDE ( CALCULATE ( [Attendances], KEEPFILTERS ( 'Diagnosis'[ICD-10 Code] = "UNK" ) ), [Attendances] )

// [7 Data Quality & Security] Attendances without a patient identifier (rule EN11).
MEASURE '_Measures'[Unidentified Attendances] =
    CALCULATE ( [Attendances], KEEPFILTERS ( 'Attendance'[Patient Durable Key] < 0 ) )

// [7 Data Quality & Security] Spells still open more than 60 days after admission (probable missing discharge, rule AD06).
MEASURE '_Measures'[Open Spells Over 60 Days] =
    SUM ( 'Admission'[Is Open Over 60d] )

// [7 Data Quality & Security] Facilities visible to the current user (RLS test).
MEASURE '_Measures'[Visible Facilities] =
    CALCULATE ( DISTINCTCOUNT ( 'Facility'[Facility Code] ), KEEPFILTERS ( 'Facility'[Facility Key] > 0 ) )

// [7 Data Quality & Security] User principal name evaluated by row-level security.
MEASURE '_Measures'[Current User] =
    USERPRINCIPALNAME ()

// Security roles: row-level filters (RLS) and object-level security (OLS)
// Role 'Executive (all facilities)': Unrestricted read for the executive committee, the CEO and the BI team.
// Role 'Facility Manager (dynamic)': Dynamic RLS: users see the facilities mapped to their UPN in sec.user_facility_access (and every ward, attendance, spell, roster, census and surveillance row of those facilities). They can read only their own mapping rows.
//   RLS filter on 'Facility':
//     'Facility'[Facility Key]
//         IN CALCULATETABLE (
//             VALUES ( 'Security User Facility'[Facility Key] ),
//             'Security User Facility'[User Principal Name] = LOWER ( USERPRINCIPALNAME () )
//         )
//   RLS filter on 'Security User Facility':
//     'Security User Facility'[User Principal Name] = LOWER ( USERPRINCIPALNAME () )
// Role 'North-East Zone (static)': Static RLS: the North-East malaria task team sees Zambezi and the two Kavango regions only.
//   RLS filter on 'Region':
//     'Region'[Zone] = "North-East"
// Role 'Surveillance Partner (aggregate only)': Object-level security for the MoHSS surveillance unit: patient-level tables (attendances, spells, patients, model outputs on patients, the access list) are invisible - not just empty. Aggregated IDSR, population and weather data only.
//   OLS: table 'Attendance' is invisible to this role (metadataPermission = none)
//   OLS: table 'Admission' is invisible to this role (metadataPermission = none)
//   OLS: table 'Patient' is invisible to this role (metadataPermission = none)
//   OLS: table 'Readmission Deciles' is invisible to this role (metadataPermission = none)
//   OLS: table 'Readmission Drivers' is invisible to this role (metadataPermission = none)
//   OLS: table 'Security User Facility' is invisible to this role (metadataPermission = none)
