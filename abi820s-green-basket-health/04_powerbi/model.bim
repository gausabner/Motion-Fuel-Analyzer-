      {
        "name": "Attendance",
        "description": "ED and clinic attendances (transaction fact; grain: one row per attendance). Import with incremental refresh on Arrival Date Key.",
        "columns": [
          {
            "name": "Arrival Date Key",
            "dataType": "int64",
            "sourceColumn": "arrival_date_key",
            "isHidden": true,
            "description": "FK to dim_date (arrival date). Source: PAS arrival_datetime (EN02, EN12)",
            "summarizeBy": "none"
          },
          {
            "name": "Arrival Hour Key",
            "dataType": "int64",
            "sourceColumn": "arrival_hour_key",
            "isHidden": true,
            "description": "FK to dim_hour (arrival hour). Source: PAS arrival_datetime",
            "summarizeBy": "none"
          },
          {
            "name": "Care Unit Key",
            "dataType": "int64",
            "sourceColumn": "care_unit_key",
            "isHidden": true,
            "description": "FK to dim_care_unit version valid on the arrival date (ED or clinic unit). Source: PAS facility_code + department (EN03)",
            "summarizeBy": "none"
          },
          {
            "name": "Patient Key",
            "dataType": "int64",
            "sourceColumn": "patient_key",
