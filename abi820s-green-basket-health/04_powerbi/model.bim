{
  "name": "GBHS Health Services",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-GB",
    "sourceQueryCulture": "en-GB",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "_Measures",
        "description": "All business measures, organised in display folders.",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Measure Group",
            "dataType": "string",
            "isHidden": true,
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Measure Group]"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW ( \"Measure Group\", \"Measures\" )"
            }
          }
        ],
        "measures": [
          {
            "name": "Target Seen Within Target %",
            "expression": "IF ( NOT ISBLANK ( [Seen Within Target %] ), 0.8 )",
            "displayFolder": "0 Targets & Labels",
            "description": "KPI target: at least 80 % of triaged ED patients seen within their SATS target.",
            "formatString": "0.0%"
          },
          {
            "name": "Target LWBS Rate %",
            "expression": "IF ( NOT ISBLANK ( [LWBS Rate %] ), 0.03 )",
            "displayFolder": "0 Targets & Labels",
            "description": "KPI ceiling: no more than 3 % of ED patients leave without being seen.",
            "formatString": "0.0%"
          },
          {
            "name": "Target Bed Occupancy %",
            "expression": "IF ( NOT ISBLANK ( [Bed Occupancy %] ), 0.85 )",
            "displayFolder": "0 Targets & Labels",
            "description": "KPI ceiling: 85 % average bed occupancy (safe-occupancy threshold).",
            "formatString": "0.0%"
          },
          {
            "name": "Target Readmission Rate 30d %",
            "expression": "IF ( NOT ISBLANK ( [Readmission Rate 30d %] ), 0.12 )",
            "displayFolder": "0 Targets & Labels",
            "description": "KPI ceiling: 12 % emergency readmissions within 30 days.",
            "formatString": "0.0%"
          },
          {
            "name": "Target IDSR Reporting %",
            "expression": "IF ( NOT ISBLANK ( [IDSR Completeness %] ), 0.8 )",
            "displayFolder": "0 Targets & Labels",
            "description": "KPI target: 80 % completeness and 80 % timeliness of weekly IDSR reports (WHO AFRO IDSR).",
            "formatString": "0.0%"
          },
          {
            "name": "ED Target Status",
            "expression": "VAR _v = [Seen Within Target %]\nRETURN\n    IF ( NOT ISBLANK ( _v ), IF ( _v >= 0.8, \"▲ On target (80 %)\", \"▼ Below target (80 %)\" ) )",
            "displayFolder": "0 Targets & Labels",
            "description": "Text status with symbol (never colour alone) for the seen-within-target KPI."
          },
          {
            "name": "Occupancy Status",
            "expression": "VAR _v = [Bed Occupancy %]\nRETURN\n    IF ( NOT ISBLANK ( _v ), IF ( _v <= 0.85, \"● Within 85 % ceiling\", \"▲ Above 85 % ceiling\" ) )",
            "displayFolder": "0 Targets & Labels",
            "description": "Text status with symbol for bed occupancy against the 85 % ceiling."
          },
          {
            "name": "Data As Of",
            "expression": "\"Data to \" & FORMAT ( [Last Data Date], \"d mmm yyyy\" )",
            "displayFolder": "0 Targets & Labels",
            "description": "Freshness label for page headers (patient-flow data)."
          },
          {
            "name": "Surveillance As Of",
            "expression": "VAR _d = [Last Epi Week Start]\nRETURN\n    \"IDSR returns to epi week \" & CALCULATE ( SELECTEDVALUE ( 'Date'[Epi Week Label] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] = _d )",
            "displayFolder": "0 Targets & Labels",
            "description": "Freshness label for the surveillance page (last epi week with IDSR returns)."
          },
          {
            "name": "Facility Detail Title",
            "expression": "SELECTEDVALUE ( 'Facility'[Facility], \"All facilities\" ) & \" - facility detail\"",
            "displayFolder": "0 Targets & Labels",
            "description": "Dynamic title of the drill-through page."
          },
          {
            "name": "Attendances",
            "expression": "SUM ( 'Attendance'[Encounter Count] )",
            "displayFolder": "1 Patient Flow",
            "description": "All ED and clinic attendances (one row per attendance).",
            "formatString": "#,0"
          },
          {
            "name": "ED Attendances",
            "expression": "CALCULATE ( [Attendances], KEEPFILTERS ( 'Encounter Profile'[Department Code] = \"ED\" ) )",
            "displayFolder": "1 Patient Flow",
            "description": "Emergency-department attendances (CALCULATE with filter modification on the department).",
            "formatString": "#,0"
          },
          {
            "name": "Clinic Attendances",
            "expression": "CALCULATE ( [Attendances], KEEPFILTERS ( 'Encounter Profile'[Department Code] = \"OPD\" ) )",
            "displayFolder": "1 Patient Flow",
            "description": "Outpatient-clinic attendances.",
            "formatString": "#,0"
          },
          {
            "name": "Seen Within Target %",
            "expression": "DIVIDE ( SUM ( 'Attendance'[Seen Within Target] ), COUNT ( 'Attendance'[Seen Within Target] ) )",
            "displayFolder": "1 Patient Flow",
            "description": "Share of triaged ED patients seen by a doctor within the SATS compliance time of their category (RED 5, ORANGE 10, YELLOW 60, GREEN 240 minutes).",
            "formatString": "0.0%"
          },
          {
            "name": "Median Door-to-Doctor (min)",
            "expression": "CALCULATE ( MEDIAN ( 'Attendance'[Door to Doctor (min)] ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = \"ED\" ) )",
            "displayFolder": "1 Patient Flow",
            "description": "Median minutes from ED arrival to first doctor assessment (patients seen).",
            "formatString": "#,0"
          },
          {
            "name": "P90 Door-to-Doctor (min)",
            "expression": "CALCULATE ( PERCENTILE.INC ( 'Attendance'[Door to Doctor (min)], 0.9 ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = \"ED\" ) )",
            "displayFolder": "1 Patient Flow",
            "description": "90th percentile of ED door-to-doctor minutes (the long tail that drives complaints and LWBS).",
            "formatString": "#,0"
          },
          {
            "name": "Median Wait to Triage (min)",
            "expression": "CALCULATE ( MEDIAN ( 'Attendance'[Wait to Triage (min)] ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = \"ED\" ) )",
            "displayFolder": "1 Patient Flow",
            "description": "Median minutes from ED arrival to triage.",
            "formatString": "#,0"
          },
          {
            "name": "LWBS Rate %",
            "expression": "CALCULATE ( DIVIDE ( SUM ( 'Attendance'[Is LWBS] ), SUM ( 'Attendance'[Encounter Count] ) ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = \"ED\" ) )",
            "displayFolder": "1 Patient Flow",
            "description": "Share of ED attendances that left without being seen.",
            "formatString": "0.0%"
          },
          {
            "name": "ED Admission Rate %",
            "expression": "CALCULATE ( DIVIDE ( SUM ( 'Attendance'[Is Admitted] ), SUM ( 'Attendance'[Encounter Count] ) ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = \"ED\" ) )",
            "displayFolder": "1 Patient Flow",
            "description": "Share of ED attendances admitted to a ward (conversion rate).",
            "formatString": "0.0%"
          },
          {
            "name": "ED Stays Within 4 Hours %",
            "expression": "VAR _within =\n    CALCULATE (\n        COUNTROWS ( 'Attendance' ),\n        KEEPFILTERS ( NOT ISBLANK ( 'Attendance'[ED Length of Stay (min)] ) && 'Attendance'[ED Length of Stay (min)] <= 240 ),\n        KEEPFILTERS ( 'Encounter Profile'[Department Code] = \"ED\" )\n    )\nVAR _known =\n    CALCULATE ( COUNT ( 'Attendance'[ED Length of Stay (min)] ), KEEPFILTERS ( 'Encounter Profile'[Department Code] = \"ED\" ) )\nRETURN\n    DIVIDE ( _within, _known )",
            "displayFolder": "1 Patient Flow",
            "description": "Share of ED attendances with a valid length of stay that left the department within 4 hours.",
            "formatString": "0.0%"
          },
          {
            "name": "Distinct Patients",
            "expression": "CALCULATE ( DISTINCTCOUNT ( 'Attendance'[Patient Durable Key] ), KEEPFILTERS ( 'Attendance'[Patient Durable Key] > 0 ) )",
            "displayFolder": "1 Patient Flow",
            "description": "Identified patients with an attendance (durable key, stable across SCD2 versions; unidentified attendances excluded).",
            "formatString": "#,0"
          },
          {
            "name": "Attendances per Patient",
            "expression": "DIVIDE ( CALCULATE ( [Attendances], KEEPFILTERS ( 'Attendance'[Patient Durable Key] > 0 ) ), [Distinct Patients] )",
            "displayFolder": "1 Patient Flow",
            "description": "Identified attendances per distinct patient (frequent-attender signal).",
            "formatString": "#,0.00"
          },
          {
            "name": "Admissions",
            "expression": "SUM ( 'Admission'[Admission Count] )",
            "displayFolder": "2 Inpatient Care",
            "description": "Inpatient spells by admission date.",
            "formatString": "#,0"
          },
          {
            "name": "Emergency Admission %",
            "expression": "DIVIDE ( CALCULATE ( [Admissions], KEEPFILTERS ( 'Admission Profile'[Is Emergency Admission] = TRUE () ) ), [Admissions] )",
            "displayFolder": "2 Inpatient Care",
            "description": "Share of admissions that were unplanned (via ED, direct or transfer in).",
            "formatString": "0.0%"
          },
          {
            "name": "Distinct Inpatients",
            "expression": "CALCULATE ( DISTINCTCOUNT ( 'Admission'[Patient Durable Key] ), KEEPFILTERS ( 'Admission'[Patient Durable Key] > 0 ) )",
            "displayFolder": "2 Inpatient Care",
            "description": "Identified patients admitted (durable key).",
            "formatString": "#,0"
          },
          {
            "name": "Discharges",
            "expression": "CALCULATE ( SUM ( 'Admission'[Is Discharged] ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ) )",
            "displayFolder": "2 Inpatient Care",
            "description": "Spells discharged, by DISCHARGE date (activates the inactive role-playing relationship).",
            "formatString": "#,0"
          },
          {
            "name": "ALOS (days)",
            "expression": "CALCULATE ( AVERAGE ( 'Admission'[LOS (days)] ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ), KEEPFILTERS ( 'Admission'[Is Discharged] = 1 ) )",
            "displayFolder": "2 Inpatient Care",
            "description": "Average length of stay (midnights) of spells discharged in the period.",
            "formatString": "#,0.00"
          },
          {
            "name": "In-Hospital Mortality %",
            "expression": "CALCULATE ( DIVIDE ( SUM ( 'Admission'[Is Died] ), SUM ( 'Admission'[Is Discharged] ) ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ) )",
            "displayFolder": "2 Inpatient Care",
            "description": "Deaths in hospital as a share of discharges (by discharge date).",
            "formatString": "0.00%"
          },
          {
            "name": "Readmission Rate 30d %",
            "expression": "CALCULATE ( DIVIDE ( SUM ( 'Admission'[Readmitted Within 30d] ), SUM ( 'Admission'[Readmission Eligible] ) ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ) )",
            "displayFolder": "2 Inpatient Care",
            "description": "Eligible spells (alive home/AMA, not maternity, 30 days follow-up) followed by an emergency readmission within 30 days, by discharge date of the index spell.",
            "formatString": "0.0%"
          },
          {
            "name": "Discharged Before Noon %",
            "expression": "CALCULATE ( AVERAGE ( 'Admission'[Discharged Before Noon] ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ), KEEPFILTERS ( 'Admission'[Is Discharged] = 1 ) )",
            "displayFolder": "2 Inpatient Care",
            "description": "Share of discharges completed before 12:00 (patient-flow KPI: frees beds for the afternoon ED peak).",
            "formatString": "0.0%"
          },
          {
            "name": "Weekend Discharge %",
            "expression": "CALCULATE ( AVERAGE ( 'Admission'[Is Weekend Discharge] ), USERELATIONSHIP ( 'Admission'[Discharge Date Key], 'Date'[Date Key] ), KEEPFILTERS ( 'Admission'[Is Discharged] = 1 ) )",
            "displayFolder": "2 Inpatient Care",
            "description": "Share of discharges on Saturday or Sunday.",
            "formatString": "0.0%"
          },
          {
            "name": "Open Spells",
            "expression": "CALCULATE ( [Admissions], KEEPFILTERS ( 'Admission'[Is Discharged] = 0 ) )",
            "displayFolder": "2 Inpatient Care",
            "description": "Spells admitted in the period and not yet discharged at the extract.",
            "formatString": "#,0"
          },
          {
            "name": "Patient Days",
            "expression": "SUM ( 'Ward Census'[Occupied Beds] )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Occupied bed-days: midnight census summed over days.",
            "formatString": "#,0"
          },
          {
            "name": "Available Bed Days",
            "expression": "SUM ( 'Ward Census'[Beds Available] )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Open beds summed over days (complement minus closed beds).",
            "formatString": "#,0"
          },
          {
            "name": "Bed Occupancy %",
            "expression": "DIVIDE ( [Patient Days], [Available Bed Days] )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Patient days / available bed days.",
            "formatString": "0.0%"
          },
          {
            "name": "Average Daily Census",
            "expression": "AVERAGEX ( VALUES ( 'Date'[Date] ), CALCULATE ( SUM ( 'Ward Census'[Occupied Beds] ) ) )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Average number of occupied beds per day (semi-additive: summed over wards, averaged over days).",
            "formatString": "#,0.0"
          },
          {
            "name": "Occupied Beds (Latest Day)",
            "expression": "VAR _d =\n    CALCULATE (\n        MAX ( 'Ward Census'[Census Date Key] ),\n        REMOVEFILTERS ( 'Care Unit' ), REMOVEFILTERS ( 'Facility' ), REMOVEFILTERS ( 'Region' )\n    )\nRETURN\n    CALCULATE ( SUM ( 'Ward Census'[Occupied Beds] ), 'Ward Census'[Census Date Key] = _d )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Occupied beds on the last census date in the period, across the selected wards (semi-additive closing balance).",
            "formatString": "#,0"
          },
          {
            "name": "Beds Available (Latest Day)",
            "expression": "VAR _d =\n    CALCULATE (\n        MAX ( 'Ward Census'[Census Date Key] ),\n        REMOVEFILTERS ( 'Care Unit' ), REMOVEFILTERS ( 'Facility' ), REMOVEFILTERS ( 'Region' )\n    )\nRETURN\n    CALCULATE ( SUM ( 'Ward Census'[Beds Available] ), 'Ward Census'[Census Date Key] = _d )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Open beds on the last census date in the period.",
            "formatString": "#,0"
          },
          {
            "name": "Bed Occupancy % (Latest Day)",
            "expression": "DIVIDE ( [Occupied Beds (Latest Day)], [Beds Available (Latest Day)] )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Occupancy on the last census date in the period.",
            "formatString": "0.0%"
          },
          {
            "name": "Nurse Hours",
            "expression": "SUM ( 'Staff Roster'[Nurse Hours] )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Nursing hours worked (registered + enrolled).",
            "formatString": "#,0"
          },
          {
            "name": "NHPPD",
            "expression": "DIVIDE ( CALCULATE ( [Nurse Hours], KEEPFILTERS ( 'Care Unit'[Unit Type] = \"Inpatient ward\" ) ), [Patient Days] )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Nursing hours per patient day on inpatient wards (drill-across: e-roster x ward census through Date and Care Unit).",
            "formatString": "#,0.00"
          },
          {
            "name": "Overtime %",
            "expression": "DIVIDE ( SUM ( 'Staff Roster'[Overtime Hours] ), [Nurse Hours] )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Overtime nursing hours as a share of nursing hours worked.",
            "formatString": "0.0%"
          },
          {
            "name": "Agency %",
            "expression": "DIVIDE ( SUM ( 'Staff Roster'[Agency Hours] ), [Nurse Hours] )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Agency nursing hours as a share of nursing hours worked.",
            "formatString": "0.0%"
          },
          {
            "name": "Roster Fill %",
            "expression": "DIVIDE ( [Nurse Hours], SUM ( 'Staff Roster'[Planned Nurse Hours] ) )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Nursing hours worked as a share of the approved roster.",
            "formatString": "0.0%"
          },
          {
            "name": "Sick Leave %",
            "expression": "DIVIDE ( SUM ( 'Staff Roster'[Sick Leave Hours] ), SUM ( 'Staff Roster'[Planned Nurse Hours] ) )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Rostered hours lost to sick leave.",
            "formatString": "0.0%"
          },
          {
            "name": "ED Doctor Shifts",
            "expression": "CALCULATE ( SUM ( 'Staff Roster'[Doctors on Duty] ), KEEPFILTERS ( 'Care Unit'[Unit Type] = \"Emergency department\" ) )",
            "displayFolder": "3 Resource Utilisation",
            "description": "Doctor-shifts worked in the emergency departments.",
            "formatString": "#,0"
          },
          {
            "name": "ED Arrivals per Doctor Shift",
            "expression": "DIVIDE ( [ED Attendances], [ED Doctor Shifts] )",
            "displayFolder": "3 Resource Utilisation",
            "description": "ED attendances per doctor-shift (drill-across: attendances x e-roster) - the strongest driver of waiting time.",
            "formatString": "#,0.0"
          },
          {
            "name": "Notified Cases",
            "expression": "SUM ( 'Surveillance'[Cases Total] )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Cases reported in the weekly IDSR returns.",
            "formatString": "#,0"
          },
          {
            "name": "Notified Deaths",
            "expression": "SUM ( 'Surveillance'[Deaths Total] )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Deaths reported in the weekly IDSR returns.",
            "formatString": "#,0"
          },
          {
            "name": "Case Fatality Rate %",
            "expression": "DIVIDE ( [Notified Deaths], [Notified Cases] )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Notified deaths / notified cases.",
            "formatString": "0.00%"
          },
          {
            "name": "Under-5 Share of Cases %",
            "expression": "DIVIDE ( SUM ( 'Surveillance'[Cases Under 5] ), [Notified Cases] )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Share of notified cases in children under five.",
            "formatString": "0.0%"
          },
          {
            "name": "Malaria Cases",
            "expression": "CALCULATE ( [Notified Cases], KEEPFILTERS ( 'Condition'[Condition Code] = \"MAL\" ) )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Confirmed malaria cases notified (IDSR condition MAL).",
            "formatString": "#,0"
          },
          {
            "name": "Malaria Deaths",
            "expression": "CALCULATE ( [Notified Deaths], KEEPFILTERS ( 'Condition'[Condition Code] = \"MAL\" ) )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Malaria deaths notified.",
            "formatString": "#,0"
          },
          {
            "name": "Malaria Test Positivity %",
            "expression": "DIVIDE ( SUM ( 'Surveillance'[Tests Positive] ), SUM ( 'Surveillance'[Tests Done] ) )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Positive malaria tests (RDT/microscopy) / tests done.",
            "formatString": "0.0%"
          },
          {
            "name": "Catchment Person-Years",
            "expression": "VAR _first = [First Surveillance Date]\nVAR _last = [Last Epi Week Start] + 6\nRETURN\n    SUMX (\n        VALUES ( 'Date'[Epi Year] ),\n        VAR _y = 'Date'[Epi Year]\n        VAR _days =\n            CALCULATE ( COUNTROWS ( 'Date' ), KEEPFILTERS ( 'Date'[Date] >= _first && 'Date'[Date] <= _last ) )\n        VAR _pop =\n            CALCULATE (\n                SUM ( 'Catchment Population'[Catchment Population] ),\n                REMOVEFILTERS ( 'Date' ),\n                'Date'[Calendar Year] = _y\n            )\n        RETURN\n            DIVIDE ( _pop * _days, 365 )\n    )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Person-time at risk in the period: catchment population of each epi year x days of that year in context / 365, within the surveillance window.",
            "formatString": "#,0"
          },
          {
            "name": "Catchment Population",
            "expression": "VAR _first = [First Surveillance Date]\nVAR _last = [Last Epi Week Start] + 6\nVAR _days =\n    CALCULATE ( COUNTROWS ( 'Date' ), KEEPFILTERS ( 'Date'[Date] >= _first && 'Date'[Date] <= _last ) )\nRETURN\n    DIVIDE ( [Catchment Person-Years] * 365, _days )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Average catchment population over the period (NSA regional population x facility catchment share; time-weighted across epi years).",
            "formatString": "#,0"
          },
          {
            "name": "Malaria Incidence per 100k",
            "expression": "DIVIDE ( [Malaria Cases] * 100000, [Catchment Population] )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Malaria cases per 100 000 catchment population in the selected period (period incidence; equals the OLAP pivot by epi year).",
            "formatString": "#,0"
          },
          {
            "name": "Malaria Incidence per 1,000 PY",
            "expression": "DIVIDE ( [Malaria Cases] * 1000, [Catchment Person-Years] )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Annualised malaria incidence: cases per 1 000 person-years at risk (comparable across periods of different length).",
            "formatString": "#,0.0"
          },
          {
            "name": "Census Population 2023",
            "expression": "CALCULATE ( SUM ( 'Regional Population'[Population] ), REMOVEFILTERS ( 'Date' ), KEEPFILTERS ( 'Regional Population'[Is Census Count] = TRUE () ) )",
            "displayFolder": "4 Disease Surveillance",
            "description": "NSA 2023 census count for the selected regions (all regions = 3 022 401).",
            "formatString": "#,0"
          },
          {
            "name": "Notified Cases (Suppressed)",
            "expression": "VAR _c = [Notified Cases]\nRETURN\n    IF ( _c >= 1 && _c <= 4, BLANK (), _c )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Small-cell suppression for external sharing: counts of 1-4 are blanked to prevent re-identification.",
            "formatString": "#,0"
          },
          {
            "name": "Notified Cases Label",
            "expression": "VAR _c = [Notified Cases]\nRETURN\n    IF ( NOT ISBLANK ( _c ), IF ( _c >= 1 && _c <= 4, \"<5\", FORMAT ( _c, \"#,0\" ) ) )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Suppressed count as text: \"<5\" for 1-4 cases."
          },
          {
            "name": "IDSR Reports Expected",
            "expression": "SUM ( 'IDSR Report'[Report Expected] )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Weekly reports due (facility x epi week).",
            "formatString": "#,0"
          },
          {
            "name": "IDSR Completeness %",
            "expression": "DIVIDE ( SUM ( 'IDSR Report'[Report Received] ), [IDSR Reports Expected] )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Reports received / reports expected.",
            "formatString": "0.0%"
          },
          {
            "name": "IDSR Timeliness %",
            "expression": "DIVIDE ( SUM ( 'IDSR Report'[Report On Time] ), [IDSR Reports Expected] )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Reports received by Tuesday 12:00 after the epi week / reports expected.",
            "formatString": "0.0%"
          },
          {
            "name": "Rainfall (mm)",
            "expression": "AVERAGEX ( VALUES ( 'Facility'[Facility Code] ), CALCULATE ( SUM ( 'Weather'[Rainfall (mm)] ) ) )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Rainfall total per location, averaged across the selected facility locations.",
            "formatString": "#,0"
          },
          {
            "name": "Rainfall 4-8 Weeks Earlier (mm)",
            "expression": "VAR _start = MIN ( 'Date'[Date] )\nRETURN\n    IF (\n        _start >= [First Surveillance Date] && _start <= [Last Epi Week Start] + 6,\n        CALCULATE ( [Rainfall (mm)], DATESINPERIOD ( 'Date'[Date], _start - 29, -28, DAY ) )\n    )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Rainfall in the 28 days ending 4 weeks before the period starts (the lag used by the SARIMAX malaria model).",
            "formatString": "#,0"
          },
          {
            "name": "Avg Max Temperature (C)",
            "expression": "AVERAGE ( 'Weather'[Max Temp (C)] )",
            "displayFolder": "4 Disease Surveillance",
            "description": "Mean daily maximum temperature.",
            "formatString": "#,0.0"
          },
          {
            "name": "Last Data Date",
            "expression": "VAR _k =\n    CALCULATE ( MAX ( 'Attendance'[Arrival Date Key] ), REMOVEFILTERS () )\nRETURN\n    IF ( NOT ISBLANK ( _k ), DATE ( INT ( _k / 10000 ), MOD ( INT ( _k / 100 ), 100 ), MOD ( _k, 100 ) ) )",
            "displayFolder": "5 Time Intelligence",
            "description": "Latest attendance date in the model (ignores all filters except RLS).",
            "formatString": "d mmm yyyy"
          },
          {
            "name": "First Surveillance Date",
            "expression": "VAR _k =\n    CALCULATE ( MIN ( 'Surveillance'[Epi Week Date Key] ), REMOVEFILTERS () )\nRETURN\n    IF ( NOT ISBLANK ( _k ), DATE ( INT ( _k / 10000 ), MOD ( INT ( _k / 100 ), 100 ), MOD ( _k, 100 ) ) )",
            "displayFolder": "5 Time Intelligence",
            "description": "Monday of the first epi week with IDSR returns.",
            "formatString": "d mmm yyyy"
          },
          {
            "name": "Last Epi Week Start",
            "expression": "VAR _k =\n    CALCULATE ( MAX ( 'Surveillance'[Epi Week Date Key] ), REMOVEFILTERS () )\nRETURN\n    IF ( NOT ISBLANK ( _k ), DATE ( INT ( _k / 10000 ), MOD ( INT ( _k / 100 ), 100 ), MOD ( _k, 100 ) ) )",
            "displayFolder": "5 Time Intelligence",
            "description": "Monday of the latest epi week with IDSR returns.",
            "formatString": "d mmm yyyy"
          },
          {
            "name": "ED Attendances YTD Raw",
            "expression": "TOTALYTD ( [ED Attendances], 'Date'[Date] )",
            "displayFolder": "5 Time Intelligence",
            "description": "Calendar year-to-date ED attendances, no future guard (helper).",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "ED Attendances YTD",
            "expression": "IF ( MIN ( 'Date'[Date] ) <= [Last Data Date], [ED Attendances YTD Raw] )",
            "displayFolder": "5 Time Intelligence",
            "description": "Year-to-date ED attendances; blank for periods after the last data date.",
            "formatString": "#,0"
          },
          {
            "name": "ED Attendances YTD PY",
            "expression": "VAR _cutoffPY =\n    EDATE ( [Last Data Date], -12 )\nRETURN\n    CALCULATE (\n        [ED Attendances YTD Raw],\n        SAMEPERIODLASTYEAR ( 'Date'[Date] ),\n        KEEPFILTERS ( 'Date'[Date] <= _cutoffPY )\n    )",
            "displayFolder": "5 Time Intelligence",
            "description": "Same year-to-date window one year earlier, cut at the same day (like-for-like).",
            "formatString": "#,0"
          },
          {
            "name": "ED Attendances YTD YoY %",
            "expression": "DIVIDE ( [ED Attendances YTD] - [ED Attendances YTD PY], [ED Attendances YTD PY] )",
            "displayFolder": "5 Time Intelligence",
            "description": "Year-to-date growth versus the like-for-like prior-year window.",
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Seen Within Target % PY",
            "expression": "IF ( MIN ( 'Date'[Date] ) <= [Last Data Date], CALCULATE ( [Seen Within Target %], SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )",
            "displayFolder": "5 Time Intelligence",
            "description": "Seen-within-target share in the same period last year.",
            "formatString": "0.0%"
          },
          {
            "name": "Seen Within Target Change (pp)",
            "expression": "VAR _cur = [Seen Within Target %]\nVAR _py = [Seen Within Target % PY]\nRETURN\n    IF ( NOT ISBLANK ( _cur ) && NOT ISBLANK ( _py ), ( _cur - _py ) * 100 )",
            "displayFolder": "5 Time Intelligence",
            "description": "Change versus the same period last year, in percentage points.",
            "formatString": "+0.0;-0.0;0.0"
          },
          {
            "name": "Bed Occupancy % Rolling 12M",
            "expression": "VAR _last = [Last Data Date]\nVAR _end =\n    MIN ( MAX ( 'Date'[Date] ), _last )\nRETURN\n    IF (\n        MIN ( 'Date'[Date] ) <= _last,\n        CALCULATE ( [Bed Occupancy %], DATESINPERIOD ( 'Date'[Date], _end, -12, MONTH ) )\n    )",
            "displayFolder": "5 Time Intelligence",
            "description": "Occupancy over the trailing 12 months ending at the context end (capped at the last data date).",
            "formatString": "0.0%"
          },
          {
            "name": "Malaria Cases Epi-YTD",
            "expression": "VAR _end =\n    MIN ( MAX ( 'Date'[Date] ), [Last Epi Week Start] + 6 )\nVAR _y =\n    CALCULATE ( MAX ( 'Date'[Epi Year] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] = _end )\nRETURN\n    IF (\n        MIN ( 'Date'[Date] ) <= _end,\n        CALCULATE ( [Malaria Cases], REMOVEFILTERS ( 'Date' ), 'Date'[Epi Year] = _y, 'Date'[Date] <= _end )\n    )",
            "displayFolder": "5 Time Intelligence",
            "description": "Malaria cases from epi week 1 of the epi year to the end of the context (capped at the last reported week).",
            "formatString": "#,0"
          },
          {
            "name": "Malaria Cases Epi-YTD PY",
            "expression": "VAR _end =\n    MIN ( MAX ( 'Date'[Date] ), [Last Epi Week Start] + 6 )\nVAR _y =\n    CALCULATE ( MAX ( 'Date'[Epi Year] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] = _end )\nVAR _endPY = _end - 364\nRETURN\n    IF (\n        MIN ( 'Date'[Date] ) <= _end,\n        CALCULATE ( [Malaria Cases], REMOVEFILTERS ( 'Date' ), 'Date'[Epi Year] = _y - 1, 'Date'[Date] <= _endPY )\n    )",
            "displayFolder": "5 Time Intelligence",
            "description": "Same number of epi weeks one epi year earlier (like-for-like).",
            "formatString": "#,0"
          },
          {
            "name": "Malaria Cases Epi-YTD YoY %",
            "expression": "DIVIDE ( [Malaria Cases Epi-YTD] - [Malaria Cases Epi-YTD PY], [Malaria Cases Epi-YTD PY] )",
            "displayFolder": "5 Time Intelligence",
            "description": "Epi-year-to-date growth versus the like-for-like prior-year window.",
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Malaria Cases Same Week Last Year",
            "expression": "IF (\n    MIN ( 'Date'[Date] ) <= [Last Epi Week Start] + 6,\n    CALCULATE ( [Malaria Cases], DATEADD ( 'Date'[Date], -364, DAY ) )\n)",
            "displayFolder": "5 Time Intelligence",
            "description": "Malaria cases 52 weeks (364 days) earlier: the same epi week of the previous year.",
            "formatString": "#,0"
          },
          {
            "name": "Malaria Cases 4-Week Average",
            "expression": "VAR _end =\n    MIN ( MAX ( 'Date'[Date] ), [Last Epi Week Start] + 6 )\nRETURN\n    DIVIDE ( CALCULATE ( [Malaria Cases], DATESINPERIOD ( 'Date'[Date], _end, -28, DAY ) ), 4 )",
            "displayFolder": "5 Time Intelligence",
            "description": "Average weekly malaria cases over the four epi weeks ending at the context end.",
            "formatString": "#,0.0"
          },
          {
            "name": "Forecast Cases",
            "expression": "CALCULATE ( SUM ( 'Malaria Forecast'[Forecast] ), KEEPFILTERS ( 'Malaria Forecast'[Series] = \"Forecast\" ) )",
            "displayFolder": "6 Advanced Analytics",
            "description": "13-week forward forecast of North-East malaria cases (Holt-Winters ETS on log cases).",
            "formatString": "#,0"
          },
          {
            "name": "Forecast Lower 80",
            "expression": "CALCULATE ( SUM ( 'Malaria Forecast'[Lower 80] ), KEEPFILTERS ( 'Malaria Forecast'[Series] = \"Forecast\" ) )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Lower bound of the 80 % prediction interval.",
            "formatString": "#,0"
          },
          {
            "name": "Forecast Upper 80",
            "expression": "CALCULATE ( SUM ( 'Malaria Forecast'[Upper 80] ), KEEPFILTERS ( 'Malaria Forecast'[Series] = \"Forecast\" ) )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Upper bound of the 80 % prediction interval.",
            "formatString": "#,0"
          },
          {
            "name": "Model Actual Cases",
            "expression": "CALCULATE ( SUM ( 'Malaria Forecast'[Actual] ), KEEPFILTERS ( 'Malaria Forecast'[Series] = \"Actual\" ) )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Weekly North-East malaria cases the model was trained and tested on (PAS-coded attendances).",
            "formatString": "#,0"
          },
          {
            "name": "Backtest Forecast",
            "expression": "CALCULATE ( SUM ( 'Malaria Forecast'[Forecast] ), KEEPFILTERS ( 'Malaria Forecast'[Series] = \"Back-test (1 week ahead)\" ) )",
            "displayFolder": "6 Advanced Analytics",
            "description": "One-week-ahead forecasts made at each rolling origin of the back-test.",
            "formatString": "#,0"
          },
          {
            "name": "Backtest WAPE % (1 Week Ahead)",
            "expression": "VAR _rows =\n    FILTER ( 'Malaria Forecast', 'Malaria Forecast'[Series] = \"Back-test (1 week ahead)\" )\nRETURN\n    DIVIDE (\n        SUMX ( _rows, ABS ( 'Malaria Forecast'[Actual] - 'Malaria Forecast'[Forecast] ) ),\n        SUMX ( _rows, ABS ( 'Malaria Forecast'[Actual] ) )\n    )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Weighted absolute percentage error of the one-week-ahead back-test forecasts.",
            "formatString": "0.0%"
          },
          {
            "name": "Readmission Observed %",
            "expression": "DIVIDE ( SUMX ( 'Readmission Deciles', 'Readmission Deciles'[Observed Rate] * 'Readmission Deciles'[Spells] ), SUM ( 'Readmission Deciles'[Spells] ) )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Observed 30-day readmission rate in the test set (spell-weighted).",
            "formatString": "0.0%"
          },
          {
            "name": "Readmission Predicted %",
            "expression": "DIVIDE (\n    SUMX ( 'Readmission Deciles', 'Readmission Deciles'[Mean Predicted] * 'Readmission Deciles'[Spells] ),\n    SUM ( 'Readmission Deciles'[Spells] )\n)",
            "displayFolder": "6 Advanced Analytics",
            "description": "Mean predicted readmission probability (spell-weighted) - compare with observed for calibration.",
            "formatString": "0.0%"
          },
          {
            "name": "Top-20% Risk Capture %",
            "expression": "VAR _all = SUMX ( 'Readmission Deciles', 'Readmission Deciles'[Observed Rate] * 'Readmission Deciles'[Spells] )\nVAR _top =\n    CALCULATE ( SUMX ( 'Readmission Deciles', 'Readmission Deciles'[Observed Rate] * 'Readmission Deciles'[Spells] ), KEEPFILTERS ( 'Readmission Deciles'[Risk Decile] >= 9 ) )\nRETURN\n    DIVIDE ( _top, _all )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Share of all readmissions that fall in the two highest risk deciles (who to call after discharge).",
            "formatString": "0.0%"
          },
          {
            "name": "Odds Ratio",
            "expression": "AVERAGE ( 'Readmission Drivers'[Odds Ratio Value] )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Odds ratio of a readmission driver (logistic regression, reference coding).",
            "formatString": "#,0.00"
          },
          {
            "name": "Wait Effect %",
            "expression": "DIVIDE ( AVERAGE ( 'ED Wait Drivers'[Effect %] ), 100 )",
            "displayFolder": "6 Advanced Analytics",
            "description": "% change in door-to-doctor time associated with the driver (OLS on log waiting time).",
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Wait Effect % (Operational)",
            "expression": "CALCULATE ( [Wait Effect %], KEEPFILTERS ( LEFT ( 'ED Wait Drivers'[Driver], 6 ) <> \"Triage\" ) )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Wait effect of the drivers management can act on (case-mix controls such as triage category excluded).",
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Wait Effect Lower 95%",
            "expression": "DIVIDE ( AVERAGE ( 'ED Wait Drivers'[CI Low %] ), 100 )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Lower 95 % confidence limit of the effect.",
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Wait Effect Upper 95%",
            "expression": "DIVIDE ( AVERAGE ( 'ED Wait Drivers'[CI High %] ), 100 )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Upper 95 % confidence limit of the effect.",
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Outbreak Alerts",
            "expression": "COUNTROWS ( 'Outbreak Alerts' )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Facility-condition-weeks flagged by the selected detection method(s).",
            "formatString": "#,0"
          },
          {
            "name": "Alerts in Known Outbreak Weeks %",
            "expression": "DIVIDE ( CALCULATE ( [Outbreak Alerts], KEEPFILTERS ( 'Outbreak Alerts'[Is Known Outbreak] = TRUE () ) ), [Outbreak Alerts] )",
            "displayFolder": "6 Advanced Analytics",
            "description": "Share of alerts that fall in weeks of a known (injected) outbreak - a positive-predictive-value proxy.",
            "formatString": "0.0%"
          },
          {
            "name": "DQ Issues Logged",
            "expression": "SUM ( 'DQ Summary'[Issues] )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Data-quality issues logged by the ETL rules (all batches).",
            "formatString": "#,0"
          },
          {
            "name": "DQ Rules Triggered",
            "expression": "CALCULATE ( COUNTROWS ( 'DQ Summary' ), KEEPFILTERS ( 'DQ Summary'[Issues] > 0 ) )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Rules that logged at least one issue.",
            "formatString": "#,0"
          },
          {
            "name": "Reconciliation Pass %",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( 'Reconciliation' ), KEEPFILTERS ( 'Reconciliation'[Status] = \"PASS\" ) ), COUNTROWS ( 'Reconciliation' ) )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Share of reconciliation checks of the latest batch with status PASS.",
            "formatString": "0.0%"
          },
          {
            "name": "Reconciliation Warnings",
            "expression": "CALCULATE ( COUNTROWS ( 'Reconciliation' ), KEEPFILTERS ( 'Reconciliation'[Status] = \"WARN\" ) )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Checks with status WARN (explained differences).",
            "formatString": "#,0"
          },
          {
            "name": "Imputed Census Days %",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( 'Ward Census' ), KEEPFILTERS ( 'Ward Census'[Census Source] = \"Imputed from PAS\" ) ), COUNTROWS ( 'Ward Census' ) )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Ward-days whose census was imputed from PAS spells (missing ward return, rule WC01).",
            "formatString": "0.00%"
          },
          {
            "name": "Uncoded Diagnosis %",
            "expression": "DIVIDE ( CALCULATE ( [Attendances], KEEPFILTERS ( 'Diagnosis'[ICD-10 Code] = \"UNK\" ) ), [Attendances] )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Attendances without a valid ICD-10 code (rules EN07-EN08).",
            "formatString": "0.00%"
          },
          {
            "name": "Unidentified Attendances",
            "expression": "CALCULATE ( [Attendances], KEEPFILTERS ( 'Attendance'[Patient Durable Key] < 0 ) )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Attendances without a patient identifier (rule EN11).",
            "formatString": "#,0"
          },
          {
            "name": "Open Spells Over 60 Days",
            "expression": "SUM ( 'Admission'[Is Open Over 60d] )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Spells still open more than 60 days after admission (probable missing discharge, rule AD06).",
            "formatString": "#,0"
          },
          {
            "name": "Visible Facilities",
            "expression": "CALCULATE ( DISTINCTCOUNT ( 'Facility'[Facility Code] ), KEEPFILTERS ( 'Facility'[Facility Key] > 0 ) )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Facilities visible to the current user (RLS test).",
            "formatString": "#,0"
          },
          {
            "name": "Current User",
            "expression": "USERPRINCIPALNAME ()",
            "displayFolder": "7 Data Quality & Security",
            "description": "User principal name evaluated by row-level security."
          }
        ]
      },
      {
        "name": "Date",
        "description": "Conformed calendar (complete years 2021 to the latest data year) with calendar, ISO epidemiological week (IDSR), fiscal year (April-March) and rainy-season attributes. Marked as the date table.",
        "columns": [
          {
            "name": "Date Key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "isHidden": true,
            "description": "Smart surrogate key YYYYMMDD (-1 = unknown, -2 = not applicable / not yet happened). Source: generated by etl.sp_load_dim_date",
            "summarizeBy": "none"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "full_date",
            "isKey": true,
            "formatString": "d mmm yyyy",
            "description": "Calendar date. Source: generated",
            "summarizeBy": "none"
          },
          {
            "name": "Day of Month",
            "dataType": "int64",
            "sourceColumn": "day_of_month",
            "displayFolder": "Calendar",
            "description": "Day number within the month (1-31). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Day of Week",
            "dataType": "int64",
            "sourceColumn": "day_of_week_iso",
            "isHidden": true,
            "description": "ISO weekday number, Monday = 1 ... Sunday = 7 (sort key for day_name). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Day Name",
            "dataType": "string",
            "sourceColumn": "day_name",
            "sortByColumn": "Day of Week",
            "displayFolder": "Calendar",
            "description": "Weekday name (Monday..Sunday). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Day Short",
            "dataType": "string",
            "sourceColumn": "day_short",
            "sortByColumn": "Day of Week",
            "displayFolder": "Calendar",
            "description": "Three-letter weekday abbreviation (sort by day_of_week_iso). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Is Weekend",
            "dataType": "boolean",
            "sourceColumn": "is_weekend",
            "displayFolder": "Calendar",
            "description": "True for Saturday and Sunday. Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Is Public Holiday",
            "dataType": "boolean",
            "sourceColumn": "is_public_holiday",
            "displayFolder": "Calendar",
            "description": "Namibian public holiday (Public Holidays Act 26 of 1990, incl. Easter-based dates).",
            "summarizeBy": "none"
          },
          {
            "name": "Holiday Name",
            "dataType": "string",
            "sourceColumn": "holiday_name",
            "displayFolder": "Calendar",
            "description": "Name of the Namibian public holiday, NULL otherwise. Source: etl.fn_namibian_holiday",
            "summarizeBy": "none"
          },
          {
            "name": "Epi Year",
            "dataType": "int64",
            "sourceColumn": "epi_year",
            "displayFolder": "Epidemiological week (IDSR)",
            "description": "ISO year of the epidemiological week (Monday-Sunday) used by IDSR reporting.",
            "summarizeBy": "none"
          },
          {
            "name": "Epi Week",
            "dataType": "int64",
            "sourceColumn": "epi_week",
            "displayFolder": "Epidemiological week (IDSR)",
            "description": "Epidemiological week number 1-53 (ISO-8601, Monday-Sunday), as used for IDSR weekly reporting. Source: derived (IW)",
            "summarizeBy": "none"
          },
          {
            "name": "Epi Week Label",
            "dataType": "string",
            "sourceColumn": "epi_week_label",
            "sortByColumn": "Epi Week Key",
            "displayFolder": "Epidemiological week (IDSR)",
            "description": "e.g. 2026-W39.",
            "summarizeBy": "none"
          },
          {
            "name": "Epi Week Key",
            "dataType": "int64",
            "sourceColumn": "epi_week_key",
            "isHidden": true,
            "description": "Integer YYYYWW (sort key for epi_week_label). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Epi Week Start",
            "dataType": "dateTime",
            "sourceColumn": "epi_week_start",
            "formatString": "d mmm yyyy",
            "displayFolder": "Epidemiological week (IDSR)",
            "description": "Monday of the epi week; use as a continuous weekly axis.",
            "summarizeBy": "none"
          },
          {
            "name": "Month Number",
            "dataType": "int64",
            "sourceColumn": "month_num",
            "isHidden": true,
            "description": "Calendar month number 1-12 (sort key for month_name). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Month Name",
            "dataType": "string",
            "sourceColumn": "month_name",
            "sortByColumn": "Month Number",
            "displayFolder": "Calendar",
            "description": "Calendar month name. Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Month Short",
            "dataType": "string",
            "sourceColumn": "month_short",
            "sortByColumn": "Month Number",
            "displayFolder": "Calendar",
            "description": "Three-letter month abbreviation (sort by month_num). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Year Month",
            "dataType": "string",
            "sourceColumn": "year_month",
            "sortByColumn": "Year Month Key",
            "displayFolder": "Calendar",
            "description": "Year-month label YYYY-MM. Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Year Month Key",
            "dataType": "int64",
            "sourceColumn": "year_month_key",
            "isHidden": true,
            "description": "Integer YYYYMM (sort key for year_month). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Month Start",
            "dataType": "dateTime",
            "sourceColumn": "month_start_date",
            "formatString": "mmm yyyy",
            "displayFolder": "Calendar",
            "description": "First day of the month. Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Quarter Number",
            "dataType": "int64",
            "sourceColumn": "quarter_num",
            "isHidden": true,
            "description": "Calendar quarter 1-4. Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Year Quarter",
            "dataType": "string",
            "sourceColumn": "year_quarter",
            "displayFolder": "Calendar",
            "description": "Quarter label YYYY-Qn. Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Calendar Year",
            "dataType": "int64",
            "sourceColumn": "calendar_year",
            "displayFolder": "Calendar",
            "description": "Calendar year (time-intelligence year for YTD and year-on-year measures). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Fiscal Year",
            "dataType": "string",
            "sourceColumn": "fiscal_year_label",
            "sortByColumn": "Fiscal Year Start",
            "displayFolder": "Fiscal (Apr-Mar)",
            "description": "Fiscal year label FYyyyy/yy; the GBHS financial year runs 1 April - 31 March (aligned with the Namibian public sector). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Fiscal Year Start",
            "dataType": "int64",
            "sourceColumn": "fiscal_year_start",
            "isHidden": true,
            "description": "Calendar year in which the fiscal year starts (sort key for fiscal_year_label). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Rainy Season",
            "dataType": "string",
            "sourceColumn": "rainy_season_label",
            "displayFolder": "Seasons",
            "description": "July-June season label used for malaria transmission seasons.",
            "summarizeBy": "none"
          },
          {
            "name": "Is Malaria Season",
            "dataType": "boolean",
            "sourceColumn": "is_malaria_season",
            "displayFolder": "Seasons",
            "description": "January-May peak transmission months.",
            "summarizeBy": "none"
          },
          {
            "name": "Is After Cut-off",
            "dataType": "boolean",
            "sourceColumn": "is_after_cutoff",
            "displayFolder": "Calendar",
            "description": "True for dates after the latest extract (no data yet).",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "type": "m",
