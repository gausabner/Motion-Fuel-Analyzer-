            "summarizeBy": "none"
          },
          {
            "name": "Patient Durable Key",
            "dataType": "int64",
            "sourceColumn": "patient_durable_key",
            "isHidden": true,
            "description": "First surrogate key of the patient: stable across SCD2 versions (distinct patient counts).",
