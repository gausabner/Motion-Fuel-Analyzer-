            "summarizeBy": "none"
          },
          {
            "name": "Encounter Count",
            "dataType": "int64",
            "sourceColumn": "encounter_count",
            "isHidden": true,
            "description": "Always 1; additive count of attendances. Source: ETL",
            "summarizeBy": "sum"
          },
          {
            "name": "Wait to Triage (min)",
            "dataType": "double",
            "sourceColumn": "wait_to_triage_min",
            "isHidden": true,
            "description": "Minutes from arrival to triage (ED only; NULL if invalid). Source: triage_datetime - arrival_datetime",
            "summarizeBy": "average"
          },
          {
            "name": "Door to Doctor (min)",
            "dataType": "double",
            "sourceColumn": "door_to_doctor_min",
            "isHidden": true,
            "description": "Minutes from arrival to first assessment by a doctor/clinician (NULL if not seen or invalid, EN05/EN06). Source: seen_datetime - arrival_datetime",
            "summarizeBy": "average"
          },
          {
            "name": "ED Length of Stay (min)",
            "dataType": "double",
            "sourceColumn": "ed_los_min",
            "isHidden": true,
            "description": "Minutes from arrival to departure (NULL if > 72 h or negative). Source: departure_datetime - arrival_datetime",
            "summarizeBy": "average"
          },
          {
            "name": "Seen Within Target",
            "dataType": "int64",
            "sourceColumn": "seen_within_target",
            "isHidden": true,
            "description": "1 if seen within the triage compliance threshold, 0 if not, NULL if not triaged/seen. Source: derived with dim_triage.compliance_minutes",
            "summarizeBy": "sum"
          },
          {
            "name": "Is LWBS",
            "dataType": "int64",
            "sourceColumn": "is_lwbs",
            "isHidden": true,
            "description": "1 if the patient left without being seen. Source: disposition = LWBS",
            "summarizeBy": "sum"
          },
          {
            "name": "Is Admitted",
            "dataType": "int64",
            "sourceColumn": "is_admitted",
            "isHidden": true,
            "description": "1 if admitted to a ward from the ED. Source: disposition = ADM",
            "summarizeBy": "sum"
          },
          {
            "name": "Is Died",
            "dataType": "int64",
            "sourceColumn": "is_died",
            "isHidden": true,
            "description": "1 if the patient died in the department (incl. dead on arrival). Source: disposition = DIED",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Attendance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing\n    ReadCsv = (file as text) as table =>\n        let\n            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])\n        in\n            Table.ReplaceValue(Raw, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),\n    Source = if SourceMode = \"CSV\"\n        then ReadCsv(\"v_fact_encounter.csv.gz\")\n        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = \"mart\", Item = \"v_fact_encounter\"]}[Data],\n    Typed = Table.TransformColumnTypes(Source, {{\"arrival_date_key\", Int64.Type}, {\"arrival_hour_key\", Int64.Type}, {\"care_unit_key\", Int64.Type}, {\"patient_key\", Int64.Type}, {\"patient_durable_key\", Int64.Type}, {\"diagnosis_key\", Int64.Type}, {\"triage_key\", Int64.Type}, {\"encounter_profile_key\", Int64.Type}, {\"age_band_key\", Int64.Type}, {\"encounter_count\", Int64.Type}, {\"wait_to_triage_min\", type number}, {\"door_to_doctor_min\", type number}, {\"ed_los_min\", type number}, {\"seen_within_target\", Int64.Type}, {\"is_lwbs\", Int64.Type}, {\"is_admitted\", Int64.Type}, {\"is_died\", Int64.Type}}, \"en-US\"),\n    // incremental refresh window (RangeStart/RangeEnd folded to SQL as integer date keys)\n    Filtered = Table.SelectRows(Typed, each [arrival_date_key] >= Int64.From(DateTime.ToText(RangeStart, \"yyyyMMdd\")) and [arrival_date_key] < Int64.From(DateTime.ToText(RangeEnd, \"yyyyMMdd\")))\nin\n    Filtered"
            }
          }
        ],
        "refreshPolicy": {
          "policyType": "basic",
          "rollingWindowGranularity": "year",
          "rollingWindowPeriods": 5,
          "incrementalGranularity": "day",
          "incrementalPeriods": 10,
          "sourceExpression": "let\n    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing\n    ReadCsv = (file as text) as table =>\n        let\n            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])\n        in\n            Table.ReplaceValue(Raw, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),\n    Source = if SourceMode = \"CSV\"\n        then ReadCsv(\"v_fact_encounter.csv.gz\")\n        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = \"mart\", Item = \"v_fact_encounter\"]}[Data],\n    Typed = Table.TransformColumnTypes(Source, {{\"arrival_date_key\", Int64.Type}, {\"arrival_hour_key\", Int64.Type}, {\"care_unit_key\", Int64.Type}, {\"patient_key\", Int64.Type}, {\"patient_durable_key\", Int64.Type}, {\"diagnosis_key\", Int64.Type}, {\"triage_key\", Int64.Type}, {\"encounter_profile_key\", Int64.Type}, {\"age_band_key\", Int64.Type}, {\"encounter_count\", Int64.Type}, {\"wait_to_triage_min\", type number}, {\"door_to_doctor_min\", type number}, {\"ed_los_min\", type number}, {\"seen_within_target\", Int64.Type}, {\"is_lwbs\", Int64.Type}, {\"is_admitted\", Int64.Type}, {\"is_died\", Int64.Type}}, \"en-US\"),\n    // incremental refresh window (RangeStart/RangeEnd folded to SQL as integer date keys)\n    Filtered = Table.SelectRows(Typed, each [arrival_date_key] >= Int64.From(DateTime.ToText(RangeStart, \"yyyyMMdd\")) and [arrival_date_key] < Int64.From(DateTime.ToText(RangeEnd, \"yyyyMMdd\")))\nin\n    Filtered"
        }
      },
      {
        "name": "Admission",
        "description": "Inpatient spells (accumulating snapshot; grain: one row per spell, updated as milestones arrive: admission, discharge, 30-day follow-up). Active date = admission; inactive role-playing date = discharge.",
        "columns": [
          {
            "name": "Admission Date Key",
            "dataType": "int64",
            "sourceColumn": "admission_date_key",
            "isHidden": true,
            "description": "FK to dim_date - admission date (active relationship). Source: PAS admission_datetime",
            "summarizeBy": "none"
          },
          {
            "name": "Discharge Date Key",
            "dataType": "int64",
            "sourceColumn": "discharge_date_key",
            "isHidden": true,
            "description": "FK to dim_date - discharge date (role-playing; -2 = still in hospital). Source: PAS discharge_datetime (AD02, AD03)",
            "summarizeBy": "none"
          },
          {
            "name": "Care Unit Key",
            "dataType": "int64",
            "sourceColumn": "care_unit_key",
            "isHidden": true,
            "description": "FK to dim_care_unit version (admitting ward) valid on the admission date. Source: PAS ward_code (AD04)",
            "summarizeBy": "none"
          },
          {
            "name": "Patient Key",
            "dataType": "int64",
            "sourceColumn": "patient_key",
            "isHidden": true,
            "description": "FK to dim_patient version valid on the admission date. Source: PAS patient_id",
            "summarizeBy": "none"
          },
          {
            "name": "Patient Durable Key",
            "dataType": "int64",
            "sourceColumn": "patient_durable_key",
            "isHidden": true,
            "description": "Durable (supernatural) key: the surrogate key of the patient's first version, identical on every version - used to count distinct patients across SCD2 versions. Source: ETL",
            "summarizeBy": "none"
          },
          {
            "name": "Diagnosis Key",
            "dataType": "int64",
            "sourceColumn": "diagnosis_key",
            "isHidden": true,
            "description": "FK to dim_diagnosis - principal diagnosis (-1 until coded). Source: PAS principal_icd10 (AD05)",
            "summarizeBy": "none"
          },
          {
            "name": "Admission Profile Key",
            "dataType": "int64",
            "sourceColumn": "admission_profile_key",
            "isHidden": true,
            "description": "FK to the admission method x discharge status junk dimension. Source: PAS admission_method, discharge_status (AD07)",
            "summarizeBy": "none"
          },
          {
            "name": "Age Band Key",
            "dataType": "int64",
            "sourceColumn": "age_band_key",
            "isHidden": true,
            "description": "FK to dim_age_band (age at admission). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Admission Count",
            "dataType": "int64",
            "sourceColumn": "admission_count",
            "isHidden": true,
            "description": "Always 1; additive count of spells. Source: ETL",
            "summarizeBy": "sum"
          },
          {
            "name": "LOS (days)",
            "dataType": "int64",
            "sourceColumn": "los_days",
            "isHidden": true,
            "description": "Length of stay in midnights (discharge date - admission date); NULL while in hospital. Additive (= patient days). Source: derived",
            "summarizeBy": "sum"
          },
          {
            "name": "Is Discharged",
            "dataType": "int64",
            "sourceColumn": "is_discharged",
            "isHidden": true,
            "description": "1 once the discharge milestone is recorded. Source: derived",
            "summarizeBy": "sum"
          },
          {
            "name": "Is Died",
            "dataType": "int64",
            "sourceColumn": "is_died",
            "isHidden": true,
            "description": "1 for an in-hospital death. Source: discharge_status = DIED",
            "summarizeBy": "sum"
          },
          {
            "name": "Discharged Before Noon",
            "dataType": "int64",
            "sourceColumn": "discharged_before_noon",
            "isHidden": true,
            "description": "1 if discharged before 12:00 (flow KPI); NULL while in hospital. Source: derived",
            "summarizeBy": "sum"
          },
          {
            "name": "Is Weekend Discharge",
            "dataType": "int64",
            "sourceColumn": "is_weekend_discharge",
            "isHidden": true,
            "description": "1 if discharged on Saturday or Sunday; NULL while in hospital. Source: derived",
            "summarizeBy": "sum"
          },
          {
            "name": "Is Readmission 30d",
            "dataType": "int64",
            "sourceColumn": "is_readmission_30d",
            "isHidden": true,
            "description": "1 if this spell is an emergency admission within 30 days of the same patient's previous live discharge. Source: derived (window over patient pseudonym)",
            "summarizeBy": "sum"
          },
          {
            "name": "Readmission Eligible",
            "dataType": "int64",
            "sourceColumn": "readmission_eligible",
            "isHidden": true,
            "description": "1 if this spell counts in the readmission-rate denominator: discharged alive (home or AMA), not maternity, and 30 days of follow-up available. Source: derived (GBHS KPI definition)",
            "summarizeBy": "sum"
          },
          {
            "name": "Readmitted Within 30d",
            "dataType": "int64",
            "sourceColumn": "readmitted_within_30d",
            "isHidden": true,
            "description": "1 if an eligible spell was followed by an emergency readmission within 30 days (milestone 3). Source: derived",
            "summarizeBy": "sum"
          },
          {
            "name": "Prior Admissions 12m",
            "dataType": "int64",
            "sourceColumn": "prior_admissions_12m",
            "isHidden": true,
            "description": "Number of the patient's admissions in the 365 days before this admission (risk feature). Source: derived",
            "summarizeBy": "average"
          },
          {
            "name": "Is Open Over 60d",
            "dataType": "int64",
            "sourceColumn": "is_open_over_60d",
            "isHidden": true,
            "description": "1 if the spell is still open more than 60 days after admission at the snapshot date (AD06, probable missing discharge). Source: derived",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Admission",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing\n    ReadCsv = (file as text) as table =>\n        let\n            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])\n        in\n            Table.ReplaceValue(Raw, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),\n    Source = if SourceMode = \"CSV\"\n        then ReadCsv(\"v_fact_admission.csv.gz\")\n        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = \"mart\", Item = \"v_fact_admission\"]}[Data],\n    Typed = Table.TransformColumnTypes(Source, {{\"admission_date_key\", Int64.Type}, {\"discharge_date_key\", Int64.Type}, {\"care_unit_key\", Int64.Type}, {\"patient_key\", Int64.Type}, {\"patient_durable_key\", Int64.Type}, {\"diagnosis_key\", Int64.Type}, {\"admission_profile_key\", Int64.Type}, {\"age_band_key\", Int64.Type}, {\"admission_count\", Int64.Type}, {\"los_days\", Int64.Type}, {\"is_discharged\", Int64.Type}, {\"is_died\", Int64.Type}, {\"discharged_before_noon\", Int64.Type}, {\"is_weekend_discharge\", Int64.Type}, {\"is_readmission_30d\", Int64.Type}, {\"readmission_eligible\", Int64.Type}, {\"readmitted_within_30d\", Int64.Type}, {\"prior_admissions_12m\", Int64.Type}, {\"is_open_over_60d\", Int64.Type}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      },
      {
        "name": "Ward Census",
        "description": "Midnight ward census (periodic snapshot; grain: ward x day). Occupied and available beds are semi-additive: sum over wards, never over days (summed over days they become patient days / bed days).",
        "columns": [
          {
            "name": "Census Date Key",
            "dataType": "int64",
            "sourceColumn": "census_date_key",
            "isHidden": true,
            "description": "FK to dim_date (census date, midnight). Source: ward return census_date",
            "summarizeBy": "none"
          },
          {
            "name": "Care Unit Key",
            "dataType": "int64",
            "sourceColumn": "care_unit_key",
            "isHidden": true,
            "description": "FK to dim_care_unit version valid on the census date. Source: ward_code",
            "summarizeBy": "none"
          },
          {
            "name": "Bed Complement",
            "dataType": "int64",
            "sourceColumn": "beds_complement",
            "isHidden": true,
            "description": "Official beds of the ward version (semi-additive). Source: dim_care_unit.bed_complement",
            "summarizeBy": "none"
          },
          {
            "name": "Beds Closed",
            "dataType": "int64",
            "sourceColumn": "beds_closed",
            "isHidden": true,
            "description": "Beds closed (maintenance, staffing) (semi-additive). Source: ward return",
            "summarizeBy": "none"
          },
          {
            "name": "Beds Available",
            "dataType": "int64",
            "sourceColumn": "beds_available",
            "isHidden": true,
            "description": "Beds available = complement - closed (semi-additive; sum over days = available bed-days). Source: derived",
            "summarizeBy": "none"
          },
          {
            "name": "Occupied Beds",
            "dataType": "int64",
            "sourceColumn": "occupied_beds",
            "isHidden": true,
            "description": "Patients in the ward at midnight (semi-additive; sum over days = patient days). Source: ward return (WC02, WC04) or PAS imputation (WC01)",
            "summarizeBy": "none"
          },
          {
            "name": "Admissions",
            "dataType": "int64",
            "sourceColumn": "admissions",
            "isHidden": true,
            "description": "Admissions to the ward during the day (additive flow). Source: ward return",
            "summarizeBy": "sum"
          },
          {
            "name": "Discharges",
            "dataType": "int64",
            "sourceColumn": "discharges",
            "isHidden": true,
            "description": "Discharges (incl. deaths and transfers out) during the day (additive flow). Source: ward return",
            "summarizeBy": "sum"
          },
          {
            "name": "Deaths",
            "dataType": "int64",
            "sourceColumn": "deaths",
            "isHidden": true,
            "description": "In-ward deaths during the day (additive flow). Source: ward return",
            "summarizeBy": "sum"
          },
          {
            "name": "Census Source",
            "dataType": "string",
            "sourceColumn": "census_source",
            "description": "Ward return, Corrected return or Imputed from PAS (lineage of each ward-day).",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Ward Census",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing\n    ReadCsv = (file as text) as table =>\n        let\n            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])\n        in\n            Table.ReplaceValue(Raw, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),\n    Source = if SourceMode = \"CSV\"\n        then ReadCsv(\"v_fact_ward_census.csv.gz\")\n        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = \"mart\", Item = \"v_fact_ward_census\"]}[Data],\n    Typed = Table.TransformColumnTypes(Source, {{\"census_date_key\", Int64.Type}, {\"care_unit_key\", Int64.Type}, {\"beds_complement\", Int64.Type}, {\"beds_closed\", Int64.Type}, {\"beds_available\", Int64.Type}, {\"occupied_beds\", Int64.Type}, {\"admissions\", Int64.Type}, {\"discharges\", Int64.Type}, {\"deaths\", Int64.Type}, {\"census_source\", type text}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      },
      {
        "name": "Staff Roster",
        "description": "E-roster shift summary (periodic snapshot; grain: unit x day x shift). Hours are additive; staff on duty are semi-additive.",
        "columns": [
          {
            "name": "Roster Date Key",
            "dataType": "int64",
            "sourceColumn": "roster_date_key",
            "isHidden": true,
            "description": "FK to dim_date (date the shift starts). Source: e-roster roster_date",
            "summarizeBy": "none"
          },
          {
            "name": "Care Unit Key",
            "dataType": "int64",
            "sourceColumn": "care_unit_key",
            "isHidden": true,
            "description": "FK to dim_care_unit version valid on the roster date. Source: e-roster unit_code",
            "summarizeBy": "none"
          },
          {
            "name": "Shift Key",
            "dataType": "int64",
            "sourceColumn": "shift_key",
            "isHidden": true,
            "description": "FK to dim_shift. Source: e-roster shift (RS01)",
            "summarizeBy": "none"
          },
          {
            "name": "Planned Nurse Hours",
            "dataType": "double",
            "sourceColumn": "planned_nurse_hours",
            "isHidden": true,
            "description": "Nursing hours on the approved roster (additive). Source: e-roster",
            "summarizeBy": "sum"
          },
          {
            "name": "Nurse Hours",
            "dataType": "double",
            "sourceColumn": "nurse_hours",
            "isHidden": true,
            "description": "Total nursing hours worked = rn_hours + en_hours (additive; numerator of NHPPD). Source: derived",
            "summarizeBy": "sum"
          },
          {
            "name": "RN Hours",
            "dataType": "double",
            "sourceColumn": "rn_hours",
            "isHidden": true,
            "description": "Registered-nurse hours worked (additive). Source: e-roster (RS02)",
            "summarizeBy": "sum"
          },
          {
            "name": "Doctor Hours",
            "dataType": "double",
            "sourceColumn": "doctor_hours",
            "isHidden": true,
            "description": "Doctor hours worked in the unit (additive). Source: e-roster",
            "summarizeBy": "sum"
          },
          {
            "name": "Overtime Hours",
            "dataType": "double",
            "sourceColumn": "overtime_hours",
            "isHidden": true,
            "description": "Overtime nursing hours (additive; NULL when inconsistent, RS04). Source: e-roster",
            "summarizeBy": "sum"
          },
          {
            "name": "Agency Hours",
            "dataType": "double",
            "sourceColumn": "agency_hours",
            "isHidden": true,
            "description": "Agency (temporary) nursing hours (additive). Source: e-roster",
            "summarizeBy": "sum"
          },
          {
            "name": "Sick Leave Hours",
            "dataType": "double",
            "sourceColumn": "sick_leave_hours",
            "isHidden": true,
            "description": "Rostered hours lost to sick leave (additive). Source: e-roster",
            "summarizeBy": "sum"
          },
          {
            "name": "Nurses on Duty",
            "dataType": "int64",
            "sourceColumn": "nurses_on_duty",
            "isHidden": true,
            "description": "Nurses on duty during the shift (semi-additive). Source: e-roster",
            "summarizeBy": "none"
          },
          {
            "name": "Doctors on Duty",
            "dataType": "int64",
            "sourceColumn": "doctors_on_duty",
            "isHidden": true,
            "description": "Doctors on duty during the shift (semi-additive). Source: e-roster",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Staff Roster",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing\n    ReadCsv = (file as text) as table =>\n        let\n            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])\n        in\n            Table.ReplaceValue(Raw, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),\n    Source = if SourceMode = \"CSV\"\n        then ReadCsv(\"v_fact_staff_roster.csv.gz\")\n        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = \"mart\", Item = \"v_fact_staff_roster\"]}[Data],\n    Typed = Table.TransformColumnTypes(Source, {{\"roster_date_key\", Int64.Type}, {\"care_unit_key\", Int64.Type}, {\"shift_key\", Int64.Type}, {\"planned_nurse_hours\", type number}, {\"nurse_hours\", type number}, {\"rn_hours\", type number}, {\"doctor_hours\", type number}, {\"overtime_hours\", type number}, {\"agency_hours\", type number}, {\"sick_leave_hours\", type number}, {\"nurses_on_duty\", Int64.Type}, {\"doctors_on_duty\", Int64.Type}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      },
      {
        "name": "Surveillance",
        "description": "IDSR weekly returns (periodic snapshot; grain: facility x condition x epi week; key = Monday of the epi week).",
        "columns": [
          {
            "name": "Epi Week Date Key",
            "dataType": "int64",
            "sourceColumn": "epi_week_date_key",
            "isHidden": true,
            "description": "FK to dim_date = Monday of the ISO epi week. Source: IDSR epi_week (SV01)",
            "summarizeBy": "none"
          },
          {
            "name": "Facility Key",
            "dataType": "int64",
            "sourceColumn": "facility_key",
            "isHidden": true,
            "description": "FK to dim_facility (reporting facility). Source: IDSR facility_code",
            "summarizeBy": "none"
          },
          {
            "name": "Condition Key",
            "dataType": "int64",
            "sourceColumn": "condition_key",
            "isHidden": true,
            "description": "FK to dim_condition. Source: IDSR condition (SV03)",
            "summarizeBy": "none"
          },
          {
            "name": "Cases Under 5",
            "dataType": "int64",
            "sourceColumn": "cases_under5",
            "isHidden": true,
            "description": "Cases in children under 5 (additive). Source: IDSR return (SV06, SV07)",
