    "roles": [
      {
        "name": "Executive (all facilities)",
        "modelPermission": "read",
        "description": "Unrestricted read for the executive committee, the CEO and the BI team."
      },
      {
        "name": "Facility Manager (dynamic)",
        "modelPermission": "read",
        "description": "Dynamic RLS: users see the facilities mapped to their UPN in sec.user_facility_access (and every ward, attendance, spell, roster, census and surveillance row of those facilities). They can read only their own mapping rows.",
        "tablePermissions": [
          {
            "name": "Facility",
            "filterExpression": "'Facility'[Facility Key]\n    IN CALCULATETABLE (\n        VALUES ( 'Security User Facility'[Facility Key] ),\n        'Security User Facility'[User Principal Name] = LOWER ( USERPRINCIPALNAME () )\n    )"
          },
          {
            "name": "Security User Facility",
            "filterExpression": "'Security User Facility'[User Principal Name] = LOWER ( USERPRINCIPALNAME () )"
          }
        ]
      },
      {
        "name": "North-East Zone (static)",
        "modelPermission": "read",
        "description": "Static RLS: the North-East malaria task team sees Zambezi and the two Kavango regions only.",
        "tablePermissions": [
          {
            "name": "Region",
            "filterExpression": "'Region'[Zone] = \"North-East\""
          }
        ]
      },
      {
        "name": "Surveillance Partner (aggregate only)",
        "modelPermission": "read",
        "description": "Object-level security for the MoHSS surveillance unit: patient-level tables (attendances, spells, patients, model outputs on patients, the access list) are invisible - not just empty. Aggregated IDSR, population and weather data only.",
        "tablePermissions": [
          {
            "name": "Attendance",
            "metadataPermission": "none"
          },
          {
            "name": "Admission",
            "metadataPermission": "none"
          },
          {
            "name": "Patient",
            "metadataPermission": "none"
          },
          {
            "name": "Readmission Deciles",
            "metadataPermission": "none"
          },
          {
            "name": "Readmission Drivers",
            "metadataPermission": "none"
          },
          {
            "name": "Security User Facility",
            "metadataPermission": "none"
          }
        ]
      }
    ],
