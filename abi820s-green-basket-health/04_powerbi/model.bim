          },
          {
            "name": "Tests Positive",
            "dataType": "int64",
            "sourceColumn": "tests_positive",
            "isHidden": true,
            "description": "Positive malaria tests (additive). Source: IDSR return (SV05)",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
