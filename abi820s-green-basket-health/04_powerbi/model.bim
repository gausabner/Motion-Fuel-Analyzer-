      {
        "name": "DQ Summary",
        "description": "Data-quality rule catalogue with the number of issues logged (counts only, no record keys); disconnected.",
        "columns": [
          {
            "name": "Rule Code",
            "dataType": "string",
            "sourceColumn": "rule_code",
            "description": "Data-quality rule identifier (catalogue audit.dq_rule).",
            "summarizeBy": "none"
          },
          {
            "name": "Rule",
            "dataType": "string",
            "sourceColumn": "rule_name",
            "description": "What the rule detects.",
            "summarizeBy": "none"
          },
          {
            "name": "DQ Dimension",
            "dataType": "string",
            "sourceColumn": "dq_dimension",
            "description": "Completeness, uniqueness, validity, accuracy, consistency or timeliness.",
            "summarizeBy": "none"
          },
          {
            "name": "Source Object",
            "dataType": "string",
            "sourceColumn": "source_object",
            "description": "Source file or table the rule checks.",
            "summarizeBy": "none"
          },
          {
            "name": "Action",
            "dataType": "string",
            "sourceColumn": "action",
            "description": "REJECT, CORRECT, MAP, IMPUTE, FLAG, KEEP LATEST or INFER.",
            "summarizeBy": "none"
          },
          {
            "name": "Owner Role",
            "dataType": "string",
            "sourceColumn": "owner_role",
            "description": "Data steward accountable for the rule and its issue queue.",
            "summarizeBy": "none"
          },
          {
            "name": "Issues",
            "dataType": "int64",
            "sourceColumn": "issues",
            "isHidden": true,
            "summarizeBy": "sum"
          },
          {
            "name": "Last Batch",
            "dataType": "int64",
            "sourceColumn": "last_batch",
            "description": "Latest load batch that logged an issue for the rule.",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DQ Summary",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing\n    ReadCsv = (file as text) as table =>\n        let\n            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])\n        in\n            Table.ReplaceValue(Raw, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),\n    Source = if SourceMode = \"CSV\"\n        then ReadCsv(\"v_dq_summary.csv.gz\")\n        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = \"mart\", Item = \"v_dq_summary\"]}[Data],\n    Typed = Table.TransformColumnTypes(Source, {{\"rule_code\", type text}, {\"rule_name\", type text}, {\"dq_dimension\", type text}, {\"source_object\", type text}, {\"action\", type text}, {\"owner_role\", type text}, {\"issues\", Int64.Type}, {\"last_batch\", Int64.Type}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      },
      {
        "name": "Reconciliation",
        "description": "Reconciliation checks of the latest load batch (row counts, control totals, cross-source); disconnected.",
        "columns": [
          {
            "name": "Check Code",
            "dataType": "string",
            "sourceColumn": "check_code",
            "description": "Reconciliation check identifier (R01-R22).",
            "summarizeBy": "none"
          },
          {
            "name": "Check",
            "dataType": "string",
            "sourceColumn": "check_name",
            "description": "What is compared.",
            "summarizeBy": "none"
          },
          {
            "name": "Check Type",
            "dataType": "string",
            "sourceColumn": "check_type",
            "description": "Row count, control total, cross-source, integrity, completeness, referential or plausibility.",
            "summarizeBy": "none"
          },
          {
            "name": "Source Value",
            "dataType": "double",
            "sourceColumn": "source_value",
            "formatString": "#,0",
            "description": "Value on the source / staging side.",
            "summarizeBy": "none"
          },
          {
            "name": "Target Value",
            "dataType": "double",
            "sourceColumn": "target_value",
            "formatString": "#,0",
            "description": "Value on the warehouse side.",
            "summarizeBy": "none"
          },
          {
            "name": "Difference",
            "dataType": "double",
            "sourceColumn": "difference",
            "formatString": "#,0",
            "description": "Target minus source.",
            "summarizeBy": "none"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "status",
            "description": "PASS, WARN (explained, within tolerance) or FAIL (stops publication).",
            "summarizeBy": "none"
          },
          {
            "name": "Explanation",
            "dataType": "string",
            "sourceColumn": "explanation",
            "description": "Business explanation of any difference.",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Reconciliation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing\n    ReadCsv = (file as text) as table =>\n        let\n            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])\n        in\n            Table.ReplaceValue(Raw, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),\n    Source = if SourceMode = \"CSV\"\n        then ReadCsv(\"v_recon_latest.csv.gz\")\n        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = \"mart\", Item = \"v_recon_latest\"]}[Data],\n    Typed = Table.TransformColumnTypes(Source, {{\"check_code\", type text}, {\"check_name\", type text}, {\"check_type\", type text}, {\"source_value\", type number}, {\"target_value\", type number}, {\"difference\", type number}, {\"status\", type text}, {\"explanation\", type text}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      },
      {
        "name": "Security User Facility",
        "description": "Dynamic RLS mapping: user principal name -> facility (disconnected; read only by the Facility Manager role).",
        "columns": [
          {
            "name": "User Principal Name",
            "dataType": "string",
            "sourceColumn": "user_principal_name",
            "description": "Entra ID UPN in lower case, compared with LOWER(USERPRINCIPALNAME()).",
            "summarizeBy": "none"
          },
          {
            "name": "Facility Key",
            "dataType": "int64",
            "sourceColumn": "facility_key",
            "description": "Surrogate key (-1 = Unknown). Source: generated",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Security User Facility",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing\n    ReadCsv = (file as text) as table =>\n        let\n            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])\n        in\n            Table.ReplaceValue(Raw, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),\n    Source = if SourceMode = \"CSV\"\n        then ReadCsv(\"v_sec_user_facility.csv.gz\")\n        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = \"mart\", Item = \"v_sec_user_facility\"]}[Data],\n    Typed = Table.TransformColumnTypes(Source, {{\"user_principal_name\", type text}, {\"facility_key\", Int64.Type}}, \"en-US\")\nin\n    Typed"
            }
          }
        ],
        "isHidden": true
      },
      {
        "name": "Metric Selector",
        "description": "Field parameter: lets users switch the metric shown in a visual.",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Metric",
            "dataType": "string",
            "isNameInferred": false,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value1]",
            "sortByColumn": "Metric Order",
            "relatedColumnDetails": {
              "groupByColumns": [
                {
                  "groupingColumn": "Metric Fields"
                }
              ]
            },
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Metric Fields",
            "dataType": "string",
            "isHidden": true,
            "isNameInferred": false,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value2]",
            "sortByColumn": "Metric Order",
            "extendedProperties": [
              {
                "type": "json",
                "name": "ParameterMetadata",
                "value": {
                  "version": 3,
                  "kind": 2
                }
              }
            ],
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Metric Order",
            "dataType": "int64",
            "isHidden": true,
            "isNameInferred": false,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value3]",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Metric Selector",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "{\n    ( \"ED Attendances\", NAMEOF ( '_Measures'[ED Attendances] ), 0 ),\n    ( \"Seen Within Target %\", NAMEOF ( '_Measures'[Seen Within Target %] ), 1 ),\n    ( \"Median Door-to-Doctor (min)\", NAMEOF ( '_Measures'[Median Door-to-Doctor (min)] ), 2 ),\n    ( \"LWBS Rate %\", NAMEOF ( '_Measures'[LWBS Rate %] ), 3 ),\n    ( \"Bed Occupancy %\", NAMEOF ( '_Measures'[Bed Occupancy %] ), 4 ),\n    ( \"ALOS (days)\", NAMEOF ( '_Measures'[ALOS (days)] ), 5 ),\n    ( \"Readmission Rate 30d %\", NAMEOF ( '_Measures'[Readmission Rate 30d %] ), 6 ),\n    ( \"NHPPD\", NAMEOF ( '_Measures'[NHPPD] ), 7 ),\n    ( \"Malaria Cases\", NAMEOF ( '_Measures'[Malaria Cases] ), 8 )\n}"
            }
          }
        ]
      }
    ],
