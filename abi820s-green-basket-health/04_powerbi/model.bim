          },
          {
            "name": "Diagnosis Key",
            "dataType": "int64",
            "sourceColumn": "diagnosis_key",
            "isHidden": true,
            "description": "FK to dim_diagnosis (primary diagnosis, -1 not coded/invalid). Source: PAS primary_icd10 (EN07, EN08)",
            "summarizeBy": "none"
          },
          {
            "name": "Triage Key",
            "dataType": "int64",
            "sourceColumn": "triage_key",
            "isHidden": true,
            "description": "FK to dim_triage (-1 not recorded; 9 clinic attendance). Source: PAS triage_category (EN04, EN09)",
            "summarizeBy": "none"
          },
          {
            "name": "Encounter Profile Key",
            "dataType": "int64",
            "sourceColumn": "encounter_profile_key",
            "isHidden": true,
