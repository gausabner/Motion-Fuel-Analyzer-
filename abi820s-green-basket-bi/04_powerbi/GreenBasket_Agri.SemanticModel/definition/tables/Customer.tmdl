/// Customer, SCD Type 2 on channel / credit terms / key account; geography flattened (customer role) to avoid an ambiguous path from Region.
table Customer

	column 'Customer Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: customer_key

	column 'Customer Code'
		dataType: string
		summarizeBy: none
		sourceColumn: customer_code

	column Customer
		dataType: string
		summarizeBy: none
		sourceColumn: customer_name

	column 'Customer Type'
		dataType: string
		summarizeBy: none
		sourceColumn: customer_type

	/// As-was sales channel at invoice date.
	column Channel
		dataType: string
		summarizeBy: none
		sourceColumn: channel

	column 'Credit Terms (days)'
		dataType: int64
		summarizeBy: none
		sourceColumn: credit_terms_days

	column 'Key Account'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_key_account

	column Town
		dataType: string
		dataCategory: City
		summarizeBy: none
		sourceColumn: town

	column 'Customer Region'
		dataType: string
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: customer_region

	column 'Customer Zone'
		dataType: string
		summarizeBy: none
		sourceColumn: customer_zone

	column Country
		dataType: string
		dataCategory: Country
		summarizeBy: none
		sourceColumn: country_name

	column 'Market Group'
		dataType: string
		summarizeBy: none
		sourceColumn: market_group

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: customer_status

	column 'Is Inferred Member'
		dataType: boolean
		displayFolder: SCD history
		summarizeBy: none
		sourceColumn: is_inferred

	/// K-means segment (03_analytics/clustering.py).
	column 'Customer Segment'
		dataType: string
		summarizeBy: none
		sourceColumn: customer_segment

	column 'Channel (Current)'
		dataType: string
		displayFolder: As-is (current)
		summarizeBy: none
		sourceColumn: channel_current

	column 'SCD Version'
		dataType: int64
		displayFolder: SCD history
		summarizeBy: none
		sourceColumn: scd_version

	column 'Is Current Version'
		dataType: boolean
		displayFolder: SCD history
		summarizeBy: none
		sourceColumn: scd_is_current

	partition Customer = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("dim_customer.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "dim_customer"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"customer_key", Int64.Type}, {"customer_code", type text}, {"customer_name", type text}, {"customer_type", type text}, {"channel", type text}, {"credit_terms_days", Int64.Type}, {"is_key_account", type logical}, {"town", type text}, {"customer_region", type text}, {"customer_zone", type text}, {"country_name", type text}, {"market_group", type text}, {"customer_status", type text}, {"is_inferred", type logical}, {"customer_segment", type text}, {"channel_current", type text}, {"scd_version", Int64.Type}, {"scd_is_current", type logical}}, "en-US")
				in
				    Typed

