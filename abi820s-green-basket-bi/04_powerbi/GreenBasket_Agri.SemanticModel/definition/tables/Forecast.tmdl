/// Back-test and forward forecasts from 03_analytics/forecasting.py.
table Forecast

	column 'Month Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_date_key

	column 'Crop Category Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: crop_category_key

	column Model
		dataType: string
		summarizeBy: none
		sourceColumn: model_name

	column Scenario
		dataType: string
		summarizeBy: none
		sourceColumn: scenario

	column Actual
		dataType: decimal
		isHidden
		formatString: "N$" #,0
		summarizeBy: sum
		sourceColumn: actual_net_revenue_nad

	column Forecast
		dataType: decimal
		isHidden
		formatString: "N$" #,0
		summarizeBy: sum
		sourceColumn: forecast_net_revenue_nad

	column 'Lower 80'
		dataType: decimal
		isHidden
		formatString: "N$" #,0
		summarizeBy: sum
		sourceColumn: lower_80_nad

	column 'Upper 80'
		dataType: decimal
		isHidden
		formatString: "N$" #,0
		summarizeBy: sum
		sourceColumn: upper_80_nad

	column 'Lower 95'
		dataType: decimal
		isHidden
		formatString: "N$" #,0
		summarizeBy: sum
		sourceColumn: lower_95_nad

	column 'Upper 95'
		dataType: decimal
		isHidden
		formatString: "N$" #,0
		summarizeBy: sum
		sourceColumn: upper_95_nad

	partition Forecast = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("fact_forecast_monthly.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "fact_forecast_monthly"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"month_date_key", Int64.Type}, {"crop_category_key", Int64.Type}, {"model_name", type text}, {"scenario", type text}, {"actual_net_revenue_nad", Currency.Type}, {"forecast_net_revenue_nad", Currency.Type}, {"lower_80_nad", Currency.Type}, {"upper_80_nad", Currency.Type}, {"lower_95_nad", Currency.Type}, {"upper_95_nad", Currency.Type}}, "en-US")
				in
				    Typed

