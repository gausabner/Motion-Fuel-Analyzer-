/// Harvest records (grain: farm x crop x block x day).
table Harvest

	column 'Harvest Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: harvest_date_key

	column 'Farm Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: farm_key

	column 'Crop Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: crop_key

	column 'Harvested (kg)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: harvested_kg

	column 'Is Corrected'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_corrected

	partition Harvest = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("fact_harvest.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "fact_harvest"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"harvest_date_key", Int64.Type}, {"farm_key", Int64.Type}, {"crop_key", Int64.Type}, {"harvested_kg", type number}, {"is_corrected", type logical}}, "en-US")
				in
				    Typed

