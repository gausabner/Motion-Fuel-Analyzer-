/// Accumulating snapshot (grain: field block x crop cycle). Active date = planting; inactive role-playing dates for first/last harvest and season end.
table 'Crop Cycle'

	column 'Cycle ID'
		dataType: string
		summarizeBy: none
		sourceColumn: cycle_id

	column 'Block ID'
		dataType: string
		summarizeBy: none
		sourceColumn: block_id

	column 'Farm Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: farm_key

	column 'Crop Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: crop_key

	column 'Planting Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: planting_date_key

	column 'First Harvest Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: first_harvest_date_key

	column 'Last Harvest Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: last_harvest_date_key

	column 'Harvest Season End Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: harvest_season_end_date_key

	column 'Cycle Status'
		dataType: string
		summarizeBy: none
		sourceColumn: cycle_status

	column 'Irrigation Method'
		dataType: string
		summarizeBy: none
		sourceColumn: irrigation_method

	column 'Is Irrigated Block'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_irrigated

	column 'Planted (ha)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: planted_ha

	column 'Harvested (ha)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: harvested_ha

	column 'Planned Production (kg)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: planned_production_kg

	column 'Harvested (kg)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: harvested_kg

	column 'Days to First Harvest'
		dataType: int64
		isHidden
		summarizeBy: average
		sourceColumn: days_to_first_harvest

	column 'Direct Cost'
		dataType: decimal
		isHidden
		formatString: "N$" #,0
		summarizeBy: sum
		sourceColumn: direct_cost_nad

	column 'Fertiliser (kg)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: fertiliser_kg

	partition 'Crop Cycle' = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("fact_crop_cycle.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "fact_crop_cycle"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"cycle_id", type text}, {"block_id", type text}, {"farm_key", Int64.Type}, {"crop_key", Int64.Type}, {"planting_date_key", Int64.Type}, {"first_harvest_date_key", Int64.Type}, {"last_harvest_date_key", Int64.Type}, {"harvest_season_end_date_key", Int64.Type}, {"cycle_status", type text}, {"irrigation_method", type text}, {"is_irrigated", type logical}, {"planted_ha", type number}, {"harvested_ha", type number}, {"planned_production_kg", type number}, {"harvested_kg", type number}, {"days_to_first_harvest", Int64.Type}, {"direct_cost_nad", Currency.Type}, {"fertiliser_kg", type number}}, "en-US")
				in
				    Typed

