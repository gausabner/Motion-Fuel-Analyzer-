/// NSA / MAFWLR regional crop estimates (benchmark).
table 'Crop Estimate'

	column 'Season End Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: season_end_date_key

	column 'Region Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: region_key

	column 'Crop Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: crop_key

	column 'Farming Sector'
		dataType: string
		summarizeBy: none
		sourceColumn: farming_sector

	column 'Area Planted (ha)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: area_planted_ha

	column 'Production (t)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: production_t

	partition 'Crop Estimate' = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("fact_crop_estimate.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "fact_crop_estimate"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"season_end_date_key", Int64.Type}, {"region_key", Int64.Type}, {"crop_key", Int64.Type}, {"farming_sector", type text}, {"area_planted_ha", type number}, {"production_t", type number}}, "en-US")
				in
				    Typed

