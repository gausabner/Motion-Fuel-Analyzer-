/// Namibia's 14 regions (ISO 3166-2:NA) with Green Basket management zone; also the grain of NSA crop estimates.
table Region

	column 'Region Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: region_key

	column 'Region Code'
		dataType: string
		summarizeBy: none
		sourceColumn: region_code

	column Region
		dataType: string
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: region_name

	column 'Zone Code'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: zone_code

	column Zone
		dataType: string
		summarizeBy: none
		sourceColumn: zone_name

	column 'Capital Town'
		dataType: string
		dataCategory: City
		summarizeBy: none
		sourceColumn: capital_town

	column 'Is Northern Crop Region'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_northern_crop_region

	hierarchy Geography

		level Zone
			column: Zone

		level Region
			column: Region

	partition Region = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("dim_region.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "dim_region"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"region_key", Int64.Type}, {"region_code", type text}, {"region_name", type text}, {"zone_code", type text}, {"zone_name", type text}, {"capital_town", type text}, {"is_northern_crop_region", type logical}}, "en-US")
				in
				    Typed

