/// NASA POWER daily weather per farm location (rainfall averaged across locations, never summed).
table Weather

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column 'Farm Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: farm_key

	column 'Rainfall (mm)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: rainfall_mm

	column 'Max Temp (C)'
		dataType: double
		isHidden
		summarizeBy: average
		sourceColumn: t_max_c

	column 'Min Temp (C)'
		dataType: double
		isHidden
		summarizeBy: average
		sourceColumn: t_min_c

	column 'Heat Day'
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: heat_day

	partition Weather = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("fact_weather_daily.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "fact_weather_daily"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"date_key", Int64.Type}, {"farm_key", Int64.Type}, {"rainfall_mm", type number}, {"t_max_c", type number}, {"t_min_c", type number}, {"heat_day", Int64.Type}}, "en-US")
				in
				    Typed

