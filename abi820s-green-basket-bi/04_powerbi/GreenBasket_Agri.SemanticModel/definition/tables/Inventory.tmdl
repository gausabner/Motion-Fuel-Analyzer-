/// Monthly stock snapshot (semi-additive: use the Closing Stock measures, never SUM over time).
table Inventory

	column 'Snapshot Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: snapshot_date_key

	column 'Farm Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: farm_key

	column 'Product Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	column 'Opening Stock (kg)'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: opening_stock_kg

	column 'Received (kg)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: received_kg

	column 'Dispatched (kg)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: dispatched_kg

	column 'Shrinkage (kg)'
		dataType: double
		isHidden
		summarizeBy: sum
		sourceColumn: shrinkage_kg

	column 'Closing Stock (kg)'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: closing_stock_kg

	column 'Closing Stock Value'
		dataType: decimal
		isHidden
		formatString: "N$" #,0
		summarizeBy: none
		sourceColumn: closing_stock_value_nad

	partition Inventory = m
		mode: import
		source =
				let
				    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
				    ReadCsv = (file as text) as table =>
				        let
				            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
				        in
				            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
				    Source = if SourceMode = "CSV"
				        then ReadCsv("fact_inventory_monthly.csv.gz")
				        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "fact_inventory_monthly"]}[Data],
				    Typed = Table.TransformColumnTypes(Source, {{"snapshot_date_key", Int64.Type}, {"farm_key", Int64.Type}, {"product_key", Int64.Type}, {"opening_stock_kg", type number}, {"received_kg", type number}, {"dispatched_kg", type number}, {"shrinkage_kg", type number}, {"closing_stock_kg", type number}, {"closing_stock_value_nad", Currency.Type}}, "en-US")
				in
				    Typed

