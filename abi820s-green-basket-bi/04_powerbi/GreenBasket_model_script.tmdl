// Green Basket semantic model - TMDL script for Power BI Desktop TMDL view (createOrReplace).
// Usage: blank report > TMDL view > new tab > paste all > Apply > then Home > Refresh.

createOrReplace

	expression PgServer = "localhost:5432" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

		annotation PBI_ResultType = Text

	expression PgDatabase = "green_basket_dw" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

		annotation PBI_ResultType = Text

	expression SourceMode = "PostgreSQL" meta [IsParameterQuery = true, List = {"PostgreSQL", "CSV"}, DefaultValue = "PostgreSQL", Type = "Text", IsParameterQueryRequired = true]

		annotation PBI_ResultType = Text

	expression CsvFolder = "C:\GreenBasket\04_powerbi\data_csv\" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

		annotation PBI_ResultType = Text

	expression RangeStart = #datetime(2020, 1, 1, 0, 0, 0) meta [IsParameterQuery = true, Type = "DateTime", IsParameterQueryRequired = true]

		annotation PBI_ResultType = DateTime

	expression RangeEnd = #datetime(2027, 1, 1, 0, 0, 0) meta [IsParameterQuery = true, Type = "DateTime", IsParameterQueryRequired = true]

		annotation PBI_ResultType = DateTime


	/// World Bank Pink Sheet series (output and input prices).
	table Commodity

		column 'Commodity Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: commodity_key

		column 'Commodity Code'
			dataType: string
			summarizeBy: none
			sourceColumn: commodity_code

		column Commodity
			dataType: string
			summarizeBy: none
			sourceColumn: commodity_name

		column 'Price Unit'
			dataType: string
			summarizeBy: none
			sourceColumn: price_unit

		column 'Commodity Role'
			dataType: string
			summarizeBy: none
			sourceColumn: commodity_role

		partition Commodity = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("dim_commodity.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "dim_commodity"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"commodity_key", Int64.Type}, {"commodity_code", type text}, {"commodity_name", type text}, {"price_unit", type text}, {"commodity_role", type text}}, "en-US")
					in
					    Typed


	/// Production cost category with cost group and behaviour.
	table 'Cost Category'

		column 'Cost Category Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: cost_category_key

		column 'Cost Category Code'
			dataType: string
			summarizeBy: none
			sourceColumn: cost_category_code

		column 'Cost Category'
			dataType: string
			summarizeBy: none
			sourceColumn: cost_category_name

		column 'Cost Group'
			dataType: string
			summarizeBy: none
			sourceColumn: cost_group

		column 'Cost Behaviour'
			dataType: string
			summarizeBy: none
			sourceColumn: cost_behaviour

		column 'Is Crop Specific'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_crop_specific

		partition 'Cost Category' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("dim_cost_category.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "dim_cost_category"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"cost_category_key", Int64.Type}, {"cost_category_code", type text}, {"cost_category_name", type text}, {"cost_group", type text}, {"cost_behaviour", type text}, {"is_crop_specific", type logical}}, "en-US")
					in
					    Typed


	/// Top of the product snowflake: Cereals & grains, Vegetables, Fruit.
	table 'Crop Category'

		column 'Crop Category Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: crop_category_key

		column 'Category Code'
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: category_code

		column 'Crop Category'
			dataType: string
			summarizeBy: none
			sourceColumn: category_name

		column Sector
			dataType: string
			summarizeBy: none
			sourceColumn: sector

		partition 'Crop Category' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("dim_crop_category.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "dim_crop_category"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"crop_category_key", Int64.Type}, {"category_code", type text}, {"category_name", type text}, {"sector", type text}}, "en-US")
					in
					    Typed


	/// Accumulating snapshot (grain: field block x crop cycle). Active date = planting; inactive role-playing dates for first/last harvest and season end.
	table 'Crop Cycle'

		column 'Cycle ID'
			dataType: string
			summarizeBy: none
			sourceColumn: cycle_id

		column 'Block ID'
			dataType: string
			summarizeBy: none
			sourceColumn: block_id

		column 'Farm Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: farm_key

		column 'Crop Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: crop_key

		column 'Planting Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: planting_date_key

		column 'First Harvest Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: first_harvest_date_key

		column 'Last Harvest Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: last_harvest_date_key

		column 'Harvest Season End Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: harvest_season_end_date_key

		column 'Cycle Status'
			dataType: string
			summarizeBy: none
			sourceColumn: cycle_status

		column 'Irrigation Method'
			dataType: string
			summarizeBy: none
			sourceColumn: irrigation_method

		column 'Is Irrigated Block'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_irrigated

		column 'Planted (ha)'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: planted_ha

		column 'Harvested (ha)'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: harvested_ha

		column 'Planned Production (kg)'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: planned_production_kg

		column 'Harvested (kg)'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: harvested_kg

		column 'Days to First Harvest'
			dataType: int64
			isHidden
			summarizeBy: average
			sourceColumn: days_to_first_harvest

		column 'Direct Cost'
			dataType: decimal
			isHidden
			formatString: "N$" #,0
			summarizeBy: sum
			sourceColumn: direct_cost_nad

		column 'Fertiliser (kg)'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: fertiliser_kg

		partition 'Crop Cycle' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("fact_crop_cycle.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "fact_crop_cycle"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"cycle_id", type text}, {"block_id", type text}, {"farm_key", Int64.Type}, {"crop_key", Int64.Type}, {"planting_date_key", Int64.Type}, {"first_harvest_date_key", Int64.Type}, {"last_harvest_date_key", Int64.Type}, {"harvest_season_end_date_key", Int64.Type}, {"cycle_status", type text}, {"irrigation_method", type text}, {"is_irrigated", type logical}, {"planted_ha", type number}, {"harvested_ha", type number}, {"planned_production_kg", type number}, {"harvested_kg", type number}, {"days_to_first_harvest", Int64.Type}, {"direct_cost_nad", Currency.Type}, {"fertiliser_kg", type number}}, "en-US")
					in
					    Typed


	/// NSA / MAFWLR regional crop estimates (benchmark).
	table 'Crop Estimate'

		column 'Season End Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: season_end_date_key

		column 'Region Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: region_key

		column 'Crop Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: crop_key

		column 'Farming Sector'
			dataType: string
			summarizeBy: none
			sourceColumn: farming_sector

		column 'Area Planted (ha)'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: area_planted_ha

		column 'Production (t)'
			dataType: double
			isHidden
			summarizeBy: sum
			sourceColumn: production_t

		partition 'Crop Estimate' = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("fact_crop_estimate.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "fact_crop_estimate"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"season_end_date_key", Int64.Type}, {"region_key", Int64.Type}, {"crop_key", Int64.Type}, {"farming_sector", type text}, {"area_planted_ha", type number}, {"production_t", type number}}, "en-US")
					in
					    Typed


	/// Crop; conformed rollup used by harvest, cost, cycle, market-price and NSA facts.
	table Crop

		column 'Crop Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: crop_key

		column 'Crop Code'
			dataType: string
			summarizeBy: none
			sourceColumn: crop_code

		column Crop
			dataType: string
			summarizeBy: none
			sourceColumn: crop_name

		column 'Crop Category Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: crop_category_key

		column 'NAB Controlled'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_nab_controlled

		column 'Storage Type'
			dataType: string
			summarizeBy: none
			sourceColumn: storage_type

		column 'Shelf Life (days)'
			dataType: int64
			summarizeBy: none
			sourceColumn: shelf_life_days

		partition Crop = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("dim_crop.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "dim_crop"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"crop_key", Int64.Type}, {"crop_code", type text}, {"crop_name", type text}, {"crop_category_key", Int64.Type}, {"is_nab_controlled", type logical}, {"storage_type", type text}, {"shelf_life_days", Int64.Type}}, "en-US")
					in
					    Typed


	/// Customer, SCD Type 2 on channel / credit terms / key account; geography flattened (customer role) to avoid an ambiguous path from Region.
	table Customer

		column 'Customer Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: customer_key

		column 'Customer Code'
			dataType: string
			summarizeBy: none
			sourceColumn: customer_code

		column Customer
			dataType: string
			summarizeBy: none
			sourceColumn: customer_name

		column 'Customer Type'
			dataType: string
			summarizeBy: none
			sourceColumn: customer_type

		/// As-was sales channel at invoice date.
		column Channel
			dataType: string
			summarizeBy: none
			sourceColumn: channel

		column 'Credit Terms (days)'
			dataType: int64
			summarizeBy: none
			sourceColumn: credit_terms_days

		column 'Key Account'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_key_account

		column Town
			dataType: string
			dataCategory: City
			summarizeBy: none
			sourceColumn: town

		column 'Customer Region'
			dataType: string
			dataCategory: StateOrProvince
			summarizeBy: none
			sourceColumn: customer_region

		column 'Customer Zone'
			dataType: string
			summarizeBy: none
			sourceColumn: customer_zone

		column Country
			dataType: string
			dataCategory: Country
			summarizeBy: none
			sourceColumn: country_name

		column 'Market Group'
			dataType: string
			summarizeBy: none
			sourceColumn: market_group

		column Status
			dataType: string
			summarizeBy: none
			sourceColumn: customer_status

		column 'Is Inferred Member'
			dataType: boolean
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: is_inferred

		/// K-means segment (03_analytics/clustering.py).
		column 'Customer Segment'
			dataType: string
			summarizeBy: none
			sourceColumn: customer_segment

		column 'Channel (Current)'
			dataType: string
			displayFolder: As-is (current)
			summarizeBy: none
			sourceColumn: channel_current

		column 'SCD Version'
			dataType: int64
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: scd_version

		column 'Is Current Version'
			dataType: boolean
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: scd_is_current

		partition Customer = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("dim_customer.csv.gz")
					        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "dim_customer"]}[Data],
					    Typed = Table.TransformColumnTypes(Source, {{"customer_key", Int64.Type}, {"customer_code", type text}, {"customer_name", type text}, {"customer_type", type text}, {"channel", type text}, {"credit_terms_days", Int64.Type}, {"is_key_account", type logical}, {"town", type text}, {"customer_region", type text}, {"customer_zone", type text}, {"country_name", type text}, {"market_group", type text}, {"customer_status", type text}, {"is_inferred", type logical}, {"customer_segment", type text}, {"channel_current", type text}, {"scd_version", Int64.Type}, {"scd_is_current", type logical}}, "en-US")
					in
					    Typed


	/// Conformed calendar (2020-2027) with calendar, fiscal (Apr-Mar) and agricultural season (Oct-Sep) attributes. Marked as date table.
	table Date
		dataCategory: Time

		column 'Date Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: date_key

		column Date
			dataType: dateTime
			isKey
			formatString: dd mmm yyyy
			summarizeBy: none
			sourceColumn: full_date

		column 'Day of Month'
			dataType: int64
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: day_of_month

		column 'Day of Week'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: day_of_week_iso

		column 'Day Name'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: day_name
			sortByColumn: 'Day of Week'

		column 'Day Short'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: day_short
			sortByColumn: 'Day of Week'

		column 'Is Weekend'
			dataType: boolean
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: is_weekend

		column 'Is Public Holiday'
			dataType: boolean
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: is_public_holiday

		column 'Holiday Name'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: holiday_name

		column 'Is Working Day'
			dataType: boolean
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: is_working_day

		column 'ISO Week'
			dataType: int64
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: iso_week

		column 'Week Start'
			dataType: dateTime
			formatString: dd mmm yyyy
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: week_start_date

		column 'Month Number'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: month_num

		column 'Month Name'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: month_name
			sortByColumn: 'Month Number'

		column 'Month Short'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: month_short
			sortByColumn: 'Month Number'

		column 'Year Month'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: year_month
			sortByColumn: 'Year Month Key'

		column 'Year Month Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: year_month_key

		column 'Month Start'
			dataType: dateTime
			formatString: mmm yyyy
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: month_start_date

		column 'Month End'
			dataType: dateTime
			formatString: dd mmm yyyy
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: month_end_date

		column 'Is Month End'
			dataType: boolean
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: is_month_end

		column 'Quarter Number'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: quarter_num

		column 'Year Quarter'
			dataType: string
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: year_quarter

		column 'Calendar Year'
			dataType: int64
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: calendar_year

		column 'Fiscal Year Number'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: fiscal_year

		column 'Fiscal Year'
			dataType: string
			displayFolder: Fiscal (Apr-Mar)
			summarizeBy: none
			sourceColumn: fiscal_year_label

		column 'Fiscal Quarter Number'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: fiscal_quarter_num

		column 'Fiscal Quarter'
			dataType: string
			displayFolder: Fiscal (Apr-Mar)
			summarizeBy: none
			sourceColumn: fiscal_quarter_label

		column 'Fiscal Month Number'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: fiscal_month_num

		column 'Fiscal Month'
			dataType: string
			displayFolder: Fiscal (Apr-Mar)
			summarizeBy: none
			sourceColumn: fiscal_month_name
			sortByColumn: 'Fiscal Month Number'

		column 'Crop Season Start Year'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: crop_season_start_year

		column 'Crop Season'
			dataType: string
			displayFolder: Agricultural season (Oct-Sep)
			summarizeBy: none
			sourceColumn: crop_season_label

		column 'Season Month Number'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: season_month_num

		column 'Is Current Month'
			dataType: boolean
			displayFolder: Calendar
			summarizeBy: none
			sourceColumn: is_current_month

		hierarchy 'Fiscal Calendar'

			level 'Fiscal Year'
				column: 'Fiscal Year'

			level 'Fiscal Quarter'
				column: 'Fiscal Quarter'

			level 'Year Month'
				column: 'Year Month'

			level Date
				column: Date

		hierarchy Calendar

			level 'Calendar Year'
				column: 'Calendar Year'

			level 'Year Quarter'
				column: 'Year Quarter'

			level 'Year Month'
				column: 'Year Month'

			level Date
				column: Date

		hierarchy 'Agricultural Season'

			level 'Crop Season'
				column: 'Crop Season'

			level 'Year Month'
				column: 'Year Month'

			level Date
				column: Date

		partition Date = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
					        let
					            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])
					        in
					            Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),
					    Source = if SourceMode = "CSV"
					        then ReadCsv("dim_date.csv.gz")
