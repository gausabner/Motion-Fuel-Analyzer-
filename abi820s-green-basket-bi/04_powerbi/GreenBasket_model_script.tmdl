	/// Farm unit, SCD Type 2: one row per version; facts carry the version valid at the event date (as-was). '... (Current)' columns give as-is values.
	table Farm

		column 'Farm Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: farm_key

		column 'Farm Code'
			dataType: string
			summarizeBy: none
			sourceColumn: farm_code

		column Farm
			dataType: string
			summarizeBy: none
			sourceColumn: farm_name

		column 'Region Key'
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: region_key

		/// Used by the Zone Manager RLS role.
		column 'Zone Code'
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: zone_code

		column Town
			dataType: string
			dataCategory: City
			summarizeBy: none
			sourceColumn: town

		column Latitude
			dataType: double
			dataCategory: Latitude
			summarizeBy: none
			sourceColumn: latitude

		column Longitude
			dataType: double
			dataCategory: Longitude
			summarizeBy: none
			sourceColumn: longitude

		column 'Cultivated (ha)'
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: cultivated_ha

		/// As-was: irrigation system valid at the event date.
		column 'Irrigation Type'
			dataType: string
			summarizeBy: none
			sourceColumn: irrigation_type

		column 'Is Irrigated'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_irrigated

		column 'Water Source'
			dataType: string
			summarizeBy: none
			sourceColumn: water_source

		/// Pseudonymised employee code.
		column 'Farm Manager Code'
			dataType: string
			summarizeBy: none
			sourceColumn: farm_manager_code

		column 'GlobalGAP Certified'
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_globalgap_certified

		column 'Irrigation Type (Current)'
			dataType: string
			displayFolder: As-is (current)
			summarizeBy: none
			sourceColumn: irrigation_type_current

		column 'Farm Manager (Current)'
			dataType: string
			displayFolder: As-is (current)
			summarizeBy: none
			sourceColumn: farm_manager_current

		column 'SCD Version'
			dataType: int64
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: scd_version

		column 'Effective From'
			dataType: dateTime
			formatString: dd mmm yyyy
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: scd_effective_from

		column 'Effective To'
			dataType: dateTime
			formatString: dd mmm yyyy
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: scd_effective_to

		column 'Is Current Version'
			dataType: boolean
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: scd_is_current

		column 'Farm Version'
			dataType: string
			displayFolder: SCD history
			summarizeBy: none
			sourceColumn: farm_version_label

		partition Farm = m
			mode: import
			source =
					let
					    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing
					    ReadCsv = (file as text) as table =>
