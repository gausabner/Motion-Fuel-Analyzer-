	/// Field parameter: lets users switch the metric shown in a visual.
	table 'Metric Selector'

		column Metric
			summarizeBy: none
			sourceColumn: [Value1]
			sortByColumn: 'Metric Order'

			relatedColumnDetails
				groupByColumn: 'Metric Fields'

		column 'Metric Fields'
			isHidden
			summarizeBy: none
			sourceColumn: [Value2]
			sortByColumn: 'Metric Order'

			extendedProperty ParameterMetadata =
					{
					  "version": 3,
					  "kind": 2
					}

		column 'Metric Order'
			isHidden
			summarizeBy: sum
			sourceColumn: [Value3]

		partition 'Metric Selector' = calculated
			mode: import
			source =
					{
					    ( "Net Revenue", NAMEOF ( '_Measures'[Net Revenue] ), 0 ),
					    ( "Gross Margin", NAMEOF ( '_Measures'[Gross Margin] ), 1 ),
					    ( "Gross Margin %", NAMEOF ( '_Measures'[Gross Margin %] ), 2 ),
					    ( "Sales Volume (t)", NAMEOF ( '_Measures'[Sales Volume (t)] ), 3 ),
					    ( "Avg Realised Price (N$/kg)", NAMEOF ( '_Measures'[Avg Realised Price (N$/kg)] ), 4 ),
					    ( "Export Share %", NAMEOF ( '_Measures'[Export Share %] ), 5 )
					}


