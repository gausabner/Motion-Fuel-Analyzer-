// measures.dax - Green Basket semantic model measures (generated by build_pbip.py)
// Paste into DAX query view / Tabular Editor, or read alongside report section 3.4.

// [1 Sales] Invoice + credit-note revenue after discount, N$ (FX-converted).
MEASURE '_Measures'[Net Revenue] =
    SUM ( 'Sales'[Net Revenue] )

// [1 Sales] Revenue before discount, N$.
MEASURE '_Measures'[Gross Revenue] =
    SUM ( 'Sales'[Gross Revenue] )

// [1 Sales] Discounts granted, N$.
MEASURE '_Measures'[Discount] =
    SUM ( 'Sales'[Discount] )

// [1 Sales] Standard cost of goods sold, N$.
MEASURE '_Measures'[COGS] =
    SUM ( 'Sales'[COGS] )

// [1 Sales] Outbound freight borne by Green Basket, N$.
MEASURE '_Measures'[Freight Cost] =
    SUM ( 'Sales'[Freight Cost] )

// [1 Sales] Net revenue less COGS.
MEASURE '_Measures'[Gross Margin] =
    [Net Revenue] - [COGS]

// [1 Sales] Gross margin as a share of net revenue.
MEASURE '_Measures'[Gross Margin %] =
    DIVIDE ( [Gross Margin], [Net Revenue] )

// [1 Sales] Gross margin less outbound freight.
MEASURE '_Measures'[Contribution after Freight] =
    [Gross Margin] - [Freight Cost]

// [1 Sales] Tonnes invoiced (net of credit notes).
MEASURE '_Measures'[Sales Volume (t)] =
    DIVIDE ( SUM ( 'Sales'[Quantity (kg)] ), 1000 )

// [1 Sales] Net revenue per kg sold.
MEASURE '_Measures'[Avg Realised Price (N$/kg)] =
    DIVIDE ( [Net Revenue], SUM ( 'Sales'[Quantity (kg)] ) )

// [1 Sales] Number of document lines.
MEASURE '_Measures'[Invoice Lines] =
    COUNTROWS ( 'Sales' )

// [1 Sales] Distinct invoices and credit notes.
MEASURE '_Measures'[Invoices] =
    DISTINCTCOUNT ( 'Sales'[Invoice ID] )

// [1 Sales] Distinct customers (durable code) with sales in the context.
MEASURE '_Measures'[Active Customers] =
    CALCULATE ( DISTINCTCOUNT ( 'Customer'[Customer Code] ), 'Sales' )

// [1 Sales] Value credited for quality claims (positive number).
MEASURE '_Measures'[Credit Notes] =
    - CALCULATE ( [Net Revenue], KEEPFILTERS ( 'Sales'[Document Type] = "CRN" ) )

// [1 Sales] Credit notes as a share of invoiced revenue.
MEASURE '_Measures'[Credit Note Rate %] =
    DIVIDE ( [Credit Notes], CALCULATE ( [Net Revenue], KEEPFILTERS ( 'Sales'[Document Type] = "INV" ) ) )

// [1 Sales] Net revenue from customers in the Export channel (CALCULATE with filter modification).
MEASURE '_Measures'[Export Revenue] =
    CALCULATE ( [Net Revenue], KEEPFILTERS ( 'Customer'[Channel] = "Export" ) )

// [1 Sales] Export revenue as a share of net revenue.
MEASURE '_Measures'[Export Share %] =
    DIVIDE ( [Export Revenue], [Net Revenue] )

// [1 Sales] Share of the selection in total revenue across all crops (filters on the product hierarchy removed).
MEASURE '_Measures'[Revenue Share of All Crops %] =
    DIVIDE (
        [Net Revenue],
        CALCULATE ( [Net Revenue], REMOVEFILTERS ( 'Product' ), REMOVEFILTERS ( 'Crop' ), REMOVEFILTERS ( 'Crop Category' ) )
    )

// [1 Sales] Revenue concentration: share of the ten largest customers in the context.
MEASURE '_Measures'[Top 10 Customer Share %] =
    VAR _top10 =
        TOPN ( 10, VALUES ( 'Customer'[Customer Code] ), [Net Revenue] )
    RETURN
        DIVIDE ( CALCULATE ( [Net Revenue], _top10 ), [Net Revenue] )

// [2 Time Intelligence] Latest invoice date in the model (ignores date filters).
MEASURE '_Measures'[Last Sales Date] =
    VAR _k =
        CALCULATE ( MAX ( 'Sales'[Invoice Date Key] ), REMOVEFILTERS ( 'Date' ) )
    RETURN
        IF ( NOT ISBLANK ( _k ), DATE ( INT ( _k / 10000 ), MOD ( INT ( _k / 100 ), 100 ), MOD ( _k, 100 ) ) )

// [2 Time Intelligence] Fiscal year-to-date (year ends 31 March), no future guard.
MEASURE '_Measures'[Net Revenue FYTD Raw] =
    TOTALYTD ( [Net Revenue], 'Date'[Date], "3/31" )

// [2 Time Intelligence] Fiscal year-to-date net revenue; blank for periods after the last sale.
MEASURE '_Measures'[Net Revenue FYTD] =
    IF ( MIN ( 'Date'[Date] ) <= [Last Sales Date], [Net Revenue FYTD Raw] )

// [2 Time Intelligence] Same fiscal-YTD window one year earlier, cut at the same day (like-for-like).
MEASURE '_Measures'[Net Revenue FYTD PY] =
    VAR _cutoffPY =
        EDATE ( [Last Sales Date], -12 )
    RETURN
        CALCULATE (
            [Net Revenue FYTD Raw],
            SAMEPERIODLASTYEAR ( 'Date'[Date] ),
            KEEPFILTERS ( 'Date'[Date] <= _cutoffPY )
        )

// [2 Time Intelligence] Fiscal-YTD growth versus the like-for-like prior-year window.
MEASURE '_Measures'[Net Revenue FYTD YoY %] =
    DIVIDE ( [Net Revenue FYTD] - [Net Revenue FYTD PY], [Net Revenue FYTD PY] )

// [2 Time Intelligence] Net revenue in the same period last year.
MEASURE '_Measures'[Net Revenue PY] =
    CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )

// [2 Time Intelligence] Change versus the same period last year, N$.
MEASURE '_Measures'[Net Revenue YoY] =
    VAR _cur = [Net Revenue]
    VAR _py = [Net Revenue PY]
    RETURN
        IF ( NOT ISBLANK ( _cur ) && NOT ISBLANK ( _py ), _cur - _py )

// [2 Time Intelligence] Growth versus the same period last year.
MEASURE '_Measures'[Net Revenue YoY %] =
    VAR _cur = [Net Revenue]
    VAR _py = [Net Revenue PY]
    RETURN
        IF ( NOT ISBLANK ( _cur ) && NOT ISBLANK ( _py ), DIVIDE ( _cur - _py, _py ) )

// [2 Time Intelligence] Moving annual total: trailing 12 months ending at the context end (capped at the last sale).
MEASURE '_Measures'[Net Revenue MAT] =
    VAR _end =
        MIN ( MAX ( 'Date'[Date] ), [Last Sales Date] )
    RETURN
        IF (
            MIN ( 'Date'[Date] ) <= [Last Sales Date],
            CALCULATE ( [Net Revenue], DATESINPERIOD ( 'Date'[Date], _end, -12, MONTH ) )
        )

// [2 Time Intelligence] Average monthly net revenue over the trailing three months.
MEASURE '_Measures'[Net Revenue 3M Rolling Avg] =
    VAR _end =
        MIN ( MAX ( 'Date'[Date] ), [Last Sales Date] )
    RETURN
        IF (
            MIN ( 'Date'[Date] ) <= [Last Sales Date],
            DIVIDE ( CALCULATE ( [Net Revenue], DATESINPERIOD ( 'Date'[Date], _end, -3, MONTH ) ), 3 )
        )

// [2 Time Intelligence] Gross margin % in the same period last year.
MEASURE '_Measures'[Gross Margin % PY] =
    CALCULATE ( [Gross Margin %], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )

// [2 Time Intelligence] Tonnes by DISPATCH date - activates the inactive role-playing relationship.
MEASURE '_Measures'[Dispatched Volume (t)] =
    CALCULATE (
        DIVIDE ( SUM ( 'Sales'[Quantity (kg)] ), 1000 ),
        USERELATIONSHIP ( 'Sales'[Dispatch Date Key], 'Date'[Date Key] ),
        KEEPFILTERS ( 'Sales'[Document Type] = "INV" )
    )

// [3 Production & Yield] Field harvest in tonnes by harvest date.
MEASURE '_Measures'[Harvest (t)] =
    DIVIDE ( SUM ( 'Harvest'[Harvested (kg)] ), 1000 )

// [3 Production & Yield] Area planted (by planting date).
MEASURE '_Measures'[Planted Area (ha)] =
    SUM ( 'Crop Cycle'[Planted (ha)] )

// [3 Production & Yield] Harvest of completed cycles, by agricultural season of harvest.
MEASURE '_Measures'[Completed Harvest (t)] =
    CALCULATE (
        DIVIDE ( SUM ( 'Crop Cycle'[Harvested (kg)] ), 1000 ),
        KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = "Completed" ),
        USERELATIONSHIP ( 'Crop Cycle'[Harvest Season End Date Key], 'Date'[Date Key] )
    )

// [3 Production & Yield] Harvested area of completed cycles, by season of harvest.
MEASURE '_Measures'[Harvested Area (ha)] =
    CALCULATE (
        SUM ( 'Crop Cycle'[Harvested (ha)] ),
        KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = "Completed" ),
        USERELATIONSHIP ( 'Crop Cycle'[Harvest Season End Date Key], 'Date'[Date Key] )
    )

// [3 Production & Yield] Tonnes per harvested hectare (completed cycles).
MEASURE '_Measures'[Yield (t/ha)] =
    DIVIDE ( [Completed Harvest (t)], [Harvested Area (ha)] )

// [3 Production & Yield] Budgeted yield of the same completed cycles.
MEASURE '_Measures'[Planned Yield (t/ha)] =
    CALCULATE (
        DIVIDE ( SUM ( 'Crop Cycle'[Planned Production (kg)] ) / 1000, SUM ( 'Crop Cycle'[Planted (ha)] ) ),
        KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = "Completed" ),
        USERELATIONSHIP ( 'Crop Cycle'[Harvest Season End Date Key], 'Date'[Date Key] )
    )

// [3 Production & Yield] Actual yield relative to plan.
MEASURE '_Measures'[Yield vs Plan %] =
    VAR _plan = [Planned Yield (t/ha)]
    RETURN
        IF ( NOT ISBLANK ( _plan ), DIVIDE ( [Yield (t/ha)], _plan ) - 1 )

// [3 Production & Yield] NSA commercial-sector yield for the same region/crop/season (drill-across).
MEASURE '_Measures'[Benchmark Yield (t/ha)] =
    VAR _prod =
        CALCULATE ( SUM ( 'Crop Estimate'[Production (t)] ), KEEPFILTERS ( 'Crop Estimate'[Farming Sector] = "Commercial" ) )
    VAR _area =
        CALCULATE ( SUM ( 'Crop Estimate'[Area Planted (ha)] ), KEEPFILTERS ( 'Crop Estimate'[Farming Sector] = "Commercial" ) )
    RETURN
        DIVIDE ( _prod, _area )

// [3 Production & Yield] Green Basket yield minus the NSA commercial benchmark.
MEASURE '_Measures'[Yield Gap vs Benchmark (t/ha)] =
    VAR _y = [Yield (t/ha)]
    VAR _b = [Benchmark Yield (t/ha)]
    RETURN
        IF ( NOT ISBLANK ( _y ) && NOT ISBLANK ( _b ), _y - _b )

// [3 Production & Yield] Crop-cycle direct cost per tonne harvested (completed cycles).
MEASURE '_Measures'[Direct Cost per Tonne] =
    CALCULATE (
        DIVIDE ( SUM ( 'Crop Cycle'[Direct Cost] ), SUM ( 'Crop Cycle'[Harvested (kg)] ) / 1000 ),
        KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = "Completed" ),
        USERELATIONSHIP ( 'Crop Cycle'[Harvest Season End Date Key], 'Date'[Date Key] )
    )

// [3 Production & Yield] Posted production cost (incl. overheads) by posting date.
MEASURE '_Measures'[Production Cost] =
    SUM ( 'Production Cost'[Amount] )

// [3 Production & Yield] Fertiliser applied per planted hectare.
MEASURE '_Measures'[Fertiliser Rate (kg/ha)] =
    DIVIDE ( SUM ( 'Crop Cycle'[Fertiliser (kg)] ), SUM ( 'Crop Cycle'[Planted (ha)] ) )

// [3 Production & Yield] Share of planted area abandoned (crop failure).
MEASURE '_Measures'[Failed Area %] =
    DIVIDE ( CALCULATE ( [Planted Area (ha)], KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = "Failed" ) ), [Planted Area (ha)] )

// [3 Production & Yield] Area still growing or being harvested.
MEASURE '_Measures'[Area in Progress (ha)] =
    CALCULATE ( [Planted Area (ha)], KEEPFILTERS ( 'Crop Cycle'[Cycle Status] IN { "Growing", "Harvesting" } ) )

// [3 Production & Yield] Distinct crop cycles completed, by last-harvest date.
MEASURE '_Measures'[Cycles Completed] =
    CALCULATE (
        DISTINCTCOUNT ( 'Crop Cycle'[Cycle ID] ),
        KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = "Completed" ),
        USERELATIONSHIP ( 'Crop Cycle'[Last Harvest Date Key], 'Date'[Date Key] )
    )

// [4 Inventory] Stock on hand at the LAST month-end snapshot in the period across all farms/products (semi-additive).
MEASURE '_Measures'[Closing Stock (t)] =
    VAR _last =
        CALCULATE (
            MAX ( 'Inventory'[Snapshot Date Key] ),
            REMOVEFILTERS ( 'Farm' ), REMOVEFILTERS ( 'Region' ), REMOVEFILTERS ( 'Product' ), REMOVEFILTERS ( 'Crop' ), REMOVEFILTERS ( 'Crop Category' )
        )
    RETURN
        DIVIDE ( CALCULATE ( SUM ( 'Inventory'[Closing Stock (kg)] ), 'Inventory'[Snapshot Date Key] = _last ), 1000 )

// [4 Inventory] Closing stock at standard cost, last snapshot in the period.
MEASURE '_Measures'[Closing Stock Value] =
    VAR _last =
        CALCULATE (
            MAX ( 'Inventory'[Snapshot Date Key] ),
            REMOVEFILTERS ( 'Farm' ), REMOVEFILTERS ( 'Region' ), REMOVEFILTERS ( 'Product' ), REMOVEFILTERS ( 'Crop' ), REMOVEFILTERS ( 'Crop Category' )
        )
    RETURN
        CALCULATE ( SUM ( 'Inventory'[Closing Stock Value] ), 'Inventory'[Snapshot Date Key] = _last )

// [4 Inventory] Stock on hand at the FIRST snapshot in the period.
MEASURE '_Measures'[Opening Stock (t)] =
    VAR _first =
        CALCULATE (
            MIN ( 'Inventory'[Snapshot Date Key] ),
            REMOVEFILTERS ( 'Farm' ), REMOVEFILTERS ( 'Region' ), REMOVEFILTERS ( 'Product' ), REMOVEFILTERS ( 'Crop' ), REMOVEFILTERS ( 'Crop Category' )
        )
    RETURN
        DIVIDE ( CALCULATE ( SUM ( 'Inventory'[Opening Stock (kg)] ), 'Inventory'[Snapshot Date Key] = _first ), 1000 )

// [4 Inventory] Graded produce received into stock.
MEASURE '_Measures'[Stock Received (t)] =
    DIVIDE ( SUM ( 'Inventory'[Received (kg)] ), 1000 )

// [4 Inventory] Produce dispatched per the stock system.
MEASURE '_Measures'[Stock Dispatched (t)] =
    DIVIDE ( SUM ( 'Inventory'[Dispatched (kg)] ), 1000 )

// [4 Inventory] Post-harvest losses.
MEASURE '_Measures'[Shrinkage (t)] =
    DIVIDE ( SUM ( 'Inventory'[Shrinkage (kg)] ), 1000 )

// [4 Inventory] Losses relative to stock available (opening + received).
MEASURE '_Measures'[Shrinkage %] =
    DIVIDE ( [Shrinkage (t)], [Opening Stock (t)] + [Stock Received (t)] )

// [4 Inventory] Average tonnes invoiced per day over the last 90 days of the context.
MEASURE '_Measures'[Avg Daily Dispatch L90D (t)] =
    VAR _end =
        MIN ( MAX ( 'Date'[Date] ), [Last Sales Date] )
    RETURN
        DIVIDE (
            CALCULATE (
                SUM ( 'Sales'[Quantity (kg)] ),
                DATESINPERIOD ( 'Date'[Date], _end, -90, DAY ),
                KEEPFILTERS ( 'Sales'[Document Type] = "INV" )
            ),
            90 * 1000
        )

// [4 Inventory] Days of sales covered by closing stock.
MEASURE '_Measures'[Stock Cover (days)] =
    DIVIDE ( [Closing Stock (t)], [Avg Daily Dispatch L90D (t)] )

// [5 Weather & Markets] Rainfall total per location, averaged across the selected farm locations.
MEASURE '_Measures'[Rainfall (mm)] =
    AVERAGEX ( VALUES ( 'Farm'[Farm Code] ), CALCULATE ( SUM ( 'Weather'[Rainfall (mm)] ) ) )

// [5 Weather & Markets] Rainfall per agricultural season (Oct-Sep) per location: comparable whether one or several seasons are selected.
MEASURE '_Measures'[Rainfall per Season (mm)] =
    VAR _seasons =
        CALCULATE ( DISTINCTCOUNT ( 'Date'[Crop Season] ), 'Weather' )
    RETURN
        DIVIDE ( [Rainfall (mm)], _seasons )

// [5 Weather & Markets] Days with Tmax >= 35 C per location, averaged across locations.
MEASURE '_Measures'[Heat Days] =
    AVERAGEX ( VALUES ( 'Farm'[Farm Code] ), CALCULATE ( SUM ( 'Weather'[Heat Day] ) ) )

// [5 Weather & Markets] Mean daily maximum temperature.
MEASURE '_Measures'[Avg Max Temp (C)] =
    AVERAGE ( 'Weather'[Max Temp (C)] )

// [5 Weather & Markets] Average international price converted to N$ (select one crop/commodity).
MEASURE '_Measures'[World Price (N$/t)] =
    AVERAGE ( 'Market Price'[Price (N$)] )

// [5 Weather & Markets] Average international price in USD per published unit.
MEASURE '_Measures'[World Price (USD)] =
    AVERAGE ( 'Market Price'[Price (USD)] )

// [5 Weather & Markets] Green Basket realised price per tonne.
MEASURE '_Measures'[Realised Price (N$/t)] =
    [Avg Realised Price (N$/kg)] * 1000

// [5 Weather & Markets] Realised price relative to the international price (one crop selected).
MEASURE '_Measures'[Local Premium over World Price %] =
    VAR _w = [World Price (N$/t)]
    RETURN
        IF ( HASONEVALUE ( 'Crop'[Crop] ) && NOT ISBLANK ( _w ), DIVIDE ( [Realised Price (N$/t)], _w ) - 1 )

// [6 Forecast] Forward forecast of net revenue for the selected model (default: seasonal naive).
MEASURE '_Measures'[Forecast Revenue] =
    VAR _model =
        SELECTEDVALUE ( 'Forecast'[Model], "Seasonal naive" )
    RETURN
        CALCULATE (
            SUM ( 'Forecast'[Forecast] ),
            KEEPFILTERS ( 'Forecast'[Scenario] = "Forecast" ),
            'Forecast'[Model] = _model
        )

// [6 Forecast] Lower bound of the 80 % prediction interval (sum of category bounds - approximate at total level).
MEASURE '_Measures'[Forecast Lower 80] =
    VAR _model =
        SELECTEDVALUE ( 'Forecast'[Model], "Seasonal naive" )
    RETURN
        CALCULATE ( SUM ( 'Forecast'[Lower 80] ), KEEPFILTERS ( 'Forecast'[Scenario] = "Forecast" ), 'Forecast'[Model] = _model )

// [6 Forecast] Upper bound of the 80 % prediction interval.
MEASURE '_Measures'[Forecast Upper 80] =
    VAR _model =
        SELECTEDVALUE ( 'Forecast'[Model], "Seasonal naive" )
    RETURN
        CALCULATE ( SUM ( 'Forecast'[Upper 80] ), KEEPFILTERS ( 'Forecast'[Scenario] = "Forecast" ), 'Forecast'[Model] = _model )

// [6 Forecast] Hold-out (Oct 2025 - Sep 2026) forecast of the selected model.
MEASURE '_Measures'[Backtest Forecast] =
    VAR _model =
        SELECTEDVALUE ( 'Forecast'[Model], "Seasonal naive" )
    RETURN
        CALCULATE ( SUM ( 'Forecast'[Forecast] ), KEEPFILTERS ( 'Forecast'[Scenario] = "Backtest" ), 'Forecast'[Model] = _model )

// [6 Forecast] Weighted absolute percentage error of the hold-out forecast (category grain).
MEASURE '_Measures'[Backtest WAPE %] =
    VAR _model =
        SELECTEDVALUE ( 'Forecast'[Model], "Seasonal naive" )
    VAR _rows =
        FILTER ( 'Forecast', 'Forecast'[Scenario] = "Backtest" && 'Forecast'[Model] = _model )
    RETURN
        DIVIDE ( SUMX ( _rows, ABS ( 'Forecast'[Actual] - 'Forecast'[Forecast] ) ), SUMX ( _rows, ABS ( 'Forecast'[Actual] ) ) )

// [6 Forecast] Actual net revenue up to the last sale, forecast afterwards (single continuous line).
MEASURE '_Measures'[Revenue (Actual + Forecast)] =
    IF ( MAX ( 'Date'[Date] ) <= [Last Sales Date], [Net Revenue], [Forecast Revenue] )

// [6 Forecast] Permutation importance of yield drivers (random forest).
MEASURE '_Measures'[Driver Importance] =
    SUM ( 'Yield Drivers'[Importance] )

// [7 Data Quality & Security] Invoice lines flagged by rule SA07.
MEASURE '_Measures'[Price Anomaly Lines] =
    CALCULATE ( COUNTROWS ( 'Sales' ), KEEPFILTERS ( 'Sales'[Price Anomaly] = TRUE () ) )

// [7 Data Quality & Security] Revenue on lines awaiting steward review.
MEASURE '_Measures'[Flagged Price Anomaly Revenue] =
    CALCULATE ( [Net Revenue], KEEPFILTERS ( 'Sales'[Price Anomaly] = TRUE () ) )

// [7 Data Quality & Security] Revenue on lines without farm of origin (rule SA05).
MEASURE '_Measures'[Unknown Farm Revenue %] =
    DIVIDE ( CALCULATE ( [Net Revenue], KEEPFILTERS ( 'Farm'[Farm Code] = "UNKNOWN" ) ), [Net Revenue] )

// [7 Data Quality & Security] Harvest records corrected by rule HV06.
MEASURE '_Measures'[Corrected Harvest Records] =
    CALCULATE ( COUNTROWS ( 'Harvest' ), KEEPFILTERS ( 'Harvest'[Is Corrected] = TRUE () ) )

// [7 Data Quality & Security] Farms visible to the current user (RLS test).
MEASURE '_Measures'[Visible Farms] =
    CALCULATE ( DISTINCTCOUNT ( 'Farm'[Farm Code] ), KEEPFILTERS ( 'Farm'[Farm Code] <> "UNKNOWN" ) )

// [7 Data Quality & Security] UPN evaluated by row-level security.
MEASURE '_Measures'[Current User] =
    USERPRINCIPALNAME ()

// [0 Labels] Freshness label for page headers.
MEASURE '_Measures'[Data As Of] =
    "Data to " & FORMAT ( [Last Sales Date], "d mmm yyyy" )

// [0 Labels] Dynamic title.
MEASURE '_Measures'[Title Revenue Trend] =
    "Net revenue by month - " & SELECTEDVALUE ( 'Date'[Fiscal Year], "all fiscal years" )

// [0 Labels] Dynamic title.
MEASURE '_Measures'[Title Yield] =
    "Yield vs plan and NSA benchmark - " & SELECTEDVALUE ( 'Crop'[Crop], "all crops" )

// Row-level security role filters
// Role 'Zone Manager (dynamic)' on table 'Farm':
//   'Farm'[Zone Code]
//       IN CALCULATETABLE (
//           VALUES ( 'Security User Zone'[Zone Code] ),
//           'Security User Zone'[User UPN] = USERPRINCIPALNAME ()
//       )
// Role 'Export Desk (static)' on table 'Customer':
//   'Customer'[Channel] = "Export"
