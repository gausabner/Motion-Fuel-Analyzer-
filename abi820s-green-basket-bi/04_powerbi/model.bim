    "roles": [
      {
        "name": "Executive (all data)",
        "modelPermission": "read",
        "description": "Unrestricted read for the Executive Committee and CFO."
      },
      {
        "name": "Zone Manager (dynamic)",
        "modelPermission": "read",
        "description": "Dynamic RLS: users see farms (and all facts from those farms) in the zones mapped to their UPN in sec.user_zone_access.",
        "tablePermissions": [
          {
            "name": "Farm",
            "filterExpression": "'Farm'[Zone Code]\n    IN CALCULATETABLE (\n        VALUES ( 'Security User Zone'[Zone Code] ),\n        'Security User Zone'[User UPN] = USERPRINCIPALNAME ()\n    )"
          }
        ]
      },
      {
        "name": "Export Desk (static)",
        "modelPermission": "read",
        "description": "Static RLS: the export desk sees export-channel customers only.",
        "tablePermissions": [
          {
            "name": "Customer",
            "filterExpression": "'Customer'[Channel] = \"Export\""
          }
        ]
      }
    ],
