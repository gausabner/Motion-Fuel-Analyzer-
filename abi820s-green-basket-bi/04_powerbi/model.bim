{
  "name": "Green Basket Agriculture",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-GB",
    "sourceQueryCulture": "en-GB",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "_Measures",
        "description": "All business measures, organised in display folders.",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Measure Group",
            "dataType": "string",
            "isHidden": true,
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Measure Group]"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW ( \"Measure Group\", \"Measures\" )"
            }
          }
        ],
        "measures": [
          {
            "name": "Net Revenue",
            "expression": "SUM ( 'Sales'[Net Revenue] )",
            "displayFolder": "1 Sales",
            "description": "Invoice + credit-note revenue after discount, N$ (FX-converted).",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Gross Revenue",
            "expression": "SUM ( 'Sales'[Gross Revenue] )",
            "displayFolder": "1 Sales",
            "description": "Revenue before discount, N$.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Discount",
            "expression": "SUM ( 'Sales'[Discount] )",
            "displayFolder": "1 Sales",
            "description": "Discounts granted, N$.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "COGS",
            "expression": "SUM ( 'Sales'[COGS] )",
            "displayFolder": "1 Sales",
            "description": "Standard cost of goods sold, N$.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Freight Cost",
            "expression": "SUM ( 'Sales'[Freight Cost] )",
            "displayFolder": "1 Sales",
            "description": "Outbound freight borne by Green Basket, N$.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Gross Margin",
            "expression": "[Net Revenue] - [COGS]",
            "displayFolder": "1 Sales",
            "description": "Net revenue less COGS.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Gross Margin %",
            "expression": "DIVIDE ( [Gross Margin], [Net Revenue] )",
            "displayFolder": "1 Sales",
            "description": "Gross margin as a share of net revenue.",
            "formatString": "0.0%"
          },
          {
            "name": "Contribution after Freight",
            "expression": "[Gross Margin] - [Freight Cost]",
            "displayFolder": "1 Sales",
            "description": "Gross margin less outbound freight.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Sales Volume (t)",
            "expression": "DIVIDE ( SUM ( 'Sales'[Quantity (kg)] ), 1000 )",
            "displayFolder": "1 Sales",
            "description": "Tonnes invoiced (net of credit notes).",
            "formatString": "#,0"
          },
          {
            "name": "Avg Realised Price (N$/kg)",
            "expression": "DIVIDE ( [Net Revenue], SUM ( 'Sales'[Quantity (kg)] ) )",
            "displayFolder": "1 Sales",
            "description": "Net revenue per kg sold.",
            "formatString": "\"N$\" #,0.00"
          },
          {
            "name": "Invoice Lines",
            "expression": "COUNTROWS ( 'Sales' )",
            "displayFolder": "1 Sales",
            "description": "Number of document lines.",
            "formatString": "#,0"
          },
          {
            "name": "Invoices",
            "expression": "DISTINCTCOUNT ( 'Sales'[Invoice ID] )",
            "displayFolder": "1 Sales",
            "description": "Distinct invoices and credit notes.",
            "formatString": "#,0"
          },
          {
            "name": "Active Customers",
            "expression": "CALCULATE ( DISTINCTCOUNT ( 'Customer'[Customer Code] ), 'Sales' )",
            "displayFolder": "1 Sales",
            "description": "Distinct customers (durable code) with sales in the context.",
            "formatString": "#,0"
          },
          {
            "name": "Credit Notes",
            "expression": "- CALCULATE ( [Net Revenue], KEEPFILTERS ( 'Sales'[Document Type] = \"CRN\" ) )",
            "displayFolder": "1 Sales",
            "description": "Value credited for quality claims (positive number).",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Credit Note Rate %",
            "expression": "DIVIDE ( [Credit Notes], CALCULATE ( [Net Revenue], KEEPFILTERS ( 'Sales'[Document Type] = \"INV\" ) ) )",
            "displayFolder": "1 Sales",
            "description": "Credit notes as a share of invoiced revenue.",
            "formatString": "0.00%"
          },
          {
            "name": "Export Revenue",
            "expression": "CALCULATE ( [Net Revenue], KEEPFILTERS ( 'Customer'[Channel] = \"Export\" ) )",
            "displayFolder": "1 Sales",
            "description": "Net revenue from customers in the Export channel (CALCULATE with filter modification).",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Export Share %",
            "expression": "DIVIDE ( [Export Revenue], [Net Revenue] )",
            "displayFolder": "1 Sales",
            "description": "Export revenue as a share of net revenue.",
            "formatString": "0.0%"
          },
          {
            "name": "Revenue Share of All Crops %",
            "expression": "DIVIDE (\n    [Net Revenue],\n    CALCULATE ( [Net Revenue], REMOVEFILTERS ( 'Product' ), REMOVEFILTERS ( 'Crop' ), REMOVEFILTERS ( 'Crop Category' ) )\n)",
            "displayFolder": "1 Sales",
            "description": "Share of the selection in total revenue across all crops (filters on the product hierarchy removed).",
            "formatString": "0.0%"
          },
          {
            "name": "Top 10 Customer Share %",
            "expression": "VAR _top10 =\n    TOPN ( 10, VALUES ( 'Customer'[Customer Code] ), [Net Revenue] )\nRETURN\n    DIVIDE ( CALCULATE ( [Net Revenue], _top10 ), [Net Revenue] )",
            "displayFolder": "1 Sales",
            "description": "Revenue concentration: share of the ten largest customers in the context.",
            "formatString": "0.0%"
          },
          {
            "name": "Last Sales Date",
            "expression": "VAR _k =\n    CALCULATE ( MAX ( 'Sales'[Invoice Date Key] ), REMOVEFILTERS ( 'Date' ) )\nRETURN\n    IF ( NOT ISBLANK ( _k ), DATE ( INT ( _k / 10000 ), MOD ( INT ( _k / 100 ), 100 ), MOD ( _k, 100 ) ) )",
            "displayFolder": "2 Time Intelligence",
            "description": "Latest invoice date in the model (ignores date filters).",
            "formatString": "dd mmm yyyy"
          },
          {
            "name": "Net Revenue FYTD Raw",
            "expression": "TOTALYTD ( [Net Revenue], 'Date'[Date], \"3/31\" )",
            "displayFolder": "2 Time Intelligence",
            "description": "Fiscal year-to-date (year ends 31 March), no future guard.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Net Revenue FYTD",
            "expression": "IF ( MIN ( 'Date'[Date] ) <= [Last Sales Date], [Net Revenue FYTD Raw] )",
            "displayFolder": "2 Time Intelligence",
            "description": "Fiscal year-to-date net revenue; blank for periods after the last sale.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Net Revenue FYTD PY",
            "expression": "VAR _cutoffPY =\n    EDATE ( [Last Sales Date], -12 )\nRETURN\n    CALCULATE (\n        [Net Revenue FYTD Raw],\n        SAMEPERIODLASTYEAR ( 'Date'[Date] ),\n        KEEPFILTERS ( 'Date'[Date] <= _cutoffPY )\n    )",
            "displayFolder": "2 Time Intelligence",
            "description": "Same fiscal-YTD window one year earlier, cut at the same day (like-for-like).",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Net Revenue FYTD YoY %",
            "expression": "DIVIDE ( [Net Revenue FYTD] - [Net Revenue FYTD PY], [Net Revenue FYTD PY] )",
            "displayFolder": "2 Time Intelligence",
            "description": "Fiscal-YTD growth versus the like-for-like prior-year window.",
            "formatString": "0.0%"
          },
          {
            "name": "Net Revenue PY",
            "expression": "CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )",
            "displayFolder": "2 Time Intelligence",
            "description": "Net revenue in the same period last year.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Net Revenue YoY",
            "expression": "VAR _cur = [Net Revenue]\nVAR _py = [Net Revenue PY]\nRETURN\n    IF ( NOT ISBLANK ( _cur ) && NOT ISBLANK ( _py ), _cur - _py )",
            "displayFolder": "2 Time Intelligence",
            "description": "Change versus the same period last year, N$.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Net Revenue YoY %",
            "expression": "VAR _cur = [Net Revenue]\nVAR _py = [Net Revenue PY]\nRETURN\n    IF ( NOT ISBLANK ( _cur ) && NOT ISBLANK ( _py ), DIVIDE ( _cur - _py, _py ) )",
            "displayFolder": "2 Time Intelligence",
            "description": "Growth versus the same period last year.",
            "formatString": "0.0%"
          },
          {
            "name": "Net Revenue MAT",
            "expression": "VAR _end =\n    MIN ( MAX ( 'Date'[Date] ), [Last Sales Date] )\nRETURN\n    IF (\n        MIN ( 'Date'[Date] ) <= [Last Sales Date],\n        CALCULATE ( [Net Revenue], DATESINPERIOD ( 'Date'[Date], _end, -12, MONTH ) )\n    )",
            "displayFolder": "2 Time Intelligence",
            "description": "Moving annual total: trailing 12 months ending at the context end (capped at the last sale).",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Net Revenue 3M Rolling Avg",
            "expression": "VAR _end =\n    MIN ( MAX ( 'Date'[Date] ), [Last Sales Date] )\nRETURN\n    IF (\n        MIN ( 'Date'[Date] ) <= [Last Sales Date],\n        DIVIDE ( CALCULATE ( [Net Revenue], DATESINPERIOD ( 'Date'[Date], _end, -3, MONTH ) ), 3 )\n    )",
            "displayFolder": "2 Time Intelligence",
            "description": "Average monthly net revenue over the trailing three months.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Gross Margin % PY",
            "expression": "CALCULATE ( [Gross Margin %], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )",
            "displayFolder": "2 Time Intelligence",
            "description": "Gross margin % in the same period last year.",
            "formatString": "0.0%"
          },
          {
            "name": "Dispatched Volume (t)",
            "expression": "CALCULATE (\n    DIVIDE ( SUM ( 'Sales'[Quantity (kg)] ), 1000 ),\n    USERELATIONSHIP ( 'Sales'[Dispatch Date Key], 'Date'[Date Key] ),\n    KEEPFILTERS ( 'Sales'[Document Type] = \"INV\" )\n)",
            "displayFolder": "2 Time Intelligence",
            "description": "Tonnes by DISPATCH date - activates the inactive role-playing relationship.",
            "formatString": "#,0"
          },
          {
            "name": "Harvest (t)",
            "expression": "DIVIDE ( SUM ( 'Harvest'[Harvested (kg)] ), 1000 )",
            "displayFolder": "3 Production & Yield",
            "description": "Field harvest in tonnes by harvest date.",
            "formatString": "#,0"
          },
          {
            "name": "Planted Area (ha)",
            "expression": "SUM ( 'Crop Cycle'[Planted (ha)] )",
            "displayFolder": "3 Production & Yield",
            "description": "Area planted (by planting date).",
            "formatString": "#,0"
          },
          {
            "name": "Completed Harvest (t)",
            "expression": "CALCULATE (\n    DIVIDE ( SUM ( 'Crop Cycle'[Harvested (kg)] ), 1000 ),\n    KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = \"Completed\" ),\n    USERELATIONSHIP ( 'Crop Cycle'[Harvest Season End Date Key], 'Date'[Date Key] )\n)",
            "displayFolder": "3 Production & Yield",
            "description": "Harvest of completed cycles, by agricultural season of harvest.",
            "formatString": "#,0"
          },
          {
            "name": "Harvested Area (ha)",
            "expression": "CALCULATE (\n    SUM ( 'Crop Cycle'[Harvested (ha)] ),\n    KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = \"Completed\" ),\n    USERELATIONSHIP ( 'Crop Cycle'[Harvest Season End Date Key], 'Date'[Date Key] )\n)",
            "displayFolder": "3 Production & Yield",
            "description": "Harvested area of completed cycles, by season of harvest.",
            "formatString": "#,0"
          },
          {
            "name": "Yield (t/ha)",
            "expression": "DIVIDE ( [Completed Harvest (t)], [Harvested Area (ha)] )",
            "displayFolder": "3 Production & Yield",
            "description": "Tonnes per harvested hectare (completed cycles).",
            "formatString": "#,0.00"
          },
          {
            "name": "Planned Yield (t/ha)",
            "expression": "CALCULATE (\n    DIVIDE ( SUM ( 'Crop Cycle'[Planned Production (kg)] ) / 1000, SUM ( 'Crop Cycle'[Planted (ha)] ) ),\n    KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = \"Completed\" ),\n    USERELATIONSHIP ( 'Crop Cycle'[Harvest Season End Date Key], 'Date'[Date Key] )\n)",
            "displayFolder": "3 Production & Yield",
            "description": "Budgeted yield of the same completed cycles.",
            "formatString": "#,0.00"
          },
          {
            "name": "Yield vs Plan %",
            "expression": "VAR _plan = [Planned Yield (t/ha)]\nRETURN\n    IF ( NOT ISBLANK ( _plan ), DIVIDE ( [Yield (t/ha)], _plan ) - 1 )",
            "displayFolder": "3 Production & Yield",
            "description": "Actual yield relative to plan.",
            "formatString": "0.0%"
          },
          {
            "name": "Benchmark Yield (t/ha)",
            "expression": "VAR _prod =\n    CALCULATE ( SUM ( 'Crop Estimate'[Production (t)] ), KEEPFILTERS ( 'Crop Estimate'[Farming Sector] = \"Commercial\" ) )\nVAR _area =\n    CALCULATE ( SUM ( 'Crop Estimate'[Area Planted (ha)] ), KEEPFILTERS ( 'Crop Estimate'[Farming Sector] = \"Commercial\" ) )\nRETURN\n    DIVIDE ( _prod, _area )",
            "displayFolder": "3 Production & Yield",
            "description": "NSA commercial-sector yield for the same region/crop/season (drill-across).",
            "formatString": "#,0.00"
          },
          {
            "name": "Yield Gap vs Benchmark (t/ha)",
            "expression": "VAR _y = [Yield (t/ha)]\nVAR _b = [Benchmark Yield (t/ha)]\nRETURN\n    IF ( NOT ISBLANK ( _y ) && NOT ISBLANK ( _b ), _y - _b )",
            "displayFolder": "3 Production & Yield",
            "description": "Green Basket yield minus the NSA commercial benchmark.",
            "formatString": "#,0.00"
          },
          {
            "name": "Direct Cost per Tonne",
            "expression": "CALCULATE (\n    DIVIDE ( SUM ( 'Crop Cycle'[Direct Cost] ), SUM ( 'Crop Cycle'[Harvested (kg)] ) / 1000 ),\n    KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = \"Completed\" ),\n    USERELATIONSHIP ( 'Crop Cycle'[Harvest Season End Date Key], 'Date'[Date Key] )\n)",
            "displayFolder": "3 Production & Yield",
            "description": "Crop-cycle direct cost per tonne harvested (completed cycles).",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Production Cost",
            "expression": "SUM ( 'Production Cost'[Amount] )",
            "displayFolder": "3 Production & Yield",
            "description": "Posted production cost (incl. overheads) by posting date.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Fertiliser Rate (kg/ha)",
            "expression": "DIVIDE ( SUM ( 'Crop Cycle'[Fertiliser (kg)] ), SUM ( 'Crop Cycle'[Planted (ha)] ) )",
            "displayFolder": "3 Production & Yield",
            "description": "Fertiliser applied per planted hectare.",
            "formatString": "#,0"
          },
          {
            "name": "Failed Area %",
            "expression": "DIVIDE ( CALCULATE ( [Planted Area (ha)], KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = \"Failed\" ) ), [Planted Area (ha)] )",
            "displayFolder": "3 Production & Yield",
            "description": "Share of planted area abandoned (crop failure).",
            "formatString": "0.0%"
          },
          {
            "name": "Area in Progress (ha)",
            "expression": "CALCULATE ( [Planted Area (ha)], KEEPFILTERS ( 'Crop Cycle'[Cycle Status] IN { \"Growing\", \"Harvesting\" } ) )",
            "displayFolder": "3 Production & Yield",
            "description": "Area still growing or being harvested.",
            "formatString": "#,0"
          },
          {
            "name": "Cycles Completed",
            "expression": "CALCULATE (\n    DISTINCTCOUNT ( 'Crop Cycle'[Cycle ID] ),\n    KEEPFILTERS ( 'Crop Cycle'[Cycle Status] = \"Completed\" ),\n    USERELATIONSHIP ( 'Crop Cycle'[Last Harvest Date Key], 'Date'[Date Key] )\n)",
            "displayFolder": "3 Production & Yield",
            "description": "Distinct crop cycles completed, by last-harvest date.",
            "formatString": "#,0"
          },
          {
            "name": "Closing Stock (t)",
            "expression": "VAR _last =\n    CALCULATE (\n        MAX ( 'Inventory'[Snapshot Date Key] ),\n        REMOVEFILTERS ( 'Farm' ), REMOVEFILTERS ( 'Region' ), REMOVEFILTERS ( 'Product' ), REMOVEFILTERS ( 'Crop' ), REMOVEFILTERS ( 'Crop Category' )\n    )\nRETURN\n    DIVIDE ( CALCULATE ( SUM ( 'Inventory'[Closing Stock (kg)] ), 'Inventory'[Snapshot Date Key] = _last ), 1000 )",
            "displayFolder": "4 Inventory",
            "description": "Stock on hand at the LAST month-end snapshot in the period across all farms/products (semi-additive).",
            "formatString": "#,0"
          },
          {
            "name": "Closing Stock Value",
            "expression": "VAR _last =\n    CALCULATE (\n        MAX ( 'Inventory'[Snapshot Date Key] ),\n        REMOVEFILTERS ( 'Farm' ), REMOVEFILTERS ( 'Region' ), REMOVEFILTERS ( 'Product' ), REMOVEFILTERS ( 'Crop' ), REMOVEFILTERS ( 'Crop Category' )\n    )\nRETURN\n    CALCULATE ( SUM ( 'Inventory'[Closing Stock Value] ), 'Inventory'[Snapshot Date Key] = _last )",
            "displayFolder": "4 Inventory",
            "description": "Closing stock at standard cost, last snapshot in the period.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Opening Stock (t)",
            "expression": "VAR _first =\n    CALCULATE (\n        MIN ( 'Inventory'[Snapshot Date Key] ),\n        REMOVEFILTERS ( 'Farm' ), REMOVEFILTERS ( 'Region' ), REMOVEFILTERS ( 'Product' ), REMOVEFILTERS ( 'Crop' ), REMOVEFILTERS ( 'Crop Category' )\n    )\nRETURN\n    DIVIDE ( CALCULATE ( SUM ( 'Inventory'[Opening Stock (kg)] ), 'Inventory'[Snapshot Date Key] = _first ), 1000 )",
            "displayFolder": "4 Inventory",
            "description": "Stock on hand at the FIRST snapshot in the period.",
            "formatString": "#,0"
          },
          {
            "name": "Stock Received (t)",
            "expression": "DIVIDE ( SUM ( 'Inventory'[Received (kg)] ), 1000 )",
            "displayFolder": "4 Inventory",
            "description": "Graded produce received into stock.",
            "formatString": "#,0"
          },
          {
            "name": "Stock Dispatched (t)",
            "expression": "DIVIDE ( SUM ( 'Inventory'[Dispatched (kg)] ), 1000 )",
            "displayFolder": "4 Inventory",
            "description": "Produce dispatched per the stock system.",
            "formatString": "#,0"
          },
          {
            "name": "Shrinkage (t)",
            "expression": "DIVIDE ( SUM ( 'Inventory'[Shrinkage (kg)] ), 1000 )",
            "displayFolder": "4 Inventory",
            "description": "Post-harvest losses.",
            "formatString": "#,0.0"
          },
          {
            "name": "Shrinkage %",
            "expression": "DIVIDE ( [Shrinkage (t)], [Opening Stock (t)] + [Stock Received (t)] )",
            "displayFolder": "4 Inventory",
            "description": "Losses relative to stock available (opening + received).",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Daily Dispatch L90D (t)",
            "expression": "VAR _end =\n    MIN ( MAX ( 'Date'[Date] ), [Last Sales Date] )\nRETURN\n    DIVIDE (\n        CALCULATE (\n            SUM ( 'Sales'[Quantity (kg)] ),\n            DATESINPERIOD ( 'Date'[Date], _end, -90, DAY ),\n            KEEPFILTERS ( 'Sales'[Document Type] = \"INV\" )\n        ),\n        90 * 1000\n    )",
            "displayFolder": "4 Inventory",
            "description": "Average tonnes invoiced per day over the last 90 days of the context.",
            "formatString": "#,0.0"
          },
          {
            "name": "Stock Cover (days)",
            "expression": "DIVIDE ( [Closing Stock (t)], [Avg Daily Dispatch L90D (t)] )",
            "displayFolder": "4 Inventory",
            "description": "Days of sales covered by closing stock.",
            "formatString": "#,0"
          },
          {
            "name": "Rainfall (mm)",
            "expression": "AVERAGEX ( VALUES ( 'Farm'[Farm Code] ), CALCULATE ( SUM ( 'Weather'[Rainfall (mm)] ) ) )",
            "displayFolder": "5 Weather & Markets",
            "description": "Rainfall total per location, averaged across the selected farm locations.",
            "formatString": "#,0"
          },
          {
            "name": "Rainfall per Season (mm)",
            "expression": "VAR _seasons =\n    CALCULATE ( DISTINCTCOUNT ( 'Date'[Crop Season] ), 'Weather' )\nRETURN\n    DIVIDE ( [Rainfall (mm)], _seasons )",
            "displayFolder": "5 Weather & Markets",
            "description": "Rainfall per agricultural season (Oct-Sep) per location: comparable whether one or several seasons are selected.",
            "formatString": "#,0"
          },
          {
            "name": "Heat Days",
            "expression": "AVERAGEX ( VALUES ( 'Farm'[Farm Code] ), CALCULATE ( SUM ( 'Weather'[Heat Day] ) ) )",
            "displayFolder": "5 Weather & Markets",
            "description": "Days with Tmax >= 35 C per location, averaged across locations.",
            "formatString": "#,0"
          },
          {
            "name": "Avg Max Temp (C)",
            "expression": "AVERAGE ( 'Weather'[Max Temp (C)] )",
            "displayFolder": "5 Weather & Markets",
            "description": "Mean daily maximum temperature.",
            "formatString": "#,0.0"
          },
          {
            "name": "World Price (N$/t)",
            "expression": "AVERAGE ( 'Market Price'[Price (N$)] )",
            "displayFolder": "5 Weather & Markets",
            "description": "Average international price converted to N$ (select one crop/commodity).",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "World Price (USD)",
            "expression": "AVERAGE ( 'Market Price'[Price (USD)] )",
            "displayFolder": "5 Weather & Markets",
            "description": "Average international price in USD per published unit.",
            "formatString": "#,0.00"
          },
          {
            "name": "Realised Price (N$/t)",
            "expression": "[Avg Realised Price (N$/kg)] * 1000",
            "displayFolder": "5 Weather & Markets",
            "description": "Green Basket realised price per tonne.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Local Premium over World Price %",
            "expression": "VAR _w = [World Price (N$/t)]\nRETURN\n    IF ( HASONEVALUE ( 'Crop'[Crop] ) && NOT ISBLANK ( _w ), DIVIDE ( [Realised Price (N$/t)], _w ) - 1 )",
            "displayFolder": "5 Weather & Markets",
            "description": "Realised price relative to the international price (one crop selected).",
            "formatString": "0.0%"
          },
          {
            "name": "Forecast Revenue",
            "expression": "VAR _model =\n    SELECTEDVALUE ( 'Forecast'[Model], \"Seasonal naive\" )\nRETURN\n    CALCULATE (\n        SUM ( 'Forecast'[Forecast] ),\n        KEEPFILTERS ( 'Forecast'[Scenario] = \"Forecast\" ),\n        'Forecast'[Model] = _model\n    )",
            "displayFolder": "6 Forecast",
            "description": "Forward forecast of net revenue for the selected model (default: seasonal naive).",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Forecast Lower 80",
            "expression": "VAR _model =\n    SELECTEDVALUE ( 'Forecast'[Model], \"Seasonal naive\" )\nRETURN\n    CALCULATE ( SUM ( 'Forecast'[Lower 80] ), KEEPFILTERS ( 'Forecast'[Scenario] = \"Forecast\" ), 'Forecast'[Model] = _model )",
            "displayFolder": "6 Forecast",
            "description": "Lower bound of the 80 % prediction interval (sum of category bounds - approximate at total level).",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Forecast Upper 80",
            "expression": "VAR _model =\n    SELECTEDVALUE ( 'Forecast'[Model], \"Seasonal naive\" )\nRETURN\n    CALCULATE ( SUM ( 'Forecast'[Upper 80] ), KEEPFILTERS ( 'Forecast'[Scenario] = \"Forecast\" ), 'Forecast'[Model] = _model )",
            "displayFolder": "6 Forecast",
            "description": "Upper bound of the 80 % prediction interval.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Backtest Forecast",
            "expression": "VAR _model =\n    SELECTEDVALUE ( 'Forecast'[Model], \"Seasonal naive\" )\nRETURN\n    CALCULATE ( SUM ( 'Forecast'[Forecast] ), KEEPFILTERS ( 'Forecast'[Scenario] = \"Backtest\" ), 'Forecast'[Model] = _model )",
            "displayFolder": "6 Forecast",
            "description": "Hold-out (Oct 2025 - Sep 2026) forecast of the selected model.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Backtest WAPE %",
            "expression": "VAR _model =\n    SELECTEDVALUE ( 'Forecast'[Model], \"Seasonal naive\" )\nVAR _rows =\n    FILTER ( 'Forecast', 'Forecast'[Scenario] = \"Backtest\" && 'Forecast'[Model] = _model )\nRETURN\n    DIVIDE ( SUMX ( _rows, ABS ( 'Forecast'[Actual] - 'Forecast'[Forecast] ) ), SUMX ( _rows, ABS ( 'Forecast'[Actual] ) ) )",
            "displayFolder": "6 Forecast",
            "description": "Weighted absolute percentage error of the hold-out forecast (category grain).",
            "formatString": "0.0%"
          },
          {
            "name": "Revenue (Actual + Forecast)",
            "expression": "IF ( MAX ( 'Date'[Date] ) <= [Last Sales Date], [Net Revenue], [Forecast Revenue] )",
            "displayFolder": "6 Forecast",
            "description": "Actual net revenue up to the last sale, forecast afterwards (single continuous line).",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Driver Importance",
            "expression": "SUM ( 'Yield Drivers'[Importance] )",
            "displayFolder": "6 Forecast",
            "description": "Permutation importance of yield drivers (random forest).",
            "formatString": "0.000"
          },
          {
            "name": "Price Anomaly Lines",
            "expression": "CALCULATE ( COUNTROWS ( 'Sales' ), KEEPFILTERS ( 'Sales'[Price Anomaly] = TRUE () ) )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Invoice lines flagged by rule SA07.",
            "formatString": "#,0"
          },
          {
            "name": "Flagged Price Anomaly Revenue",
            "expression": "CALCULATE ( [Net Revenue], KEEPFILTERS ( 'Sales'[Price Anomaly] = TRUE () ) )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Revenue on lines awaiting steward review.",
            "formatString": "\"N$\" #,0"
          },
          {
            "name": "Unknown Farm Revenue %",
            "expression": "DIVIDE ( CALCULATE ( [Net Revenue], KEEPFILTERS ( 'Farm'[Farm Code] = \"UNKNOWN\" ) ), [Net Revenue] )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Revenue on lines without farm of origin (rule SA05).",
            "formatString": "0.00%"
          },
          {
            "name": "Corrected Harvest Records",
            "expression": "CALCULATE ( COUNTROWS ( 'Harvest' ), KEEPFILTERS ( 'Harvest'[Is Corrected] = TRUE () ) )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Harvest records corrected by rule HV06.",
            "formatString": "#,0"
          },
          {
            "name": "Visible Farms",
            "expression": "CALCULATE ( DISTINCTCOUNT ( 'Farm'[Farm Code] ), KEEPFILTERS ( 'Farm'[Farm Code] <> \"UNKNOWN\" ) )",
            "displayFolder": "7 Data Quality & Security",
            "description": "Farms visible to the current user (RLS test).",
            "formatString": "#,0"
          },
          {
            "name": "Current User",
            "expression": "USERPRINCIPALNAME ()",
            "displayFolder": "7 Data Quality & Security",
            "description": "UPN evaluated by row-level security."
          },
          {
            "name": "Data As Of",
            "expression": "\"Data to \" & FORMAT ( [Last Sales Date], \"d mmm yyyy\" )",
            "displayFolder": "0 Labels",
            "description": "Freshness label for page headers."
          },
          {
            "name": "Title Revenue Trend",
            "expression": "\"Net revenue by month - \" & SELECTEDVALUE ( 'Date'[Fiscal Year], \"all fiscal years\" )",
            "displayFolder": "0 Labels",
            "description": "Dynamic title."
          },
          {
            "name": "Title Yield",
            "expression": "\"Yield vs plan and NSA benchmark - \" & SELECTEDVALUE ( 'Crop'[Crop], \"all crops\" )",
            "displayFolder": "0 Labels",
            "description": "Dynamic title."
          }
        ]
      },
