            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    // CSV fallback reader: gzip CSV exported by export_fallbacks.py; empty cells become null before typing\n    ReadCsv = (file as text) as table =>\n        let\n            Raw = Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(CsvFolder & file), Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])\n        in\n            Table.ReplaceValue(Raw, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Raw)),\n    Source = if SourceMode = \"CSV\"\n        then ReadCsv(\"dim_date.csv.gz\")\n        else PostgreSQL.Database(PgServer, PgDatabase){[Schema = \"mart\", Item = \"dim_date\"]}[Data],\n    Typed = Table.TransformColumnTypes(Source, {{\"date_key\", Int64.Type}, {\"full_date\", type date}, {\"day_of_month\", Int64.Type}, {\"day_of_week_iso\", Int64.Type}, {\"day_name\", type text}, {\"day_short\", type text}, {\"is_weekend\", type logical}, {\"is_public_holiday\", type logical}, {\"holiday_name\", type text}, {\"is_working_day\", type logical}, {\"iso_week\", Int64.Type}, {\"week_start_date\", type date}, {\"month_num\", Int64.Type}, {\"month_name\", type text}, {\"month_short\", type text}, {\"year_month\", type text}, {\"year_month_key\", Int64.Type}, {\"month_start_date\", type date}, {\"month_end_date\", type date}, {\"is_month_end\", type logical}, {\"quarter_num\", Int64.Type}, {\"year_quarter\", type text}, {\"calendar_year\", Int64.Type}, {\"fiscal_year\", Int64.Type}, {\"fiscal_year_label\", type text}, {\"fiscal_quarter_num\", Int64.Type}, {\"fiscal_quarter_label\", type text}, {\"fiscal_month_num\", Int64.Type}, {\"fiscal_month_name\", type text}, {\"crop_season_start_year\", Int64.Type}, {\"crop_season_label\", type text}, {\"season_month_num\", Int64.Type}, {\"is_current_month\", type logical}}, \"en-US\")\nin\n    Typed"
            }
          }
        ],
